{% extends 'base.html.twig' %}

{% block title %}Modifier Produit: {{ produit.nomProduit }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Modifier {{ produit.nomProduit }}</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    
    <div class="form-group mb-3">
        {{ form_label(form.nomProduit) }}
        {{ form_widget(form.nomProduit) }}
        {% if form.nomProduit.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.nomProduit.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.typeProduit) }}
        {{ form_widget(form.typeProduit) }}
        {% if form.typeProduit.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.typeProduit.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.montant) }}
        {{ form_widget(form.montant) }}
        {% if form.montant.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.montant.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.codeUnique) }}
        {{ form_widget(form.codeUnique) }}
        {% if form.codeUnique.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.codeUnique.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.statut) }}
        {{ form_widget(form.statut) }}
        {% if form.statut.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.statut.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <button type="submit" class="btn btn-success">Enregistrer</button>
    <a href="{{ path('produit_index') }}" class="btn btn-secondary">Annuler</a>

    {{ form_end(form) }}
</div>
{% endblock %}
