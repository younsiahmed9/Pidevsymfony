{% extends 'base.html.twig' %}

{% block title %}{{ bundle.nomBundle }} - Partage securise{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                        <div>
                            <h1 class="h3 fw-bold mb-1">{{ bundle.nomBundle }}</h1>
                            <p class="text-muted mb-0">
                                Partage par <strong>{{ bundle.utilisateur.fullName ?: bundle.utilisateur.email }}</strong>
                            </p>
                        </div>
                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                            Acces securise
                        </span>
                    </div>

                    <div class="mb-4">
                        <h2 class="h6 text-uppercase text-muted mb-2">Description</h2>
                        <p class="mb-0">{{ bundle.description ?: 'Aucune description fournie pour ce pack.' }}</p>
                    </div>

                    <h2 class="h6 text-uppercase text-muted mb-3">Documents ({{ bundle.documents|length }})</h2>

                    <div class="list-group list-group-flush">
                        {% for doc in bundle.documents %}
                            <div class="list-group-item px-0 py-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                    <div>
                                        <div class="fw-semibold">{{ doc.titre }}</div>
                                        <div class="small text-muted">
                                            {{ doc.typeDocument|capitalize }} • {{ (doc.tailleFichier / 1024)|number_format(1) }} KB
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('app_public_pack_document_preview', {token: bundle.tokenPartage, documentId: doc.id}) }}" class="btn btn-outline-primary btn-sm rounded-pill" target="_blank">
                                            Voir
                                        </a>
                                        <a href="{{ path('app_public_pack_document_download', {token: bundle.tokenPartage, documentId: doc.id}) }}" class="btn btn-primary btn-sm rounded-pill">
                                            Telecharger
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="text-muted py-2">Aucun document dans ce pack.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
