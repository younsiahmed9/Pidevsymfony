<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pack.nomPack }} - Partage Sécurisé</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .premium-header {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            padding: 4rem 0;
            color: white;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .pack-card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.05);
            margin-top: -3rem;
            background: white;
            overflow: hidden;
        }
        .doc-item {
            transition: all 0.3s ease;
            border-radius: 16px;
            border: 1px solid #f1f5f9;
        }
        .doc-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border-color: #0d6efd20;
        }
        .icon-box {
            width: 50px;
            height: 50px;
            background: #f1f5f9;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
        }
        .btn-premium {
            background: #0d6efd;
            color: white;
            border-radius: 50px;
            padding: 0.8rem 2rem;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
        }
        .btn-premium:hover {
            background: #004dc5;
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.3);
            transform: translateY(-2px);
            color: white;
        }
        .secure-badge {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            padding: 0.5rem 1.2rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header class="premium-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold mb-3">{{ pack.nomPack }}</h1>
            <p class="opacity-75 lead">Lien de partage sécurisé généré par AETG Documents</p>
        </div>
    </header>

    <main class="container mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <div class="card pack-card">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-5 pb-4 border-bottom">
                            <div>
                                <h5 class="fw-bold mb-1">Informations du Pack</h5>
                                <p class="text-muted mb-0">Partagé par : <strong>{{ pack.utilisateur.fullName ?: pack.utilisateur.email }}</strong></p>
                            </div>
                            <div>
                                <span class="secure-badge">
                                    <i class="fas fa-shield-alt me-2"></i> Accès Sécurisé par Token
                                </span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <h6 class="text-uppercase text-muted small fw-bold mb-3 ls-wide">Description</h6>
                            <p class="text-secondary">{{ pack.description ?: "Aucune description fournie pour ce pack." }}</p>
                        </div>

                        <h6 class="text-uppercase text-muted small fw-bold mb-4 ls-wide">Documents Inclus ({{ pack.documents|length }})</h6>
                        
                        <div class="row g-3">
                            {% for doc in pack.documents %}
                                <div class="col-12">
                                    <div class="doc-item p-3 d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="icon-box">
                                                <i class="fas fa-file-pdf fa-lg"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-1 fw-bold">{{ doc.titre }}</h6>
                                                <span class="text-muted smaller">
                                                    {{ doc.typeDocument|capitalize }} • {{ (doc.tailleFichier / 1024)|number_format(1) }} KB
                                                </span>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="{{ path('app_public_pack_document_preview', {token: pack.tokenPartage, documentId: doc.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3" target="_blank">
                                                <i class="fas fa-eye me-1"></i> Voir
                                            </a>
                                            <a href="{{ path('app_public_pack_document_download', {token: pack.tokenPartage, documentId: doc.id}) }}" class="btn btn-sm btn-primary rounded-pill px-3">
                                                <i class="fas fa-download me-1"></i> Télécharger
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="mt-5 pt-4 text-center border-top">
                            <p class="text-muted small mb-3">Besoin de gérer vos propres documents de manière sécurisée ?</p>
                            <a href="/" class="btn btn-outline-secondary rounded-pill px-4">Découvrir AETG</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="text-center py-5 text-muted small">
        &copy; {{ "now"|date("Y") }} AETG Documents. Tous droits réservés.
    </footer>
</body>
</html>
