{% extends 'base.html.twig' %}

{% block title %}Nouveau Service{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Ajouter un Nouveau Service</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    
    <div class="form-group mb-3">
        {{ form_label(form.nomService) }}
        {{ form_widget(form.nomService) }}
        {% if form.nomService.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.nomService.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.typeService) }}
        {{ form_widget(form.typeService) }}
        {% if form.typeService.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.typeService.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.tarif) }}
        {{ form_widget(form.tarif) }}
        {% if form.tarif.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.tarif.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.frequence) }}
        {{ form_widget(form.frequence) }}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.dateDebut) }}
        {{ form_widget(form.dateDebut) }}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.dateFin) }}
        {{ form_widget(form.dateFin) }}
    </div>

    <div class="form-group mb-3">
        {{ form_label(form.statut) }}
        {{ form_widget(form.statut) }}
        {% if form.statut.vars.errors|length > 0 %}
            <div class="alert alert-danger mt-2">
                {% for error in form.statut.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <button type="submit" class="btn btn-success">Créer</button>
    <a href="{{ path('service_index') }}" class="btn btn-secondary">Annuler</a>

    {{ form_end(form) }}
</div>
{% endblock %}
