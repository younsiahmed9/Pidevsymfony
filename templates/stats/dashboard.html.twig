{% extends 'base.html.twig' %}

{% block title %}Dashboard - Statistiques{% endblock %}

{% block body %}
<div class="container-fluid mt-5">
    <h1 class="mb-4">Dashboard - Statistiques</h1>

    <!-- Factures Stats -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="mb-3">📊 Statistiques Factures</h2>
        </div>
        
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Chiffre d'Affaires Total</h5>
                    <p class="card-text display-4">${{ totalCA|number_format(2, '.', ',') }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">Factures Impayées</h5>
                    <p class="card-text display-4">{{ countFacturesImpayees }}</p>
                    <p class="card-text">Montant: ${{ montantImpaye|number_format(2, '.', ',') }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5 class="card-title">Factures Expirées</h5>
                    <p class="card-text display-4">{{ countFacturesExpires }}</p>
                    <p class="card-text">Montant: ${{ montantExpire|number_format(2, '.', ',') }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Taux de Recouvrement</h5>
                    <p class="card-text display-4">{{ tauxRecouvrement|number_format(2, '.', ',') }}%</p>
                    <p class="card-text">Impayé: {{ tauxImpaye|number_format(2, '.', ',') }}%</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Produits Stats -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="mb-3">📦 Statistiques Produits</h2>
        </div>
        
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Produits Vendus</h5>
                    <p class="card-text display-4">{{ produitVendus }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Produits Disponibles</h5>
                    <p class="card-text display-4">{{ produitDisponible }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h5 class="card-title">Produits Expirés</h5>
                    <p class="card-text display-4">{{ produitExpire }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Montant Total Disponible</h5>
                    <p class="card-text display-4">${{ totalMontantProduit|number_format(2, '.', ',') }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Services Stats -->
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-3">⚙️ Statistiques Services</h2>
        </div>
        
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Services Actifs</h5>
                    <p class="card-text display-4">{{ servicesActifs }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5 class="card-title">Services Suspendus</h5>
                    <p class="card-text display-4">{{ servicesSuspendus }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">Services Expirés</h5>
                    <p class="card-text display-4">{{ servicesExpires }}</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Tarif Moyen</h5>
                    <p class="card-text display-4">${{ averageTarif|number_format(2, '.', ',') }}</p>
                    <p class="card-text">Total: ${{ totalTarifActif|number_format(2, '.', ',') }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <a href="{{ path('facture_index') }}" class="btn btn-primary me-2">Voir Factures</a>
            <a href="{{ path('produit_index') }}" class="btn btn-success me-2">Voir Produits</a>
            <a href="{{ path('service_index') }}" class="btn btn-info">Voir Services</a>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }
    
    .card-title {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 10px;
    }
    
    .display-4 {
        font-size: 2rem;
        font-weight: bold;
    }
</style>
{% endblock %}
