<div class="card border-0 shadow-lg rounded-4 mt-4 overflow-hidden chat-premium-card">
    <div class="card-header bg-gradient-dark border-0 py-3 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <div class="chat-icon-pulse me-3">
                <i class="fas fa-robot text-white"></i>
            </div>
            <div>
                <h6 class="text-white fw-bold mb-0">Assistant IA Document</h6>
                <span class="badge bg-success-soft text-success smaller">En ligne</span>
            </div>
        </div>
        <button class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="clearChat()">
            <i class="fas fa-trash-alt me-1"></i> Effacer
        </button>
    </div>

    <div class="card-body p-0 d-flex flex-column" style="height: 450px;">
        <!-- Zone de messages -->
        <div id="chatHistory" class="flex-grow-1 p-4 overflow-auto scroll-premium-dark bg-chat-pattern">
            <div class="chat-message bot shadow-sm animate-fade-in-up">
                <div class="message-content">
                    Bonjour ! Je suis votre assistant IA. Posez-moi n'importe quelle question sur ce document. Par exemple : 
                    <br/><br/>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-xs btn-glass-primary" onclick="askQuick('Qui est le signataire ?')">Qui est le signataire ?</button>
                        <button class="btn btn-xs btn-glass-primary" onclick="askQuick('Quel est le montant total ?')">Quel est le montant ?</button>
                        <button class="btn btn-xs btn-glass-primary" onclick="askQuick('Quelle est la date d\'échéance ?')">Date d'échéance ?</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Indicateur de frappe -->
        <div id="chatTyping" class="d-none px-4 py-2">
            <div class="typing-indicator">
                <span></span><span></span><span></span>
            </div>
        </div>

        <!-- Zone de saisie -->
        <div class="p-3 border-top bg-white">
            <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                <input type="text" id="chatInput" class="form-control border-0 px-4 py-3" placeholder="Posez une question..." onkeypress="if(event.key === 'Enter') sendMessage()">
                <button class="btn btn-primary px-4" type="button" onclick="sendMessage()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-premium-card {
        border: 1px solid rgba(0, 0, 0, 0.05);
        background: #fff;
    }

    .bg-gradient-dark {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }

    .smaller { font-size: 0.75rem; }
    
    .bg-success-soft {
        background: rgba(16, 185, 129, 0.15);
    }

    .chat-icon-pulse {
        width: 35px;
        height: 35px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .chat-icon-pulse::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.5);
        animation: pulse-border 2s infinite;
    }

    @keyframes pulse-border {
        0% { transform: scale(1); opacity: 1; }
        100% { transform: scale(1.5); opacity: 0; }
    }

    .bg-chat-pattern {
        background-color: #f8fafc;
        background-image: radial-gradient(#e2e8f0 0.5px, transparent 0.5px);
        background-size: 20px 20px;
    }

    .chat-message {
        margin-bottom: 20px;
        max-width: 85%;
        padding: 12px 16px;
        border-radius: 18px;
        font-size: 0.95rem;
        line-height: 1.5;
        position: relative;
    }

    .chat-message.bot {
        align-self: flex-start;
        background: white;
        color: #1e293b;
        border-bottom-left-radius: 4px;
        border: 1px solid #f1f5f9;
    }

    .chat-message.user {
        align-self: flex-end;
        background: #0d6efd;
        color: white;
        border-bottom-right-radius: 4px;
        margin-left: auto;
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.4s ease-out;
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .btn-xs {
        padding: 4px 10px;
        font-size: 0.75rem;
        border-radius: 50px;
    }

    .btn-glass-primary {
        background: rgba(13, 110, 253, 0.05);
        border: 1px solid rgba(13, 110, 253, 0.1);
        color: #0d6efd;
        font-weight: 600;
    }

    .btn-glass-primary:hover {
        background: #0d6efd;
        color: white;
    }

    /* Typing indicators */
    .typing-indicator span {
        height: 8px;
        width: 8px;
        background: #94a3b8;
        display: inline-block;
        border-radius: 50%;
        margin: 0 2px;
        animation: typing 1s infinite ease-in-out;
    }
    .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
    .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

    @keyframes typing {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
    }

    .scroll-premium-dark::-webkit-scrollbar { width: 5px; }
    .scroll-premium-dark::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
</style>

<script>
async function sendMessage() {
    const input = document.getElementById('chatInput');
    const question = input.value.trim();
    if (!question) return;

    appendMessage('user', question);
    input.value = '';

    const typing = document.getElementById('chatTyping');
    typing.classList.remove('d-none');

    try {
        const response = await fetch(`/api/document-intelligence/{{ document.id }}/chat`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: question })
        });
        const data = await response.json();

        typing.classList.add('d-none');
        if (data.success) {
            appendMessage('bot', data.answer);
        } else {
            appendMessage('bot', "Désolé, une erreur est survenue : " + data.message);
        }
    } catch (error) {
        typing.classList.add('d-none');
        appendMessage('bot', "Erreur de connexion au service d'IA.");
    }
}

function appendMessage(type, text) {
    const history = document.getElementById('chatHistory');
    const div = document.createElement('div');
    div.className = `chat-message ${type} shadow-sm animate-fade-in-up`;
    
    // Support markdown simple (**texte**)
    const formattedText = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                             .replace(/\*(.*?)\*/g, '<em>$1</em>')
                             .replace(/\n/g, '<br>');
                             
    div.innerHTML = `<div class="message-content">${formattedText}</div>`;
    history.appendChild(div);
    history.scrollTop = history.scrollHeight;
}

function askQuick(question) {
    document.getElementById('chatInput').value = question;
    sendMessage();
}

function clearChat() {
    const history = document.getElementById('chatHistory');
    history.innerHTML = `
        <div class="chat-message bot shadow-sm animate-fade-in-up">
            <div class="message-content">Conversation réinitialisée. Comment puis-je vous aider ?</div>
        </div>
    `;
}
</script>
