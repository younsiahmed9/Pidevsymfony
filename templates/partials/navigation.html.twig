<!-- navigation -->
<header class="navigation bg-tertiary">
	<style>
		.profile-avatar-btn {
			width: 44px;
			height: 44px;
			border-radius: 50%;
			border: 2px solid #fff;
			background: #d9e2ff;
			padding: 0;
			overflow: hidden;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			font-weight: 700;
			color: #25314c;
		}

		.profile-avatar-btn img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	</style>
	<nav class="navbar navbar-expand-xl navbar-light text-start py-3">
		<div class="container">
			<a class="navbar-brand" href="{{ path('app_home') }}">
				<img loading="prelaod" decoding="async" class="img-fluid" width="160" src="{{ asset('images/logo.png') }}" alt="FinTrack">
			</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"> <span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarSupportedContent">
				{% if not is_granted('ROLE_ADMIN') %}
					<ul class="navbar-nav ms-0 me-auto mb-2 mb-lg-0">
						<li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
						<li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#services">Services</a></li>
						<li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#how-it-works">How It Works</a></li>
						<li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#contact">Contact</a></li>
					</ul>
				{% endif %}
				<div class="navbar-actions ms-auto d-flex align-items-center justify-content-end flex-wrap gap-2 gap-lg-3">
					{% if app.user %}
						<span class="text-dark">{{ app.user.fullName ?: app.user.email }}</span>
						{% set initial = (app.user.fullName ?: app.user.email)|slice(0, 1)|upper %}
						{% set profileImage = app.user.profilePhoto %}
						<button class="profile-avatar-btn" type="button" data-bs-toggle="modal" data-bs-target="#profileEditModal" title="Edit Profile">
							{% if profileImage %}
								{% if profileImage starts with 'http://' or profileImage starts with 'https://' or profileImage starts with '/' %}
									<img src="{{ profileImage }}" alt="{{ app.user.fullName ?: app.user.email }}">
								{% else %}
									<img src="{{ asset(profileImage) }}" alt="{{ app.user.fullName ?: app.user.email }}">
								{% endif %}
							{% else %}
								{{ initial }}
							{% endif %}
						</button>
						{% if is_granted('ROLE_ADMIN') %}
							<a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-primary">Admin</a>
						{% endif %}
						<a href="{{ path('app_logout') }}" class="btn btn-primary">Logout</a>
					{% else %}
						<a href="{{ path('app_login') }}" class="btn btn-outline-primary">Log In</a>
						<a href="{{ path('app_register') }}" class="btn btn-primary">Sign Up</a>
					{% endif %}
				</div>
			</div>
		</div>
	</nav>
	{% if app.user %}
		<div class="modal fade" id="profileEditModal" tabindex="-1" aria-labelledby="profileEditModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="profileEditModalLabel">Edit Profile</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<form method="post" action="{{ path('app_profile_update') }}" enctype="multipart/form-data">
						<div class="modal-body">
							<input type="hidden" name="_token" value="{{ csrf_token('profile_edit') }}">
							<div class="mb-3 text-center">
								<div class="profile-avatar-btn mx-auto mb-2" style="width:64px;height:64px;pointer-events:none;">
									{% if profileImage %}
										{% if profileImage starts with 'http://' or profileImage starts with 'https://' or profileImage starts with '/' %}
											<img src="{{ profileImage }}" alt="{{ app.user.fullName ?: app.user.email }}">
										{% else %}
											<img src="{{ asset(profileImage) }}" alt="{{ app.user.fullName ?: app.user.email }}">
										{% endif %}
									{% else %}
										{{ initial }}
									{% endif %}
								</div>
							</div>
							<div class="mb-3">
								<label class="form-label" for="profile_full_name">Full Name</label>
								<input class="form-control shadow-none" id="profile_full_name" type="text" name="full_name" value="{{ app.user.fullName ?: '' }}" required>
							</div>
							<div class="mb-3">
								<label class="form-label" for="profile_email">Email</label>
								<input class="form-control shadow-none" id="profile_email" type="email" name="email" value="{{ app.user.email }}" required>
							</div>
							<div class="mb-1">
								<label class="form-label" for="profile_photo_file">Profile Photo (JPG, PNG, WEBP, GIF)</label>
								<input class="form-control shadow-none" id="profile_photo_file" type="file" name="profile_photo_file" accept="image/*">
								<div class="form-text">Max size: 5MB. Leave empty to keep current photo.</div>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
							<button type="submit" class="btn btn-primary">Save Changes</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	{% endif %}
</header>
<!-- /navigation -->