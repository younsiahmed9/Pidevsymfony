{% extends 'user/base.html.twig' %}
{% block title %}Modifier Document - FinTrack{% endblock %}
{% block page_title %}Modifier le Document{% endblock %}
{% block page_subtitle %}{{ document.titre }}{% endblock %}
{% block content %}
<div class="mb-4"><a href="{{ path('user_document_show', {id: document.id}) }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Retour</a></div>
<div class="row"><div class="col-md-8"><div class="form-card">
    <h6 class="fw-semibold mb-4 pb-2 border-bottom">Modifier le document</h6>
    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
    <div class="row g-3">
        <div class="col-md-6"><div class="mb-3">{{ form_label(form.titre, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.titre) }}</div></div>
        <div class="col-md-6"><div class="mb-3">{{ form_label(form.typeDocument, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.typeDocument, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.typeDocument) }}</div></div>
        <div class="col-md-6"><div class="mb-3">{{ form_label(form.statut, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.statut) }}</div></div>
        <div class="col-md-6"><div class="mb-3">{{ form_label(form.categorie, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.categorie, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.categorie) }}</div></div>
        <div class="col-md-6"><div class="mb-3">{{ form_label(form.dossier, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.dossier, {'attr': {'class': 'form-select'}}) }}{{ form_errors(form.dossier) }}</div></div>
        <div class="col-md-6"><div class="mb-3">{{ form_label(form.dateDocument, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.dateDocument, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.dateDocument) }}</div></div>
        <div class="col-md-6"><div class="mb-3">{{ form_label(form.dateEcheance, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.dateEcheance, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.dateEcheance) }}</div></div>
        <div class="col-12"><div class="mb-3">
            <p class="form-label fw-medium text-muted small">Fichier actuel: <code>{{ document.cheminFichier }}</code></p>
            {{ form_label(form.fichier, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.fichier, {'attr': {'class': 'form-control'}}) }}{{ form_errors(form.fichier) }}
        </div></div>
        <div class="col-12"><div class="mb-3">{{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}{{ form_errors(form.description) }}</div></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button type="submit" class="btn-primary-custom"><i class="fas fa-save"></i> Enregistrer</button><a href="{{ path('user_document_show', {id: document.id}) }}" class="btn btn-outline-secondary">Annuler</a></div>
    {{ form_end(form) }}
</div></div></div>
{% endblock %}
