{% extends 'user/base.html.twig' %}
{% block title %}Gestion des Documents - FinTrack{% endblock %}
{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block content %}
<style>
/* ── Layout ─────────────────────────────────────── */
.doc-layout { display:flex; gap:0; min-height:calc(100vh - 120px); }

/* ── Left sidebar ───────────────────────────────── */
.doc-sidebar {
    width:280px; min-width:260px; max-width:300px;
    background:#fff; border-right:1px solid #e8eaf0;
    padding:2rem 1.25rem 1.5rem;
    display:flex; flex-direction:column; gap:.5rem;
}
.doc-sidebar h1 { font-size:1.4rem; font-weight:800; color:#0d0d1a; margin:0; }
.doc-sidebar .subtitle { font-size:.8rem; color:#6b7280; margin-bottom:1.2rem; }
.sidebar-section-title {
    font-size:.7rem; font-weight:700; text-transform:uppercase;
    letter-spacing:.08em; color:#9ca3af; margin:1rem 0 .4rem;
}
.sidebar-nav-link {
    display:flex; align-items:center; gap:.6rem; padding:.5rem .75rem;
    border-radius:10px; color:#374151; font-size:.88rem; font-weight:500;
    text-decoration:none; cursor:pointer; border:none; background:none; width:100%;
    transition:background .15s;
}
.sidebar-nav-link:hover, .sidebar-nav-link.active { background:#fff7ed; color:#f97316; }
.sidebar-nav-link i { width:16px; text-align:center; }

.dossier-item {
    display:flex; align-items:center; gap:.5rem; padding:.45rem .75rem;
    border-radius:10px; margin-bottom:.2rem;
    background:#f8fafc; border:1px solid #e8eaf0;
}
.dossier-item .dossier-name { flex:1; font-size:.85rem; font-weight:600; color:#0d0d1a; }
.dossier-item .btn-filtrer {
    background:linear-gradient(90deg,#f97316,#fb923c); color:#fff; border:none;
    border-radius:20px; font-size:.7rem; font-weight:700; padding:.2rem .7rem;
    cursor:pointer; white-space:nowrap;
}
.dossier-item .btn-filtrer:hover { opacity:.9; }
.dossier-item .btn-icon {
    background:none; border:none; color:#9ca3af; padding:.1rem .3rem;
    cursor:pointer; font-size:.8rem; border-radius:6px;
}
.dossier-item .btn-icon:hover { color:#ef4444; background:#fee2e2; }

/* ── Right panel ────────────────────────────────── */
.doc-main { flex:1; padding:2rem 1.75rem; overflow-y:auto; }
.doc-main-header { margin-bottom:1.5rem; }
.search-row { display:flex; gap:.75rem; align-items:center; margin-bottom:1rem; }
.search-input-wrap {
    flex:1; display:flex; align-items:center; gap:.6rem;
    background:#fff; border:1.5px solid #e8eaf0; border-radius:14px;
    padding:.55rem 1rem;
}
.search-input-wrap input { border:none; outline:none; width:100%; font-size:.9rem; color:#374151; }
.search-input-wrap i { color:#9ca3af; }
.filter-select {
    border:1.5px solid #e8eaf0; border-radius:14px; padding:.55rem 1rem;
    font-size:.85rem; color:#374151; background:#fff; outline:none;
    cursor:pointer; min-width:170px;
}
.doc-count { font-size:.85rem; color:#6b7280; margin-bottom:1rem; }
.doc-count strong { color:#0d0d1a; font-weight:700; }

/* ── Document cards ─────────────────────────────── */
.doc-card {
    background:#fff; border:1.5px solid #e8eaf0; border-radius:16px;
    padding:1.1rem 1.25rem 1rem; margin-bottom:.85rem;
    transition:box-shadow .2s, border-color .2s;
}
.doc-card:hover { box-shadow:0 4px 20px rgba(0,0,0,.07); border-color:#d1d5db; }
.doc-card-title { font-size:1rem; font-weight:700; color:#0d0d1a; }
.doc-card-desc { font-size:.82rem; color:#6b7280; margin:.2rem 0 .5rem; }
.doc-meta { display:flex; align-items:center; gap:1rem; font-size:.8rem; color:#6b7280; margin-bottom:.5rem; }
.doc-meta span { display:flex; align-items:center; gap:.3rem; }
.doc-meta i { color:#9ca3af; }
.doc-montant { font-size:.95rem; font-weight:700; color:#16a34a; margin-bottom:.75rem; }
.doc-montant i { margin-right:.3rem; }
.doc-actions { display:flex; gap:.5rem; flex-wrap:wrap; }

/* Status badges */
.badge-doc {
    display:inline-block; padding:.18rem .65rem; border-radius:20px;
    font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em;
}
.badge-valide    { background:#dcfce7; color:#15803d; }
.badge-expire    { background:#fee2e2; color:#dc2626; }
.badge-a_renouveler { background:#fef3c7; color:#d97706; }
.badge-archive   { background:#f1f5f9; color:#64748b; }

/* ── Buttons ────────────────────────────────────── */
.btn-detecter {
    background:linear-gradient(90deg,#7c3aed,#9333ea); color:#fff; border:none;
    border-radius:20px; font-size:.75rem; font-weight:700; padding:.35rem .85rem;
    cursor:pointer; display:flex; align-items:center; gap:.3rem;
}
.btn-detecter:hover { opacity:.9; }
.btn-detail {
    background:linear-gradient(90deg,#f97316,#fb923c); color:#fff; border:none;
    border-radius:20px; font-size:.75rem; font-weight:700; padding:.35rem .85rem;
    cursor:pointer; display:flex; align-items:center; gap:.3rem;
}
.btn-detail:hover { opacity:.9; }
.btn-modifier-outline {
    background:#fff; color:#f97316; border:1.5px solid #f97316;
    border-radius:20px; font-size:.75rem; font-weight:700; padding:.35rem .85rem;
    cursor:pointer; text-decoration:none; display:flex; align-items:center; gap:.3rem;
}
.btn-modifier-outline:hover { background:#fff7ed; }
.btn-supprimer-outline {
    background:#fff; color:#ef4444; border:1.5px solid #ef4444;
    border-radius:20px; font-size:.75rem; font-weight:700; padding:.35rem .85rem;
    cursor:pointer; display:flex; align-items:center; gap:.3rem;
}
.btn-supprimer-outline:hover { background:#fee2e2; }

/* ── Detail slide panel ─────────────────────────── */
.detail-overlay {
    position:fixed; inset:0; background:rgba(0,0,0,.35); z-index:1040;
    display:none; align-items:flex-start; justify-content:center;
    padding:2rem 1rem;
    overflow-y:auto;
}
.detail-overlay.show { display:flex; }
.detail-panel {
    background:#fff; border-radius:20px; width:100%; max-width:820px;
    box-shadow:0 20px 60px rgba(0,0,0,.18); animation:slideDown .25s ease;
    overflow:hidden;
}
@keyframes slideDown { from{transform:translateY(-30px);opacity:0} to{transform:translateY(0);opacity:1} }

.detail-header {
    display:flex; align-items:flex-start; gap:1rem; padding:1.5rem 1.75rem 1rem;
    border-bottom:1px solid #f1f5f9;
}
.detail-header-icon { font-size:1.6rem; color:#374151; margin-top:.1rem; }
.detail-header-info { flex:1; }
.detail-header-info h2 { font-size:1.25rem; font-weight:800; color:#0d0d1a; margin:0; }
.detail-header-info .filepath {
    font-size:.75rem; color:#6b7280; font-family:monospace;
    margin-top:.25rem; word-break:break-all;
}
.detail-header-actions { display:flex; gap:.5rem; align-items:center; flex-shrink:0; }
.btn-action-sm {
    display:flex; align-items:center; gap:.35rem; padding:.4rem .9rem;
    border-radius:20px; font-size:.78rem; font-weight:600;
    border:1.5px solid #e8eaf0; background:#fff; color:#374151; cursor:pointer;
    text-decoration:none;
}
.btn-action-sm:hover { border-color:#d1d5db; background:#f9fafb; }
.btn-action-modifier {
    background:linear-gradient(90deg,#f97316,#fb923c); color:#fff; border:none;
}
.btn-action-modifier:hover { opacity:.9; }
.btn-close-panel {
    width:32px; height:32px; border-radius:50%; border:1.5px solid #e8eaf0;
    background:#fff; display:flex; align-items:center; justify-content:center;
    cursor:pointer; color:#374151; font-size:.9rem;
}
.btn-close-panel:hover { background:#fee2e2; color:#ef4444; border-color:#ef4444; }

.detail-body { padding:1.5rem 1.75rem; }
.detail-section { margin-bottom:1.5rem; }
.detail-section-title {
    font-size:.7rem; font-weight:800; text-transform:uppercase;
    letter-spacing:.1em; color:#374151; margin-bottom:1rem;
    padding-bottom:.5rem; border-bottom:1px solid #f1f5f9;
    display:flex; align-items:center; gap:.5rem;
}
.detail-section-title i { color:#f97316; }
.detail-row { display:grid; grid-template-columns:140px 1fr; gap:.3rem 1rem; margin-bottom:.4rem; }
.detail-label { font-size:.8rem; color:#9ca3af; font-weight:500; }
.detail-value { font-size:.85rem; color:#0d0d1a; font-weight:600; }

.financier-box {
    border:2px solid #3b82f6; border-radius:14px; padding:1.25rem;
    display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem;
}
.financier-montant { font-size:1.8rem; font-weight:800; color:#1d4ed8; }
.financier-montant-label { font-size:.72rem; color:#6b7280; text-transform:uppercase; letter-spacing:.07em; }
.financier-statut-label { font-size:.72rem; color:#6b7280; text-transform:uppercase; letter-spacing:.07em; }
.financier-devise-label { font-size:.72rem; color:#6b7280; text-transform:uppercase; letter-spacing:.07em; }
.badge-alloue { background:#dcfce7; color:#15803d; border-radius:20px; padding:.2rem .7rem; font-size:.8rem; font-weight:700; display:inline-flex; align-items:center; gap:.3rem; }
</style>

{# ── Detail Overlay (hidden, filled by JS) ─────────────── #}
<div class="detail-overlay" id="detailOverlay" onclick="closeDetail(event)">
    <div class="detail-panel">
        <div class="detail-header">
            <div class="detail-header-icon"><i class="fas fa-file-alt"></i></div>
            <div class="detail-header-info">
                <h2 id="d-titre">—</h2>
                <div class="filepath" id="d-chemin">—</div>
            </div>
            <div class="detail-header-actions">
                <button class="btn-action-sm" onclick="window.open(window.location.href,'_blank')">
                    <i class="fas fa-language"></i> Traduire
                </button>
                <button class="btn-action-sm">
                    <i class="fas fa-share-alt"></i> Partager
                </button>
                <a class="btn-action-sm btn-action-modifier" id="d-edit-link" href="#">
                    <i class="fas fa-edit"></i> Modifier
                </a>
                <button class="btn-close-panel" onclick="closeDetailDirect()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
        <div class="detail-body">
            {# ── Informations ── #}
            <div class="detail-section">
                <div class="detail-section-title"><i class="fas fa-briefcase"></i> Informations du document</div>
                <div class="detail-row"><span class="detail-label">Description :</span><span class="detail-value" id="d-description">—</span></div>
                <div class="detail-row"><span class="detail-label">Catégorie :</span><span class="detail-value" id="d-categorie">—</span></div>
                <div class="detail-row"><span class="detail-label">Dossier :</span><span class="detail-value" id="d-dossier">—</span></div>
                <div class="detail-row"><span class="detail-label">Date de création :</span><span class="detail-value" id="d-created">—</span></div>
                <div class="detail-row"><span class="detail-label">Date document :</span><span class="detail-value" id="d-date">—</span></div>
                <div class="detail-row"><span class="detail-label">Date d'échéance :</span><span class="detail-value" id="d-echeance">—</span></div>
                <div class="detail-row"><span class="detail-label">Tags :</span><span class="detail-value" id="d-tags">—</span></div>
            </div>
            {# ── Relevé financier (echeances) ── #}
            <div class="detail-section" id="d-financier-section" style="display:none;">
                <div class="detail-section-title"><i class="fas fa-coins"></i> Relevé financier</div>
                <div class="financier-box">
                    <div>
                        <div class="financier-montant-label">Montant Total</div>
                        <div class="financier-montant" id="d-montant">—</div>
                    </div>
                    <div>
                        <div class="financier-statut-label">Statut du Budget</div>
                        <div style="margin-top:.4rem;"><span class="badge-alloue"><i class="fas fa-check"></i> Allouée</span></div>
                    </div>
                    <div>
                        <div class="financier-devise-label">Devise Locale</div>
                        <div style="margin-top:.4rem;font-size:.9rem;font-weight:700;color:#0d0d1a;">TND (Dinar Tunisien)</div>
                    </div>
                </div>
            </div>
            {# ── Fichier associé ── #}
            <div class="detail-section">
                <div class="detail-section-title"><i class="fas fa-paperclip"></i> Fichier associé</div>
                <div class="detail-row"><span class="detail-label">Type :</span><span class="detail-value" id="d-type">—</span></div>
                <div class="detail-row"><span class="detail-label">Taille :</span><span class="detail-value" id="d-taille">—</span></div>
                <div class="detail-row"><span class="detail-label">Statut :</span><span class="detail-value" id="d-statut">—</span></div>
            </div>
        </div>
    </div>
</div>

{# ── Hidden data store ─────────────────────────────────── #}
{% for doc in documents %}
<div class="doc-data" style="display:none;"
     data-id="{{ doc.id }}"
     data-titre="{{ doc.titre|e }}"
     data-chemin="{{ doc.cheminFichier|e }}"
     data-description="{{ doc.description ?? '(Pas de description)' }}"
     data-categorie="{{ doc.categorie ? doc.categorie.nomCategorie : '—' }}"
     data-dossier="{{ doc.dossier ? doc.dossier.nomDossier : '—' }}"
     data-created="{{ doc.createdAt|date('d/m/Y H:i') }}"
     data-date="{{ doc.dateDocument ? doc.dateDocument|date('d/m/Y') : '—' }}"
     data-echeance="{{ doc.dateEcheance ? doc.dateEcheance|date('d/m/Y') : '—' }}"
     data-tags="{{ doc.tags ?? '—' }}"
     data-type="{{ doc.typeDocument|capitalize }}"
     data-taille="{{ doc.tailleFichier ? (doc.tailleFichier / 1024)|round(1) ~ ' Ko' : '—' }}"
     data-statut="{{ doc.statut|replace({'_': ' '})|upper }}"
     data-statut-class="{{ doc.statut }}"
     data-montant="{{ doc.echeances|length > 0 ? doc.echeances|first.montant : '' }}"
     data-edit-url="{{ path('user_document_edit', {id: doc.id}) }}"
></div>
{% endfor %}

{# ── Main layout ───────────────────────────────────────── #}
<div class="doc-layout">

    {# ── LEFT SIDEBAR ── #}
    <div class="doc-sidebar">
        <div>
            <h1>Gestion des Documents</h1>
            <div class="subtitle">Organisez et gérez vos documents en toute facilité</div>
        </div>

        <button onclick="filterDossier(null)" class="sidebar-nav-link {{ dossierId is null and q == '' ? 'active' : '' }}">
            <i class="fas fa-folder"></i> Tous les documents
        </button>
        <button onclick="window.location='{{ path('user_document_index') }}?statut=archive'" class="sidebar-nav-link">
            <i class="fas fa-trash-alt"></i> Corbeille
        </button>

        <div class="sidebar-section-title">Dossiers</div>

        {% if dossiers is empty %}
            <div style="font-size:.8rem;color:#9ca3af;padding:.5rem .75rem;">Aucun dossier</div>
        {% else %}
            {% for dos in dossiers %}
            <div class="dossier-item">
                <i class="fas fa-folder" style="color:#f97316;font-size:.9rem;"></i>
                <span class="dossier-name">{{ dos.nomDossier }}</span>
                <button class="btn-filtrer" onclick="filterDossier({{ dos.id }})">Filtrer</button>
                <button class="btn-icon" title="Modifier" onclick="window.location='{{ path('user_dossier_edit', {id: dos.id}) }}'">
                    <i class="fas fa-thumbtack"></i>
                </button>
                <button class="btn-icon" title="Supprimer dossier" onclick="if(confirm('Supprimer ce dossier ?')) window.location='{{ path('user_dossier_delete', {id: dos.id}) }}'">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            {% endfor %}
        {% endif %}

        <div style="margin-top:auto; padding-top:1rem; border-top:1px solid #f1f5f9;">
            <a href="{{ path('user_document_new') }}" class="btn-filtrer" style="display:block;text-align:center;text-decoration:none;padding:.5rem;border-radius:12px;">
                <i class="fas fa-plus me-1"></i> Nouveau document
            </a>
        </div>
    </div>

    {# ── RIGHT MAIN ── #}
    <div class="doc-main">

        {# Search + filter row #}
        <form method="GET" action="{{ path('user_document_index') }}" id="filterForm">
            <div class="search-row">
                <div class="search-input-wrap">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" value="{{ q }}" placeholder="Rechercher un document...">
                    <input type="hidden" name="dossier" id="dossierHidden" value="{{ dossierId ?? '' }}">
                    <input type="hidden" name="categorie" id="categorieHidden" value="{{ categorieId ?? '' }}">
                    <input type="hidden" name="statut" value="{{ statut }}">
                    <input type="hidden" name="type" value="{{ type }}">
                </div>
                <select class="filter-select" name="categorie" onchange="this.form.submit()">
                    <option value="">🗂 Toutes les catégories</option>
                    {% for cat in categories %}
                    <option value="{{ cat.id }}" {% if categorieId == cat.id %}selected{% endif %}>{{ cat.nomCategorie }}</option>
                    {% endfor %}
                </select>
                <select class="filter-select" name="statut" onchange="this.form.submit()">
                    <option value="">Tous statuts</option>
                    <option value="valide" {% if statut == 'valide' %}selected{% endif %}>Valide</option>
                    <option value="expire" {% if statut == 'expire' %}selected{% endif %}>Expiré</option>
                    <option value="a_renouveler" {% if statut == 'a_renouveler' %}selected{% endif %}>À renouveler</option>
                    <option value="archive" {% if statut == 'archive' %}selected{% endif %}>Archivé</option>
                </select>
                {% if q or dossierId or categorieId or statut or type %}
                <a href="{{ path('user_document_index') }}" style="color:#9ca3af;font-size:.85rem;white-space:nowrap;text-decoration:none;">
                    <i class="fas fa-times"></i> Réinitialiser
                </a>
                {% endif %}
            </div>
        </form>

        <div class="doc-count">
            <strong>{{ documents|length }}</strong> document(s)
            {% if dossierId %} — dossier filtré{% endif %}
        </div>

        {# Flash messages #}
        {% for msg in app.flashes('success') %}
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3" style="border-radius:12px;border:none;background:#dcfce7;color:#15803d;">
            <i class="fas fa-check-circle"></i> {{ msg }}
        </div>
        {% endfor %}

        {# Document cards #}
        {% if documents is empty %}
        <div style="text-align:center;padding:5rem 2rem;color:#9ca3af;">
            <i class="fas fa-file-alt" style="font-size:3rem;opacity:.3;display:block;margin-bottom:1rem;"></i>
            <div style="font-size:1rem;font-weight:600;">Aucun document trouvé</div>
            <div style="font-size:.85rem;margin-top:.25rem;">Essayez de modifier vos filtres ou ajoutez un nouveau document.</div>
            <a href="{{ path('user_document_new') }}" class="btn-filtrer" style="display:inline-block;margin-top:1.25rem;padding:.5rem 1.25rem;border-radius:12px;text-decoration:none;">
                <i class="fas fa-plus me-1"></i> Nouveau document
            </a>
        </div>
        {% else %}
            {% for doc in documents %}
            <div class="doc-card">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem;margin-bottom:.35rem;">
                    <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;">
                        <span class="doc-card-title">
                            <i class="fas fa-file-alt" style="color:#374151;margin-right:.3rem;font-size:.9rem;"></i>
                            {{ doc.titre }}
                        </span>
                        <span class="badge-doc badge-{{ doc.statut }}">{{ doc.statut|upper|replace({'_': ' '}) }}</span>
                    </div>
                </div>

                {% if doc.description %}
                <div class="doc-card-desc">{{ doc.description|slice(0, 90) }}{% if doc.description|length > 90 %}…{% endif %}</div>
                {% else %}
                <div class="doc-card-desc">(Pas de description)</div>
                {% endif %}

                <div class="doc-meta">
                    {% if doc.dossier %}
                    <span><i class="fas fa-folder"></i> {{ doc.dossier.nomDossier }}</span>
                    {% endif %}
                    <span><i class="fas fa-tag"></i> {{ doc.typeDocument|capitalize }}</span>
                    {% if doc.dateEcheance %}
                    <span><i class="fas fa-calendar"></i> Éch. {{ doc.dateEcheance|date('d/m/Y') }}</span>
                    {% endif %}
                </div>

                {% if doc.echeances|length > 0 %}
                <div class="doc-montant">
                    <i class="fas fa-coins"></i>
                    {{ doc.echeances|first.montant|number_format(2, ',', ' ') }} TND
                </div>
                {% endif %}

                <div class="doc-actions">
                    <button class="btn-detecter" onclick="openDetail({{ doc.id }})">
                        <i class="fas fa-search"></i> Détecter
                    </button>
                    <button class="btn-detail" onclick="openDetail({{ doc.id }})">
                        <i class="fas fa-eye"></i> Détail
                    </button>
                    <a href="{{ path('user_document_edit', {id: doc.id}) }}" class="btn-modifier-outline">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <form action="{{ path('user_document_delete', {id: doc.id}) }}" method="post" style="display:contents;" onsubmit="return confirm('Supprimer ce document ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ doc.id) }}">
                        <button type="submit" class="btn-supprimer-outline">
                            <i class="fas fa-trash"></i> Supprimer
                        </button>
                    </form>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

<script>
function filterDossier(dossierId) {
    const url = new URL(window.location.href);
    if (dossierId) {
        url.searchParams.set('dossier', dossierId);
    } else {
        url.searchParams.delete('dossier');
    }
    window.location.href = url.toString();
}

function openDetail(id) {
    const el = document.querySelector(`.doc-data[data-id="${id}"]`);
    if (!el) return;

    document.getElementById('d-titre').textContent      = el.dataset.titre;
    document.getElementById('d-chemin').textContent     = 'Chemin: ' + el.dataset.chemin;
    document.getElementById('d-description').textContent = el.dataset.description;
    document.getElementById('d-categorie').textContent  = el.dataset.categorie;
    document.getElementById('d-dossier').textContent    = el.dataset.dossier;
    document.getElementById('d-created').textContent    = el.dataset.created;
    document.getElementById('d-date').textContent       = el.dataset.date;
    document.getElementById('d-echeance').textContent   = el.dataset.echeance;
    document.getElementById('d-tags').textContent       = el.dataset.tags;
    document.getElementById('d-type').textContent       = el.dataset.type;
    document.getElementById('d-taille').textContent     = el.dataset.taille;
    document.getElementById('d-statut').innerHTML       = `<span class="badge-doc badge-${el.dataset.statutClass}">${el.dataset.statut}</span>`;
    document.getElementById('d-edit-link').href         = el.dataset.editUrl;

    // Financial section
    const montant = el.dataset.montant;
    const financierSection = document.getElementById('d-financier-section');
    if (montant && montant !== '') {
        document.getElementById('d-montant').textContent = parseFloat(montant).toLocaleString('fr-TN', {minimumFractionDigits:3, maximumFractionDigits:3}) + ' TND';
        financierSection.style.display = 'block';
    } else {
        financierSection.style.display = 'none';
    }

    document.getElementById('detailOverlay').classList.add('show');
    document.body.style.overflow = 'hidden';
}

function closeDetail(e) {
    if (e.target === document.getElementById('detailOverlay')) closeDetailDirect();
}
function closeDetailDirect() {
    document.getElementById('detailOverlay').classList.remove('show');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDetailDirect(); });
</script>
{% endblock %}
