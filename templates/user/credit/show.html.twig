{% extends 'user/base.html.twig' %}
{% block title %}Crédit #{{ credit.id }} - FinTrack{% endblock %}
{% block page_title %}Détail du Crédit{% endblock %}
{% block page_subtitle %}#{{ credit.id }}{% endblock %}

{% block content %}
<div class="d-flex gap-2 mb-4">
    <a href="{{ path('user_credit_index') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Retour</a>
    {% if credit.status == 'en_attente' %}
    <a href="{{ path('user_credit_edit', {id: credit.id}) }}" class="btn btn-primary-custom"><i class="fas fa-edit"></i> Modifier</a>
    {% endif %}
</div>

<div class="form-card" style="max-width:700px;">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div style="width:48px;height:48px;border-radius:12px;background:#e0f2fe;display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-credit-card" style="color:#0369a1;font-size:1.2rem;"></i>
        </div>
        <div>
            <h5 class="fw-bold mb-0" style="color:#1e293b;">Crédit #{{ credit.id }}</h5>
            <span class="text-muted small">Compte : {{ credit.compte }}</span>
        </div>
        <div class="ms-auto">
            <span class="badge {{ credit.status == 'approuve' ? 'bg-success' : (credit.status == 'refuse' ? 'bg-danger' : (credit.status == 'rembourse' ? 'bg-info' : 'bg-warning text-dark')) }} px-3 py-2 rounded-pill">
                {{ credit.status|replace({'_': ' '})|upper }}
            </span>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="text-muted small d-block">Montant</label>
            <span class="fw-bold fs-4" style="color:#f97316;">{{ credit.montant|number_format(2, ',', ' ') }} DT</span>
        </div>
        <div class="col-md-6">
            <label class="text-muted small d-block">Mensualité</label>
            <span class="fw-bold fs-4" style="color:#16a34a;">{{ credit.mensualite ? credit.mensualite|number_format(2, ',', ' ') ~ ' DT' : '—' }}</span>
        </div>
        <div class="col-md-6">
            <label class="text-muted small d-block">Taux d'intérêt</label>
            <span class="fw-semibold">{{ credit.tauxInteret }}% / an</span>
        </div>
        <div class="col-md-6">
            <label class="text-muted small d-block">Durée</label>
            <span class="fw-semibold">{{ credit.dureeMois }} mois</span>
        </div>
        <div class="col-md-6">
            <label class="text-muted small d-block">Date de début</label>
            <span class="fw-semibold">{{ credit.dateDebut|date('d/m/Y') }}</span>
        </div>
        <div class="col-md-6">
            <label class="text-muted small d-block">Compte lié</label>
            <span class="fw-semibold">{{ credit.compte }}</span>
        </div>
    </div>

    <hr class="mt-4">
    <form action="{{ path('user_credit_delete', {id: credit.id}) }}" method="post" onsubmit="return confirm('Supprimer ce crédit ?')">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ credit.id) }}">
        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i> Supprimer</button>
    </form>
</div>
{% endblock %}
