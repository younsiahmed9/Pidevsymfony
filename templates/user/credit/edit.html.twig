{% extends 'user/base.html.twig' %}
{% block title %}Modifier Crédit #{{ credit.id }} - FinTrack{% endblock %}
{% block page_title %}Modifier la demande{% endblock %}
{% block page_subtitle %}Crédit #{{ credit.id }}{% endblock %}

{% block content %}
<div class="mb-4">
    <a href="{{ path('user_credit_show', {id: credit.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i> Retour</a>
</div>

{% if credit.status != 'en_attente' %}
<div class="alert alert-warning d-flex align-items-center gap-2 mb-4" style="border-left:4px solid #f59e0b;">
    <i class="fas fa-lock"></i>
    <div>Cette demande a le statut <strong>{{ credit.status }}</strong> et a déjà été traitée. Seuls les crédits <strong>en attente</strong> peuvent être modifiés.</div>
</div>
{% endif %}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="form-card">
            <h6 class="fw-semibold mb-4 pb-2 border-bottom">Modifier la demande de crédit</h6>
            {{ form_start(form) }}
            <div class="row g-3">
                <div class="col-md-12">
                    {{ form_label(form.compte, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                    {{ form_widget(form.compte) }}
                    {{ form_errors(form.compte) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.montant, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                    <div class="input-group">
                        <span class="input-group-text">DT</span>
                        {{ form_widget(form.montant) }}
                    </div>
                    {{ form_errors(form.montant) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.tauxInteret, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                    <div class="input-group">
                        {{ form_widget(form.tauxInteret) }}
                        <span class="input-group-text">%</span>
                    </div>
                    {{ form_errors(form.tauxInteret) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.dureeMois, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                    <div class="input-group">
                        {{ form_widget(form.dureeMois) }}
                        <span class="input-group-text">mois</span>
                    </div>
                    {{ form_errors(form.dureeMois) }}
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium">Statut (lecture seule)</label>
                    <div class="form-control-plaintext">
                        <span class="badge {{ credit.status == 'approuve' ? 'bg-success' : (credit.status == 'refuse' ? 'bg-danger' : 'bg-warning text-dark') }}">
                            {{ credit.status|replace({'_': ' '}) }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn-primary-custom" {{ credit.status != 'en_attente' ? 'disabled' : '' }}>
                    <i class="fas fa-save me-1"></i> Enregistrer
                </button>
                <a href="{{ path('user_credit_show', {id: credit.id}) }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
