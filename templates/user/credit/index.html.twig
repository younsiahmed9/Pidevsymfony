{% extends 'user/base.html.twig' %}
{% block title %}Mes Crédits - FinTrack{% endblock %}
{% block page_title %}Mes Crédits{% endblock %}
{% block page_subtitle %}{{ credits|length }} crédit(s){% endblock %}

{% block content %}
<div class="form-card mb-4">
    <form method="GET" action="{{ path('user_credit_index') }}" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label small fw-medium">Recherche</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                <input type="text" name="q" value="{{ q }}" class="form-control" placeholder="Numéro de compte...">
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-medium">Statut</label>
            <select name="status" class="form-select">
                <option value="">Tous</option>
                <option value="en_attente" {{ status == 'en_attente' ? 'selected' : '' }}>En attente</option>
                <option value="approuve"   {{ status == 'approuve'   ? 'selected' : '' }}>Approuvé</option>
                <option value="refuse"     {{ status == 'refuse'     ? 'selected' : '' }}>Refusé</option>
                <option value="rembourse"  {{ status == 'rembourse'  ? 'selected' : '' }}>Remboursé</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2 align-items-end">
            <button type="submit" class="btn flex-fill" style="background:#0369a1;color:#fff;"><i class="fas fa-filter"></i> Filtrer</button>
            <a href="{{ path('user_credit_index') }}" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">{{ credits|length }} résultat(s)</span>
    <a href="{{ path('user_credit_new') }}" class="btn" style="background:#0369a1;color:#fff;"><i class="fas fa-plus"></i> Nouveau crédit</a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="px-3">#</th>
                    <th>Compte</th>
                    <th>Montant</th>
                    <th>Taux / Durée</th>
                    <th>Mensualité</th>
                    <th>Date début</th>
                    <th>Statut</th>
                    <th class="text-end px-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for credit in credits %}
                <tr>
                    <td class="px-3 text-muted">{{ credit.id }}</td>
                    <td><strong>{{ credit.compte }}</strong></td>
                    <td class="fw-semibold">{{ credit.montant|number_format(2, ',', ' ') }} DT</td>
                    <td class="small text-muted">{{ credit.tauxInteret }}% / {{ credit.dureeMois }} mois</td>
                    <td class="fw-medium" style="color:#0d9488;">
                        {{ credit.mensualite ? credit.mensualite|number_format(2, ',', ' ') ~ ' DT' : '—' }}
                    </td>
                    <td class="small text-muted">{{ credit.dateDebut|date('d/m/Y') }}</td>
                    <td>
                        <span class="badge {{ credit.status == 'approuve' ? 'bg-success' : (credit.status == 'refuse' ? 'bg-danger' : (credit.status == 'rembourse' ? 'bg-info' : 'bg-warning text-dark')) }}">
                            {{ credit.status|replace({'_': ' '}) }}
                        </span>
                    </td>
                    <td class="text-end px-3">
                        <div class="d-flex gap-1 justify-content-end">
                            <a href="{{ path('user_credit_show', {id: credit.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                            {% if credit.status == 'en_attente' %}
                            <a href="{{ path('user_credit_edit', {id: credit.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                            {% endif %}
                            <form action="{{ path('user_credit_delete', {id: credit.id}) }}" method="post" onsubmit="return confirm('Supprimer ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ credit.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="8" class="text-center py-5 text-muted"><i class="fas fa-credit-card fa-3x mb-3 d-block opacity-25"></i>Aucun crédit trouvé</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
