{% extends 'user/base.html.twig' %}
{% block title %}Dossier: {{ dossier.nomDossier }} - FinTrack{% endblock %}
{% block page_title %}Dossier{% endblock %}
{% block page_subtitle %}{{ dossier.nomDossier }}{% endblock %}
{% block content %}
<div class="d-flex gap-2 mb-4">
    <a href="{{ path('user_dossier_index') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Retour</a>
    <a href="{{ path('user_dossier_edit', {id: dossier.id}) }}" class="btn-primary-custom"><i class="fas fa-edit"></i> Modifier</a>
</div>
<div class="row g-4">
    <div class="col-md-8">
        <div class="form-card">
            <div class="d-flex align-items-center gap-3 mb-4">
                <i class="fas fa-folder fa-3x" style="color:#f97316;"></i>
                <div><h5 class="mb-0 fw-bold">{{ dossier.nomDossier }}</h5><div class="text-muted small">{{ dossier.documents|length }} document(s)</div></div>
            </div>
            {% if dossier.description %}<p>{{ dossier.description }}</p>{% endif %}
            <div class="text-muted small">Créé le {{ dossier.createdAt|date('d/m/Y') }}</div>
        </div>
        {% if dossier.documents|length > 0 %}
        <div class="table-card mt-4">
            <div class="table-header"><h6 class="mb-0 fw-semibold">Documents</h6></div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Titre</th><th>Type</th><th>Statut</th></tr></thead>
                    <tbody>
                        {% for doc in dossier.documents %}
                        <tr><td><a href="{{ path('user_document_show', {id: doc.id}) }}" class="text-decoration-none">{{ doc.titre }}</a></td><td>{{ doc.typeDocument }}</td><td><span class="badge-status badge-{{ doc.statut }}">{{ doc.statut }}</span></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
