{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
    /* ===== GLOBAL FIX — style.css sets body color:#fff which breaks forms ===== */
    body { color: #212529 !important; }
    p, li, small { color: inherit; }
    /* Form elements */
    input, input[type="text"], input[type="email"], input[type="password"],
    input[type="number"], input[type="date"], input[type="search"],
    textarea, .form-control, .form-select {
        color: #212529 !important;
        background-color: #fff !important;
        border-color: #dee2e6 !important;
    }
    input::placeholder, textarea::placeholder { color: #9ca3af !important; opacity: 1; }
    select, select.form-select, select option { color: #212529 !important; background-color: #fff !important; }
    .form-label, label { color: #374151 !important; }
    .form-text { color: #6c757d !important; }
    .form-check-label { color: #374151 !important; }
    .form-check-input { background-color: #fff !important; border-color: #dee2e6 !important; }
    .input-group-text { color: #6c757d !important; background-color: #f9fafb !important; border-color: #dee2e6 !important; }
    /* Tables */
    .table td, .table th { color: #374151 !important; }
    .table-light, .table-light th, .table-light td,
    thead.table-light th, tbody.table-light td { background-color: #f8f9fa !important; color: #374151 !important; }
    thead tr th { color: #6b7280 !important; }
    /* Badges & misc */
    .badge.bg-light { color: #374151 !important; background-color: #f3f4f6 !important; }
    .badge.text-dark { color: #212529 !important; }
    /* Alerts */
    .alert-success { color: #0f766e !important; background-color: #ccfbf1 !important; }
    .alert-danger { color: #b91c1c !important; background-color: #fee2e2 !important; }
    .alert-warning { color: #92400e !important; background-color: #fef3c7 !important; }
    .alert-info { color: #0369a1 !important; background-color: #e0f2fe !important; }
    /* Cards */
    .card { color: #212529; }
    .card-body, .card-title, .card-text { color: #212529 !important; }
    /* Headings in content area */
    .content-area h1, .content-area h2, .content-area h3,
    .content-area h4, .content-area h5, .content-area h6 { color: #0f172a; }
    /* Topbar */
    .topbar h5 { color: #0f172a !important; }
    .text-muted { color: #6c757d !important; }

    /* ===== USER LAYOUT — Light sidebar, teal accent ===== */
    body { background: #f8fafc; }

    /* Sidebar — white with teal accent */
    .sidebar {
        width: 255px;
        min-height: 100vh;
        background: #ffffff;
        position: fixed; left: 0; top: 0; z-index: 1000;
        padding-top: 0; overflow-y: auto;
        border-right: 1px solid #e2e8f0;
        box-shadow: 2px 0 12px rgba(0,0,0,0.05);
    }

    /* Brand block */
    .sidebar .brand {
        padding: 0;
        border-bottom: 1px solid #e2e8f0;
    }
    .sidebar .brand-inner {
        display: flex; align-items: center; gap: 0.75rem;
        padding: 1.25rem 1.5rem;
    }
    .sidebar .brand-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; font-weight: 800; color: #fff;
        flex-shrink: 0; box-shadow: 0 2px 8px rgba(13,148,136,0.3);
    }
    .sidebar .brand-text { line-height: 1.2; }
    .sidebar .brand-text .brand-name { font-size: 1.05rem; font-weight: 700; color: #0f172a; }
    .sidebar .brand-text .brand-role {
        font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1.5px;
        color: #0d9488; font-weight: 600;
    }

    /* Nav section labels */
    .sidebar .nav-section {
        padding: 1.2rem 1.5rem 0.3rem;
        color: #94a3b8;
        font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600;
    }

    /* Nav links */
    .sidebar .nav-link {
        color: #475569;
        padding: 0.65rem 1.5rem;
        display: flex; align-items: center; gap: 0.75rem;
        transition: all 0.2s; border-left: 3px solid transparent;
        text-decoration: none; font-size: 0.875rem; font-weight: 400;
        margin: 1px 0;
    }
    .sidebar .nav-link i { width: 18px; text-align: center; font-size: 0.85rem; color: #94a3b8; }
    .sidebar .nav-link:hover {
        color: #0d9488; background: #f0fdfa;
        border-left-color: #5eead4;
    }
    .sidebar .nav-link:hover i { color: #0d9488; }
    .sidebar .nav-link.active {
        color: #0d9488; background: #f0fdfa;
        border-left-color: #0d9488; font-weight: 600;
    }
    .sidebar .nav-link.active i { color: #0d9488; }

    /* Sidebar footer */
    .sidebar-footer {
        padding: 1rem 1.5rem; border-top: 1px solid #e2e8f0;
        margin-top: auto;
    }

    /* Main area */
    .main-content { margin-left: 255px; min-height: 100vh; background: #f8fafc; }

    /* Topbar */
    .topbar {
        background: #fff;
        padding: 0.85rem 2rem;
        border-bottom: 1px solid #e2e8f0;
        display: flex; align-items: center;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        position: sticky; top: 0; z-index: 100;
    }
    .topbar-user-badge {
        background: #f0fdfa; color: #0d9488;
        padding: 0.2rem 0.75rem; border-radius: 100px;
        font-size: 0.7rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
        border: 1px solid #99f6e4;
    }
    .topbar-avatar {
        width: 36px; height: 36px; border-radius: 10px;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 700; font-size: 0.85rem;
        box-shadow: 0 2px 8px rgba(13,148,136,0.3);
    }

    /* Content area */
    .content-area { padding: 2rem; }

    /* Stat cards — user style */
    .stat-card {
        background: #fff; border-radius: 14px; padding: 1.5rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 6px rgba(0,0,0,0.04);
        transition: transform 0.2s, box-shadow 0.2s;
        position: relative; overflow: hidden;
    }
    .stat-card::before {
        content: '';
        position: absolute; top: 0; left: 0; right: 0; height: 3px;
        background: linear-gradient(90deg, #0d9488, #38bdf8);
    }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .stat-card .stat-icon { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    .stat-card .stat-value { font-size: 2rem; font-weight: 700; color: #0f172a; }
    .stat-card .stat-label { font-size: 0.78rem; color: #94a3b8; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-card .stat-link { font-size: 0.78rem; color: #0d9488; text-decoration: none; font-weight: 500; }
    .stat-card .stat-link:hover { text-decoration: underline; }

    /* Table card */
    .table-card {
        background: #fff; border-radius: 14px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 6px rgba(0,0,0,0.04); overflow: hidden;
    }
    .table-card .table-header {
        padding: 1.1rem 1.5rem; border-bottom: 1px solid #f1f5f9;
        display: flex; align-items: center; justify-content: space-between;
        background: #fafafa;
    }
    .table-card .table-header h6 { color: #0f172a; font-weight: 600; }

    /* Form card */
    .form-card {
        background: #fff; border-radius: 14px; padding: 2rem;
        border: 1px solid #e2e8f0; box-shadow: 0 1px 6px rgba(0,0,0,0.04);
    }

    /* Buttons */
    .btn-primary-custom {
        background: #0d9488; border: none; color: #fff !important;
        padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 500;
        text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;
        cursor: pointer; font-size: 0.875rem; transition: background 0.2s;
    }
    .btn-primary-custom:hover { background: #0f766e; }

    /* Tables */
    .table th {
        font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px;
        color: #94a3b8; font-weight: 600; border-top: none; background: #fafafa;
    }
    .table td { vertical-align: middle; color: #374151; font-size: 0.875rem; }
    .action-btns a, .action-btns button { padding: 0.3rem 0.6rem; border-radius: 6px; font-size: 0.8rem; }

    /* Status badges */
    .badge-status { padding: 0.25rem 0.75rem; border-radius: 100px; font-size: 0.73rem; font-weight: 600; display: inline-block; }
    .badge-actif, .badge-valide, .badge-approuve, .badge-completed { background: #ccfbf1; color: #0f766e; }
    .badge-suspendu, .badge-a_renouveler, .badge-en_attente, .badge-pending, .badge-notified { background: #fef3c7; color: #b45309; }
    .badge-clos, .badge-expire, .badge-rejete, .badge-overdue { background: #fee2e2; color: #b91c1c; }
    .badge-archive, .badge-rembourse { background: #e0f2fe; color: #0369a1; }

    /* Alerts */
    .alert { border-radius: 10px; border: none; }
    .alert-success { background: #ccfbf1; color: #0f766e; }
    .alert-danger { background: #fee2e2; color: #b91c1c; }
    .alert-warning { background: #fef3c7; color: #92400e; }
    .alert-info { background: #e0f2fe; color: #0369a1; }
</style>
{% endblock %}

{% block body %}
<!-- ===== USER SIDEBAR ===== -->
<nav class="sidebar d-flex flex-column">
    <!-- Brand -->
    <div class="brand">
        <div class="brand-inner">
            <div class="brand-icon">F</div>
            <div class="brand-text">
                <div class="brand-name">FinTrack</div>
                <div class="brand-role">Mon Espace</div>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <div class="pt-2 flex-grow-1">
        <div class="nav-section">Général</div>
        <a href="{{ path('user_dashboard') }}" class="nav-link {{ app.current_route == 'user_dashboard' ? 'active' : '' }}">
            <i class="fas fa-home"></i> Accueil
        </a>

        <div class="nav-section">Mes Comptes</div>
        <a href="{{ path('user_compte_index') }}" class="nav-link {{ 'user_compte' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-university"></i> Mes Comptes
        </a>
        <a href="{{ path('user_credit_index') }}" class="nav-link {{ 'user_credit' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-credit-card"></i> Mes Crédits
        </a>

        <div class="nav-section">Mes Documents</div>
        <a href="{{ path('user_document_index') }}" class="nav-link {{ 'user_document' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-file-alt"></i> Documents
        </a>
        <a href="{{ path('user_dossier_index') }}" class="nav-link {{ 'user_dossier' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-folder"></i> Dossiers
        </a>
        <a href="{{ path('user_echeance_index') }}" class="nav-link {{ 'user_echeance' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-calendar-check"></i> Échéances
        </a>

        <div class="nav-section">Retour</div>
        <a href="{{ path('home') }}" class="nav-link">
            <i class="fas fa-arrow-left"></i> Accueil site
        </a>
    </div>

    <!-- Sidebar footer -->
    <div class="sidebar-footer">
        <div style="display:flex;align-items:center;gap:0.6rem;">
            <div style="width:32px;height:32px;border-radius:8px;background:#f0fdfa;display:flex;align-items:center;justify-content:center;color:#0d9488;font-weight:700;font-size:0.8rem;border:1px solid #99f6e4;">U</div>
            <div style="line-height:1.2;">
                <div style="color:#0f172a;font-size:0.8rem;font-weight:500;">Utilisateur</div>
                <div style="color:#94a3b8;font-size:0.7rem;">Espace personnel</div>
            </div>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="main-content">
    <!-- Topbar -->
    <div class="topbar">
        <div class="d-flex align-items-center justify-content-between w-100">
            <div>
                <h5 class="mb-0 fw-bold" style="color:#0f172a;">{% block page_title %}Mon Espace{% endblock %}</h5>
                <small style="color:#94a3b8;font-size:0.78rem;">{% block page_subtitle %}{% endblock %}</small>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="topbar-user-badge"><i class="fas fa-user me-1"></i>Utilisateur</span>
                <div class="topbar-avatar">U</div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="content-area">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-check-circle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {% block content %}{% endblock %}
    </div>
</div>
{% endblock %}
