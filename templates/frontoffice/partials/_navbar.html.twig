<style>
.fo-navbar-links {
    gap: 0.35rem;
}

.fo-navbar-links .nav-link {
    padding-left: 0.9rem;
    padding-right: 0.9rem;
    border-radius: 999px;
}

.fo-navbar-links .nav-link:hover {
    background: rgba(13, 110, 253, 0.08);
}

.btn-profile-circle {
    width: 42px;
    height: 42px;
    padding: 0;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.35);
    transition: box-shadow 0.2s ease, transform 0.15s ease;
}

.btn-profile-circle:hover,
.btn-profile-circle:focus-visible {
    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.55);
    transform: scale(1.03);
}

.btn-profile-circle.dropdown-toggle::after {
    display: none;
}

.navbar-profile-circle-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
}

.navbar-profile-circle-fallback {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(13, 110, 253, 0.15);
    color: #0d6efd;
    font-size: 0.95rem;
    font-weight: 700;
}

html[data-theme='dark'] .btn-profile-circle {
    box-shadow: 0 0 0 2px rgba(148, 163, 184, 0.45);
}

html[data-theme='dark'] .navbar-profile-circle-fallback {
    background: rgba(96, 165, 250, 0.2);
    color: #93c5fd;
}

@media (min-width: 1200px) {
    .nav-hover-dropdown:hover .dropdown-menu {
        display: block;
        margin-top: 0;
    }
}

/* Theme toggle readability (light + dark) */
html:not([data-theme='dark']) #themeToggleBtn {
    background-color: #ffffff;
    border-color: rgba(17, 24, 39, 0.25);
    color: #111827;
}

html:not([data-theme='dark']) #themeToggleBtn:hover,
html:not([data-theme='dark']) #themeToggleBtn:focus-visible {
    background-color: rgba(17, 24, 39, 0.06);
    border-color: rgba(17, 24, 39, 0.35);
    color: #0b1220;
}

html[data-theme='dark'] #themeToggleBtn {
    background-color: transparent;
    border-color: rgba(229, 231, 235, 0.28);
    color: #e5e7eb;
}

html[data-theme='dark'] #themeToggleBtn:hover,
html[data-theme='dark'] #themeToggleBtn:focus-visible {
    background-color: rgba(229, 231, 235, 0.10);
    border-color: rgba(229, 231, 235, 0.40);
    color: #ffffff;
}
</style>

<script>
    (function () {
        var button = document.getElementById('themeToggleBtn');
        if (!button) {
            return;
        }

        var icon = button.querySelector('i');
        var setUi = function (theme) {
            var isDark = theme === 'dark';
            button.setAttribute('aria-pressed', isDark ? 'true' : 'false');
            button.setAttribute('aria-label', isDark ? 'Activer le mode clair' : 'Activer le mode sombre');
            if (icon) {
                icon.classList.toggle('fa-moon', !isDark);
                icon.classList.toggle('fa-sun', isDark);
            }
        };

        var currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        setUi(currentTheme);

        button.addEventListener('click', function () {
            var activeTheme = document.documentElement.getAttribute('data-theme') || 'light';
            var nextTheme = activeTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', nextTheme);
            localStorage.setItem('ft-theme', nextTheme);
            setUi(nextTheme);
        });
    })();
</script>



