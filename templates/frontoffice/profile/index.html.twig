{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mon Profil - FinTrack{% endblock %}

{% block body %}
<section class="section py-5 bg-tertiary">
    <div class="container mt-4">
        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="h3 fw-bold mb-0">Mon Profil</h2>
                <p class="text-muted">Gérez vos informations personnelles</p>
            </div>
            <div class="col-md-6 text-md-end text-start mt-3 mt-md-0">
                <div class="d-inline-flex align-items-center p-3 bg-white rounded shadow-sm">
                    <div class="me-3">
                        <p class="text-muted small mb-0">Solde Total</p>
                        <h4 class="mb-0 fw-bold text-primary">{{ app.user.solde|number_format(2, ',', ' ') }} <span class="fs-6 text-muted">EUR</span></h4>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="fas fa-wallet fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h4 class="h5 mb-0"><i class="fas fa-user-edit me-2 text-primary"></i>Informations Personnelles</h4>
                    </div>
                    <div class="card-body p-4">
                        {{ form_start(profileForm, {'attr': {'class': 'row g-3', 'novalidate': 'novalidate'}}) }}
                            
                            <div class="col-md-6">
                                {{ form_label(profileForm.prenom, 'Prénom', {'label_attr': {'class': 'form-label fw-bold small text-muted'}}) }}
                                {{ form_widget(profileForm.prenom, {'attr': {'class': 'form-control shadow-none'}}) }}
                                <div class="text-danger small mt-1">{{ form_errors(profileForm.prenom) }}</div>
                            </div>
                            
                            <div class="col-md-6">
                                {{ form_label(profileForm.nom, 'Nom', {'label_attr': {'class': 'form-label fw-bold small text-muted'}}) }}
                                {{ form_widget(profileForm.nom, {'attr': {'class': 'form-control shadow-none'}}) }}
                                <div class="text-danger small mt-1">{{ form_errors(profileForm.nom) }}</div>
                            </div>

                            <div class="col-12">
                                {{ form_label(profileForm.email, 'Adresse Email', {'label_attr': {'class': 'form-label fw-bold small text-muted'}}) }}
                                {{ form_widget(profileForm.email, {'attr': {'class': 'form-control shadow-none'}}) }}
                                <div class="text-danger small mt-1">{{ form_errors(profileForm.email) }}</div>
                            </div>

                            <div class="col-12 mt-4 text-end">
                                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Mettre à jour</button>
                            </div>

                        {{ form_end(profileForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
