{% extends 'frontoffice/base.html.twig' %}

{% block title %}Connexion - FinTrack{% endblock %}

{% block body %}
<section class="section pt-5 pb-5 bg-tertiary" style="min-height: 80vh; display: flex; align-items: center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <h2 class="h3 fw-bold">Connexion</h2>
                        <p class="text-muted">Accédez à votre compte FinTrack</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    {% if app.user %}
                        <div class="mb-3">
                            Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
                        </div>
                    {% else %}
                        <form method="post" action="{{ path('app_login') }}">
                            <div class="form-group mb-4">
                                <label for="inputEmail" class="form-label">Email</label>
                                <input type="email" value="{{ last_username|default('') }}" name="email" id="inputEmail" class="form-control form-control-lg shadow-none" autocomplete="email" required autofocus placeholder="votre@email.com">
                            </div>
                            
                            <div class="form-group mb-4">
                                <label for="inputPassword" class="form-label">Mot de passe</label>
                                <input type="password" name="password" id="inputPassword" class="form-control form-control-lg shadow-none" autocomplete="current-password" required placeholder="••••••••">
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <button class="btn btn-primary btn-lg w-100 mb-3" type="submit">
                                Se connecter
                            </button>
                            
                            <div class="text-center mt-3">
                                <p class="mb-0 text-muted">Pas encore de compte ? <a href="{{ path('app_register') }}" class="text-primary text-decoration-none fw-bold">S'inscrire</a></p>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
