<form method="post" action="{{ path('document_delete', {'id': document.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce document ?');" style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
    <button type="submit" class="btn btn-outline-danger btn-sm btn-action-icon" title="Supprimer">
        <i class="fas fa-trash-alt" aria-hidden="true"></i><span class="visually-hidden">Supprimer</span>
    </button>
</form>