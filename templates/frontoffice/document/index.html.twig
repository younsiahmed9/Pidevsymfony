{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Documents{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-5 bg-white p-4 rounded-4 shadow-sm">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1"><i class="fas fa-file-invoice text-primary me-2"></i>Mes Documents</h1>
                <p class="text-muted mb-0">Stockez, organisez et retrouvez tous vos documents importants en un clic.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('dossier_document_new') }}" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                    <i class="fas fa-folder-plus me-2"></i> Créer un dossier
                </a>
                <a href="{{ path('document_new') }}" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                    <i class="fas fa-upload me-2"></i> Importer un document
                </a>
            </div>
        </div>

        <!-- Filters -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <form method="GET" action="{{ path('document_index') }}" class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-uppercase text-muted">Recherche</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                            <input type="text" name="q" value="{{ q }}" class="form-control bg-light border-0 shadow-none" placeholder="Titre, tags, description...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Type de document</label>
                        <select name="type" class="form-select bg-light border-0 shadow-none">
                            <option value="">Tous les types</option>
                            {% for t in ['contrat', 'facture', 'releve', 'identite', 'assurance', 'fiscal', 'autre'] %}
                                <option value="{{ t }}" {{ type == t ? 'selected' : '' }}>{{ t|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">Filtrer</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-4">
            {% for document in documents %}
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 transition-hover overflow-hidden">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div class="p-3 rounded-4" style="background-color: {{ document.categorie.couleur|default('#4e73df') }}15;">
                                    <i class="fas fa-file-pdf fa-2x" style="color: {{ document.categorie.couleur|default('#4e73df') }};"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0 shadow-none" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3">
                                        <li><a class="dropdown-item py-2" href="{{ path('document_show', {id: document.id}) }}"><i class="fas fa-eye me-2 text-primary small"></i> Consulter</a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('document_edit', {id: document.id}) }}"><i class="fas fa-edit me-2 text-warning small"></i> Modifier</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="{{ path('document_delete', {'id': document.id}) }}" onsubmit="return confirm('Supprimer ce document ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                                                <button class="dropdown-item py-2 text-danger"><i class="fas fa-trash-alt me-2 small"></i> Supprimer</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-1">{{ document.titre }}</h5>
                            <div class="mb-3">
                                <span class="badge bg-light text-muted px-2 py-1 rounded small text-capitalize">{{ document.typeDocument }}</span>
                                {% if document.dossier %}
                                    <span class="text-muted small ms-2"><i class="fas fa-folder-open me-1"></i>{{ document.dossier.nomDossier }}</span>
                                {% endif %}
                            </div>

                            <div class="d-flex align-items-center mb-4">
                                <i class="fas fa-tag me-2" style="color: {{ document.categorie.couleur|default('#4e73df') }};"></i>
                                <span class="small text-dark fw-bold">{{ document.categorie.nomCategorie|default('Sans catégorie') }}</span>
                            </div>

                            <div class="small text-muted mb-3">
                                <i class="fas fa-user me-1"></i>
                                {{ document.utilisateur.fullName ?: document.utilisateur.email }}
                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                {% set status_color = document.statut == 'valide' ? 'success' : (document.statut == 'expire' ? 'danger' : 'warning') %}
                                <span class="badge bg-{{ status_color }} bg-opacity-10 text-{{ status_color }} rounded-pill px-3 py-2 small text-capitalize">
                                    {{ document.statut }}
                                </span>
                                <span class="text-muted small">
                                    <i class="far fa-calendar-alt me-1"></i> {{ document.dateDocument|date('d/m/Y') }}
                                </span>
                            </div>
                        </div>
                        <a href="{{ path('document_show', {id: document.id}) }}" class="stretched-link"></a>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <div class="bg-white p-5 rounded-4 shadow-sm d-inline-block border">
                        <i class="fas fa-file-upload fa-4x text-light mb-4 d-block"></i>
                        <h3 class="fw-bold text-dark">Aucun document</h3>
                        <p class="text-muted mb-4">Importez vos premiers documents pour commencer à les gérer.</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a href="{{ path('dossier_document_new') }}" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold">
                                Créer un dossier
                            </a>
                            <a href="{{ path('document_new') }}" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">
                                Importer mon premier document
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<style>
    .transition-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .transition-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.1) !important;
    }
</style>
{% endblock %}