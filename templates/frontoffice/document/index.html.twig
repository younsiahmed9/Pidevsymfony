{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes documents{% endblock %}

{% block stylesheets %}
    <style>
        /* Clair : texte lisible (noir / gris) sur la liste documents */
        html:not([data-theme='dark']) .document-list-page {
            color: #111827;
        }
        html:not([data-theme='dark']) .document-list-page .table:not(.table-dark),
        html:not([data-theme='dark']) .document-list-page .table tbody td,
        html:not([data-theme='dark']) .document-list-page .table thead th {
            color: #111827 !important;
        }
        html:not([data-theme='dark']) .document-list-page h1 {
            color: #0f172a !important;
        }
        html:not([data-theme='dark']) .document-list-page .text-muted,
        html:not([data-theme='dark']) .document-list-page small.text-muted {
            color: #4b5563 !important;
        }
        html:not([data-theme='dark']) .document-list-page .form-label {
            color: #374151 !important;
        }

        /* Sombre : le thème global s’applique ; on garde le contraste des liens primaires */
        html[data-theme='dark'] .document-list-page .table a.btn-outline-primary {
            color: #93c5fd !important;
            border-color: rgba(147, 197, 253, 0.55) !important;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4 document-list-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Mes documents</h1>
            <p class="text-muted mb-0">Gérez vos documents, signatures et échéances.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('document_export_pdf', { q: q, type: type }) }}" class="btn btn-outline-secondary">
                Export PDF
            </a>
            <a href="{{ path('document_new') }}" class="btn btn-primary">Nouveau document</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><small class="text-muted">Total</small><div class="h5 mb-0">{{ stats.total|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><small class="text-muted">Valides</small><div class="h5 mb-0">{{ stats.valide|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><small class="text-muted">Expirés</small><div class="h5 mb-0">{{ stats.expire|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><small class="text-muted">À renouveler</small><div class="h5 mb-0">{{ stats.a_renouveler|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><small class="text-muted">Archivés</small><div class="h5 mb-0">{{ stats.archive|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><small class="text-muted">Packs</small><div class="h5 mb-0">{{ packs|length }}</div></div></div></div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('document_index') }}" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Recherche</label>
                    <input type="text" name="q" value="{{ q }}" class="form-control" placeholder="Titre, description, tag...">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Type</label>
                    <input type="text" name="type" value="{{ type }}" class="form-control" placeholder="Contrat, Facture...">
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Type</th>
                        <th>Statut</th>
                        <th>Signature</th>
                        <th>Échéance</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for document in documents %}
                    <tr>
                        <td>
                            <div class="fw-semibold">{{ document.titre }}</div>
                            <small class="text-muted">{{ document.createdAt ? document.createdAt|date('d/m/Y') : '-' }}</small>
                        </td>
                        <td>{{ document.typeDocument ?: '-' }}</td>
                        <td>
                            <span class="badge text-bg-light border">{{ document.statut ?: 'N/A' }}</span>
                        </td>
                        <td>
                            {% set current_state = document.getSignatureState() %}
                            <span class="badge {% if current_state == 'signed' %}bg-success{% elseif current_state == 'pending_approval' %}bg-warning{% else %}bg-secondary{% endif %}">
                                {{ current_state|capitalize }}
                            </span>

                            <div class="mt-1 d-flex gap-1">
                                {% if workflow_can(document, 'submit') %}
                                    <form action="{{ path('document_apply_transition', {id: document.id, transition: 'submit'}) }}" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-primary" title="Soumettre pour signature"><i class="fas fa-paper-plane"></i></button>
                                    </form>
                                {% endif %}

                                {% if workflow_can(document, 'sign') %}
                                    <form action="{{ path('document_apply_transition', {id: document.id, transition: 'sign'}) }}" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-success" title="Signer le document"><i class="fas fa-pen-nib"></i> Signer</button>
                                    </form>
                                {% endif %}

                                {% if workflow_can(document, 'reject') %}
                                    <form action="{{ path('document_apply_transition', {id: document.id, transition: 'reject'}) }}" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-danger" title="Rejeter"><i class="fas fa-times"></i></button>
                                    </form>
                                {% endif %}

                                {% if workflow_can(document, 'archive') %}
                                    <form action="{{ path('document_apply_transition', {id: document.id, transition: 'archive'}) }}" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-outline-secondary" title="Archiver"><i class="fas fa-archive"></i></button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                        <td>{{ document.dateEcheance ? document.dateEcheance|date('d/m/Y') : '-' }}</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm btn-action-toolbar" role="group" aria-label="Actions document">
                                <a href="{{ path('document_show', {id: document.id}) }}" class="btn btn-outline-secondary btn-action-icon btn-sm" title="Voir le détail"><i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Voir</span></a>
                                <button type="button" class="btn btn-outline-success btn-action-icon btn-sm" title="Ajouter au pack" onclick="openPackModal('{{ document.id }}', '{{ document.titre|escape('js') }}')"><i class="fas fa-layer-group" aria-hidden="true"></i><span class="visually-hidden">Ajouter au pack</span></button>
                                <a href="{{ path('document_edit', {id: document.id}) }}" class="btn btn-outline-primary btn-action-icon btn-sm" title="Modifier"><i class="fas fa-pen" aria-hidden="true"></i><span class="visually-hidden">Modifier</span></a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Aucun document trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if expiringDocs is defined and expiringDocs|length > 0 %}
        <div class="card mt-4">
            <div class="card-header">Échéances proches (30 jours)</div>
            <ul class="list-group list-group-flush">
                {% for doc in expiringDocs %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>{{ doc.titre }}</span>
                        <span class="badge text-bg-warning">{{ doc.dateEcheance ? doc.dateEcheance|date('d/m/Y') : '-' }}</span>
                    </li>
                {% endfor %}

                <div class="modal fade" id="addToPackModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Ajouter au pack</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-3 text-muted small">Document sélectionné : <strong id="packDocumentTitle"></strong></p>
                                {% if packs is empty %}
                                    <div class="alert alert-info mb-0">
                                        Aucun pack n'existe encore. Créez d'abord un pack pour pouvoir y ajouter un document.
                                    </div>
                                {% else %}
                                    <label for="packSelector" class="form-label fw-semibold">Choisir un pack</label>
                                    <select id="packSelector" class="form-select mb-3">
                                        <option value="">-- Sélectionner un pack --</option>
                                        {% for pack in packs %}
                                            <option value="{{ pack.id }}">{{ pack.nomPack }}</option>
                                        {% endfor %}
                                    </select>
                                    <div class="d-grid">
                                        <button type="button" class="btn btn-success" onclick="confirmAddToPack()">Ajouter au pack</button>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </ul>
        </div>
    {% endif %}

            <script>
            let selectedDocumentId = null;
            let packModalInstance = null;

            function openPackModal(documentId, documentTitle) {
                selectedDocumentId = documentId;
                document.getElementById('packDocumentTitle').textContent = documentTitle || 'Document';
                if (!packModalInstance) {
                    packModalInstance = new bootstrap.Modal(document.getElementById('addToPackModal'));
                }
                packModalInstance.show();
            }

            async function confirmAddToPack() {
                const packId = document.getElementById('packSelector') ? document.getElementById('packSelector').value : '';

                if (!selectedDocumentId) {
                    alert('Aucun document sélectionné.');
                    return;
                }

                if (!packId) {
                    alert('Veuillez sélectionner un pack.');
                    return;
                }

                try {
                    const response = await fetch(`{{ path('pack_add_document', {id: 0}) }}`.replace('0', packId), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ documentId: selectedDocumentId })
                    });

                    const data = await response.json();

                    if (data.success) {
                        if (packModalInstance) {
                            packModalInstance.hide();
                        }
                        alert('Document ajouté au pack avec succès.');
                        return;
                    }

                    alert(data.message || 'Erreur lors de l\'ajout au pack.');
                } catch (error) {
                    alert('Erreur lors de l\'ajout au pack.');
                }
            }
            </script>
</div>
{% endblock %}
