{% extends 'frontoffice/base.html.twig' %}

{% block title %}{{ draft.titre }} - Brouillon{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3">{{ draft.titre }}</h1>
                <div class="btn-group">
                    <a href="{{ path('document_draft_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Détails du brouillon</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">Titre</dt>
                                <dd class="col-sm-8">{{ draft.titre }}</dd>

                                <dt class="col-sm-4">Type de document</dt>
                                <dd class="col-sm-8">{{ draft.typeDocument ?? 'Non défini' }}</dd>

                                {% if draft.description %}
                                    <dt class="col-sm-4">Description</dt>
                                    <dd class="col-sm-8">{{ draft.description }}</dd>
                                {% endif %}

                                <dt class="col-sm-4">Statut</dt>
                                <dd class="col-sm-8">
                                    {% if draft.isReady %}
                                        <span class="badge bg-success">Prêt à publier</span>
                                    {% else %}
                                        <span class="badge bg-secondary">En cours de rédaction</span>
                                    {% endif %}
                                </dd>

                                <dt class="col-sm-4">Créé le</dt>
                                <dd class="col-sm-8">{{ draft.createdAt|date('d/m/Y H:i') }}</dd>

                                <dt class="col-sm-4">Modifié le</dt>
                                <dd class="col-sm-8">{{ draft.updatedAt|date('d/m/Y H:i') }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Actions</h5>
                        </div>
                        <div class="card-body">
                            {% if draft.isReady %}
                                <form action="{{ path('document_draft_publish', {'id': draft.id}) }}" method="post" class="mb-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('publish' ~ draft.id) }}">
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="fas fa-paper-plane"></i> Publier le document
                                    </button>
                                </form>
                            {% endif %}

                            <a href="{{ path('document_draft_delete', {'id': draft.id}) }}" class="btn btn-outline-danger w-100"
                               onclick="event.preventDefault(); if(confirm('Supprimer ce brouillon ?')) document.getElementById('delete-form').submit();">
                                <i class="fas fa-trash"></i> Supprimer
                            </a>
                            <form id="delete-form" action="{{ path('document_draft_delete', {'id': draft.id}) }}" method="post" class="d-none">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ draft.id) }}">
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}