{% extends 'frontoffice/base.html.twig' %}

{% block title %}Brouillons - FinTrack{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3">Brouillons de documents</h1>
                <a href="{{ path('document_draft_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nouveau brouillon
                </a>
            </div>

            {% if drafts is empty %}
                <div class="alert alert-info">
                    Aucun brouillon pour le moment. <a href="{{ path('document_draft_new') }}">Créez-en un nouveau</a>.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Type</th>
                                <th>Statut</th>
                                <th>Modifié le</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for draft in drafts %}
                                <tr>
                                    <td>{{ draft.titre }}</td>
                                    <td>{{ draft.typeDocument ?? 'Non défini' }}</td>
                                    <td>
                                        {% if draft.isReady %}
                                            <span class="badge bg-success">Prêt à publier</span>
                                        {% else %}
                                            <span class="badge bg-secondary">En cours</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ draft.updatedAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        <a href="{{ path('document_draft_show', {'id': draft.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form action="{{ path('document_draft_delete', {'id': draft.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer ce brouillon ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ draft.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}