{% extends 'frontoffice/base.html.twig' %}

{% block title %}Détails du Document{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="mb-4 d-flex justify-content-between align-items-center">
            <a href="{{ path('document_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm bg-white">
                <i class="fas fa-arrow-left me-2"></i> Retour à mes documents
            </a>
            <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                <a href="{{ path('document_edit', {id: document.id}) }}" class="btn btn-warning btn-sm px-3 text-white fw-bold">
                    <i class="fas fa-edit me-2"></i> Modifier
                </a>
                <form method="post" action="{{ path('document_delete', {'id': document.id}) }}" onsubmit="return confirm('Supprimer ce document ?');" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                    <button class="btn btn-danger btn-sm px-3 fw-bold border-0 h-100">
                        <i class="fas fa-trash-alt me-2"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
                    <div class="card-header bg-primary py-4 text-center">
                        <div class="bg-white bg-opacity-25 d-inline-block p-4 rounded-circle mb-3 shadow-sm">
                            <i class="fas fa-file-pdf fa-3x text-white"></i>
                        </div>
                        <h2 class="h4 fw-bold text-white mb-0">{{ document.titre }}</h2>
                        <span class="badge rounded-pill bg-white bg-opacity-25 text-white px-3 py-2 mt-2">
                            ID: #{{ document.id }}
                        </span>
                    </div>
                    <div class="card-body p-4 bg-white">
                        <h6 class="text-uppercase text-muted small fw-bold mb-4 border-bottom pb-2">Propriétés du Document</h6>
                        
                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Type</span>
                            <span class="badge bg-light text-dark px-3 py-1 rounded-pill text-capitalize">{{ document.typeDocument }}</span>
                        </div>

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Catégorie</span>
                            <span class="fw-bold small" style="color: {{ document.categorie.couleur|default('#4e73df') }};">
                                <i class="fas fa-tag me-1"></i> {{ document.categorie.nomCategorie|default('Sans catégorie') }}
                            </span>
                        </div>

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Dossier</span>
                            <span class="text-dark small fw-bold">{{ document.dossier.nomDossier|default('Hors dossier') }}</span>
                        </div>

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Propriétaire</span>
                            <span class="text-dark small fw-bold">{{ document.utilisateur.fullName ?: document.utilisateur.email }}</span>
                        </div>

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Statut</span>
                            {% set status_color = document.statut == 'valide' ? 'success' : (document.statut == 'expire' ? 'danger' : 'warning') %}
                            <span class="badge bg-{{ status_color }} bg-opacity-10 text-{{ status_color }} px-3 py-1 rounded-pill text-capitalize small">
                                {{ document.statut }}
                            </span>
                        </div>

                        <hr class="my-4">

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Date Document</span>
                            <span class="text-dark small fw-bold">{{ document.dateDocument|date('d/m/Y') }}</span>
                        </div>

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Date Échéance</span>
                            <span class="text-{{ document.dateEcheance < date() ? 'danger' : 'dark' }} small fw-bold">
                                {{ document.dateEcheance ? document.dateEcheance|date('d/m/Y') : 'Aucune' }}
                            </span>
                        </div>

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Taille du fichier</span>
                            <span class="text-dark small fw-bold">{{ (document.tailleFichier / 1024)|number_format(2) }} KB</span>
                        </div>

                        {% if document.tags %}
                            <div class="mt-4">
                                <label class="text-muted small d-block mb-2">Tags</label>
                                <div>
                                    {% for tag in document.tags|split(',') %}
                                        <span class="badge bg-light text-secondary border px-2 py-1 rounded me-1 mb-1">{{ tag|trim }}</span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        <div class="mt-4 pt-3 border-top">
                            <a href="{{ asset('uploads/documents/' ~ document.cheminFichier) }}" class="btn btn-primary w-100 rounded-pill fw-bold" download>
                                <i class="fas fa-download me-2"></i> Télécharger le document
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark overflow-hidden">
                    <div class="card-header bg-dark border-bottom border-secondary py-3 d-flex justify-content-between align-items-center">
                        <h5 class="text-white mb-0 small fw-bold text-uppercase"><i class="fas fa-eye me-2"></i>Aperçu</h5>
                        <a href="{{ asset('uploads/documents/' ~ document.cheminFichier) }}" target="_blank" class="btn btn-outline-light btn-sm rounded-pill px-3">
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                    </div>
                    <div class="card-body p-0 d-flex align-items-center justify-content-center bg-secondary bg-opacity-10" style="min-height: 500px;">
                        {% if document.cheminFichier matches '/\.(pdf)$/i' %}
                            <embed src="{{ asset('uploads/documents/' ~ document.cheminFichier) }}" type="application/pdf" width="100%" height="600px" />
                        {% elseif document.cheminFichier matches '/\.(jpg|jpeg|png|gif|webp)$/i' %}
                            <img src="{{ asset('uploads/documents/' ~ document.cheminFichier) }}" class="img-fluid shadow" style="max-height: 550px;" alt="{{ document.titre }}">
                        {% else %}
                            <div class="text-center text-white-50">
                                <i class="fas fa-file-alt fa-5x mb-4 opacity-25"></i>
                                <p>Aperçu non disponible pour ce type de fichier.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}