{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Transactions - FinTrack{% endblock %}

{% block body %}
<section class="section py-5 bg-tertiary">
    <div class="container mt-4">
        <div class="row mb-4 align-items-center">
            <div class="col-md-6">
                <h2 class="h3 fw-bold mb-0">Historique des Transactions</h2>
                <p class="text-muted">Consultez tous vos mouvements financiers.</p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0 d-flex justify-content-end gap-2 flex-wrap">
                <a href="{{ path('front_transfer_select_card') }}" class="btn btn-primary">
                    <i class="fas fa-exchange-alt me-2"></i>Transfert
                </a>
                <a href="{{ path('front_virement_new') }}" class="btn btn-outline-primary">
                    <i class="fas fa-calendar me-2"></i>Transfert Programmé
                </a>
                <a href="{{ path('front_virement_new') }}" class="btn btn-outline-info">
                    <i class="fas fa-robot me-2"></i>Programmer avec n8n
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h6 class="mb-0 text-muted">Recherche, tri et export</h6>
                    <div class="d-flex gap-2">
                        <a href="{{ path('front_transaction_export_excel', app.request.query.all) }}" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-file-csv me-1"></i>Excel
                        </a>
                        <a href="{{ path('front_transaction_export_pdf', app.request.query.all) }}" class="btn btn-primary btn-sm">
                            <i class="fas fa-file-pdf me-1"></i>PDF
                        </a>
                    </div>
                </div>

                <form method="get" class="row g-3 align-items-end" id="transactionFilterForm">
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-bold">Recherche dynamique</label>
                        <input
                            type="search"
                            name="q"
                            class="form-control shadow-none"
                            placeholder="Description, type, statut, carte..."
                            value="{{ filters.q|default('') }}"
                            id="transactionSearchInput"
                        >
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Type</label>
                        <select name="type" class="form-select shadow-none">
                            <option value="">Tous les types</option>
                            <option value="TRANSFERT" {% if filters.type|default('') == 'TRANSFERT' %}selected{% endif %}>Transfert</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small fw-bold">Tri par</label>
                        <select name="sort" class="form-select shadow-none">
                            <option value="date" {% if filters.sort|default('date') == 'date' %}selected{% endif %}>Date</option>
                            <option value="montant" {% if filters.sort|default('date') == 'montant' %}selected{% endif %}>Montant</option>
                            <option value="type" {% if filters.sort|default('date') == 'type' %}selected{% endif %}>Type</option>
                            <option value="statut" {% if filters.sort|default('date') == 'statut' %}selected{% endif %}>Statut</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted small fw-bold">Ordre</label>
                        <select name="direction" class="form-select shadow-none">
                            <option value="desc" {% if filters.direction|default('desc') == 'desc' %}selected{% endif %}>Descendant</option>
                            <option value="asc" {% if filters.direction|default('desc') == 'asc' %}selected{% endif %}>Ascendant</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Date de début</label>
                        <input type="date" name="date_start" class="form-control shadow-none" value="{{ filters.date_start|default('') }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold">Date de fin</label>
                        <input type="date" name="date_end" class="form-control shadow-none" value="{{ filters.date_end|default('') }}">
                    </div>
                    <div class="col-md-3 d-grid">
                        <button type="submit" class="btn btn-outline-primary"><i class="fas fa-filter me-2"></i>Filtrer</button>
                    </div>
                    <div class="col-md-3 d-grid">
                        <a href="{{ path('front_transaction_index') }}" class="btn btn-light border">Réinitialiser</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                {% if transactions is empty %}
                    <div class="text-center p-5">
                        <div class="mb-3">
                            <i class="fas fa-history fa-3x text-muted opacity-50"></i>
                        </div>
                        <h5>Aucune transaction trouvée</h5>
                        <p class="text-muted">Nous n'avons trouvé aucun mouvement correspondant.</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Description</th>
                                    <th>Type</th>
                                    <th>Statut</th>
                                    <th class="text-end pe-4">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for trx in transactions %}
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">{{ trx.date|date('Y-m-d') }}</div>
                                            <small class="text-muted">{{ trx.date|date('H:i') }}</small>
                                        </td>
                                        <td>
                                            {{ trx.description }}
                                            {% if trx.source_numero %}
                                                <div class="small text-muted"><i class="fas fa-credit-card me-1"></i> Source ...{{ trx.source_numero|slice(-4) }}</div>
                                            {% endif %}
                                            {% if trx.dest_numero %}
                                                <div class="small text-muted"><i class="fas fa-credit-card me-1"></i> Destination ...{{ trx.dest_numero|slice(-4) }}</div>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary">Transfert</span>
                                        </td>
                                        <td>
                                            <span class="badge {{ trx.statut in ['SUCCESS', 'COMPLETED', 'TERMINE'] ? 'bg-success' : (trx.statut in ['PENDING', 'EN_ATTENTE'] ? 'bg-warning' : 'bg-danger') }}">
                                                {{ trx.statut }}
                                            </span>
                                        </td>
                                        <td class="text-end pe-4 fw-bold">
                                            {{ trx.montant|number_format(2, ',', ' ') }} {{ trx.devise }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
            {% if transactions is not empty and transactions.pageCount is defined %}
                <div class="card-footer bg-white py-3">
                    <div class="d-flex justify-content-center">
                        {{ knp_pagination_render(transactions) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}

{% block styles %}
<style>
    .card {
        border: 1px solid #6c757d !important;
    }
    .card .text-muted {
        color: #495057 !important;
        font-weight: 500;
    }
    .card .fw-bold {
        color: #212529 !important;
    }
    .table-light {
        background-color: #e9ecef !important;
    }
    .table-light th {
        color: #212529 !important;
        font-weight: 600;
        border-color: #6c757d !important;
    }
    .text-muted {
        color: #495057 !important;
    }
    .form-control, .form-select {
        border-color: #6c757d !important;
        color: #212529 !important;
    }
    .form-control:focus, .form-select:focus {
        border-color: #495057 !important;
        box-shadow: 0 0 0 0.2rem rgba(108, 117, 125, 0.25) !important;
    }
</style>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const form = document.getElementById('transactionFilterForm');
            const searchInput = document.getElementById('transactionSearchInput');

            if (!form || !searchInput) {
                return;
            }

            let debounceTimer;

            searchInput.addEventListener('input', function () {
                window.clearTimeout(debounceTimer);
                debounceTimer = window.setTimeout(function () {
                    form.submit();
                }, 350);
            });

            form.querySelectorAll('select').forEach(function (select) {
                select.addEventListener('change', function () {
                    form.submit();
                });
            });
        })();
    </script>
{% endblock %}
