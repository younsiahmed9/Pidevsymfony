{% extends 'user/base.html.twig' %}
{% block title %}Mes Dossiers - FinTrack{% endblock %}
{% block page_title %}Mes Dossiers{% endblock %}
{% block page_subtitle %}{{ dossiers|length }} dossier(s){% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-2" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:0.5rem 1rem;width:300px;">
        <i class="fas fa-search text-muted"></i>
        <input type="text" id="si" placeholder="Rechercher..." class="form-control border-0 p-0 shadow-none">
    </div>
    <a href="{{ path('user_dossier_new') }}" class="btn-primary-custom"><i class="fas fa-plus"></i> Nouveau dossier</a>
</div>
<div class="row g-3" id="grid">
    {% for dossier in dossiers %}
    <div class="col-md-4 dossier-item">
        <div class="form-card h-100">
            <div class="d-flex align-items-start justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-folder fa-2x" style="color:#f97316;"></i>
                    <div>
                        <div class="fw-semibold">{{ dossier.nomDossier }}</div>
                        <div class="small text-muted">{{ dossier.documents|length }} document(s)</div>
                    </div>
                </div>
                <div class="action-btns d-flex gap-1">
                    <a href="{{ path('user_dossier_show', {id: dossier.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                    <a href="{{ path('user_dossier_edit', {id: dossier.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                    <form action="{{ path('user_dossier_delete', {id: dossier.id}) }}" method="post" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dossier.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            {% if dossier.description %}
            <p class="text-muted small mb-0">{{ dossier.description|slice(0,80) }}{% if dossier.description|length > 80 %}...{% endif %}</p>
            {% endif %}
            <div class="mt-2 small text-muted">{{ dossier.createdAt|date('d/m/Y') }}</div>
        </div>
    </div>
    {% else %}
    <div class="col-12 text-center py-5 text-muted"><i class="fas fa-folder fa-3x mb-3 d-block opacity-25"></i>Aucun dossier créé</div>
    {% endfor %}
</div>
{% endblock %}
{% block javascripts %}
<script>document.getElementById('si').addEventListener('keyup', function() { var f = this.value.toLowerCase(); document.querySelectorAll('.dossier-item').forEach(c => c.style.display = c.textContent.toLowerCase().includes(f) ? '' : 'none'); });</script>
{% endblock %}
