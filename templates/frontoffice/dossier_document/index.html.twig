{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Dossiers de Documents{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-5 bg-white p-4 rounded-4 shadow-sm">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1"><i class="fas fa-folder-open text-primary me-2"></i>Mes Dossiers de Documents</h1>
                <p class="text-muted mb-0">Organisez vos documents par dossiers.</p>
            </div>
            <a href="{{ path('dossier_document_new') }}" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                <i class="fas fa-plus me-2"></i> Nouveau Dossier
            </a>
        </div>

        <div class="row g-4">
            {% for dossier in dossiers %}
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-primary bg-opacity-10 p-3 rounded-4">
                                    <i class="fas fa-folder fa-2x text-primary"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3">
                                        <li><a class="dropdown-item py-2" href="{{ path('dossier_document_show', {id: dossier.id}) }}" title="Détails"><i class="fas fa-fw fa-eye text-primary"></i><span class="visually-hidden">Détails</span></a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('dossier_document_edit', {id: dossier.id}) }}" title="Modifier"><i class="fas fa-fw fa-pen text-warning"></i><span class="visually-hidden">Modifier</span></a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>{% include 'frontoffice/dossier_document/_delete_form.html.twig' with {action: path('dossier_document_delete', {id: dossier.id}), dossier: dossier, is_dropdown: true} %}</li>
                                    </ul>
                                </div>
                            </div>
                            <h5 class="card-title fw-bold text-dark mb-1">{{ dossier.nomDossier }}</h5>
                            <p class="text-muted small mb-3">{{ dossier.description ?: 'Aucune description' }}</p>
                            <div class="d-flex justify-content-between pt-3 border-top">
                                <span class="small text-muted"><i class="far fa-calendar-alt me-1"></i> {{ dossier.createdAt ? dossier.createdAt|date('d/m/Y') : '-' }}</span>
                                <span class="small text-muted">{{ dossier.documents|length }} document(s)</span>
                            </div>
                        </div>
                        <a href="{{ path('dossier_document_show', {id: dossier.id}) }}" class="stretched-link"></a>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <div class="bg-white p-5 rounded-4 shadow-sm d-inline-block border">
                        <i class="fas fa-folder-open fa-4x text-light mb-4 d-block"></i>
                        <h3 class="fw-bold text-dark">Aucun dossier</h3>
                        <p class="text-muted mb-4">Créez votre premier dossier pour mieux classer vos documents.</p>
                        <a href="{{ path('dossier_document_new') }}" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">Créer mon premier dossier</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}