{% extends 'frontoffice/base.html.twig' %}

{% block title %}Nouveau Dossier - FinTrack{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h1 class="h5 mb-0">Nouveau dossier</h1>
                <a href="{{ path('dossier_document_index') }}" class="btn btn-outline-secondary btn-sm">Retour</a>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    {% include 'frontoffice/dossier_document/_form.html.twig' %}
                    <div class="mt-4 d-flex gap-2">
                        <button class="btn btn-primary">Créer</button>
                        <a href="{{ path('dossier_document_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}