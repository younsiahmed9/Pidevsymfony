{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Portefeuilles - FinTrack{% endblock %}

{% block body %}
<section class="section py-5 bg-tertiary">
    <div class="container mt-4">
        <div class="row mb-4 align-items-center">
            <div class="col-md-6">
                <h2 class="h3 fw-bold mb-0">Mes Portefeuilles</h2>
                <p class="text-muted">Gérez vos différents comptes et soldes</p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <a href="{{ path('front_portefeuille_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Créer un portefeuille
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        {% if portefeuilles is empty %}
                            <div class="text-center p-5">
                                <div class="mb-3">
                                    <i class="fas fa-wallet fa-3x text-muted opacity-50"></i>
                                </div>
                                <h5>Aucun portefeuille trouvé</h5>
                                <p class="text-muted">Commencez par créer votre premier portefeuille.</p>
                                <a href="{{ path('front_portefeuille_new') }}" class="btn btn-outline-primary mt-2">Créer maintenant</a>
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Nom du Portefeuille</th>
                                            <th>Devise Principale</th>
                                            <th class="text-end">Solde Total</th>
                                            <th class="text-end pe-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for portefeuille in portefeuilles %}
                                            <tr>
                                                <td class="ps-4 fw-bold text-dark">
                                                    <i class="fas fa-wallet text-primary me-2"></i> {{ portefeuille.nom }}
                                                </td>
                                                <td><span class="badge bg-secondary">{{ portefeuille.devise_principale }}</span></td>
                                                <td class="text-end fw-bold">
                                                    {{ portefeuille.solde_total|number_format(2, ',', ' ') }} {{ portefeuille.devise_principale }}
                                                </td>
                                                <td class="text-end pe-4">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-action-icon btn-sm me-1"
                                                            onclick="showQrCode('{{ path('front_qrcode_wallet', {id: portefeuille.id}) }}', '{{ portefeuille.nom }}')"
                                                            title="Afficher QR Code">
                                                        <i class="fas fa-qrcode" aria-hidden="true"></i><span class="visually-hidden">QR Code</span>
                                                    </button>
                                                    <a href="{{ path('front_portefeuille_show', {'id': portefeuille.id}) }}" class="btn btn-sm btn-outline-info btn-action-icon btn-sm me-1" title="Voir les détails">
                                                        <i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Voir</span>
                                                    </a>
                                                    <a href="{{ path('front_portefeuille_edit', {'id': portefeuille.id}) }}" class="btn btn-sm btn-outline-primary btn-action-icon btn-sm me-1" title="Modifier">
                                                        <i class="fas fa-pen" aria-hidden="true"></i><span class="visually-hidden">Modifier</span>
                                                    </a>
                                                    <a href="{{ path('front_carte_new', {'portefeuille_id': portefeuille.id}) }}" class="btn btn-sm btn-outline-primary btn-action-icon btn-sm me-1" title="Créer une carte">
                                                        <i class="fas fa-credit-card" aria-hidden="true"></i><span class="visually-hidden">Créer une carte</span>
                                                    </a>
                                                    
                                                    {% include 'frontoffice/portefeuille/_delete_form.html.twig' with { portefeuille: portefeuille } %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                    {% if portefeuilles is not empty and portefeuilles.pageCount is defined %}
                        <div class="card-footer bg-white py-3">
                            <div class="d-flex justify-content-center">
                                {{ knp_pagination_render(portefeuilles) }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal QR Code -->
<div class="modal fade" id="qrCodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title small fw-bold" id="qrCodeTitle">QR Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-2">
                <div id="qrCodeContainer" class="mb-3">
                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                </div>
                <p class="text-muted small mb-0">Scannez pour partager ou payer</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function showQrCode(url, title) {
            const modal = new bootstrap.Modal(document.getElementById('qrCodeModal'));
            const container = document.getElementById('qrCodeContainer');
            const titleEl = document.getElementById('qrCodeTitle');
            
            titleEl.textContent = 'QR Code - ' + title;
            container.innerHTML = '<div class="spinner-border text-primary spinner-border-sm" role="status"></div>';
            
            modal.show();
            
            const img = new Image();
            img.src = url;
            img.className = 'img-fluid rounded shadow-sm';
            img.onload = function() {
                container.innerHTML = '';
                container.appendChild(img);
            };
        }
    </script>
{% endblock %}
