{% extends 'frontoffice/base.html.twig' %}

{% block title %}Détails Portefeuille - FinTrack{% endblock %}

{% block body %}
<section class="section py-5 bg-tertiary">
    <div class="container mt-4">
        <!-- En-tête -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-8">
                <a href="{{ path('front_portefeuille_index') }}" class="text-muted text-decoration-none d-inline-block mb-2">
                    <i class="fas fa-arrow-left me-1"></i> Retour aux portefeuilles
                </a>
                <h2 class="h3 fw-bold mb-0">{{ portefeuille.nom }}</h2>
                <p class="text-muted">Portefeuille en {{ portefeuille.devise_principale }}</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="p-3 bg-white rounded shadow-sm d-inline-block text-end">
                    <p class="text-muted small mb-0">Solde Total</p>
                    <h3 class="mb-0 fw-bold text-primary">{{ portefeuille.solde_total|number_format(2, ',', ' ') }} <span class="fs-6 text-muted">{{ portefeuille.devise_principale }}</span></h3>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Cartes associées -->
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-credit-card me-2 text-primary"></i>Cartes associées</h5>
                        <a href="{{ path('front_carte_new', {'portefeuille_id': portefeuille.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-plus"></i></a>
                    </div>
                    <div class="card-body px-4">
                        {% if cartes is empty %}
                            <p class="text-muted text-center py-3">Aucune carte associée à ce portefeuille.</p>
                        {% else %}
                            <div class="list-group list-group-flush">
                                {% for carte in cartes %}
                                    <a href="{{ path('front_carte_show', {'id': carte.id}) }}" class="list-group-item list-group-item-action px-0 border-bottom py-3">
                                        <div class="d-flex w-100 justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1 text-dark fw-bold">Carte {{ carte.type }}</h6>
                                                <small class="text-muted">**** **** **** {{ carte.numero_carte|slice(-4) }}</small>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge {{ carte.is_active ? 'bg-success' : 'bg-danger' }} mb-1">{{ carte.is_active ? 'Active' : 'Inactive' }}</span>
                                                <div class="fw-bold small">{{ carte.solde|number_format(2, ',', ' ') }} {{ carte.devise }}</div>
                                            </div>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Historique des transactions -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-history me-2 text-primary"></i>Historique du portefeuille</h5>
                        <a href="{{ path('front_transaction_new') }}" class="btn btn-sm btn-primary">Faire une transaction</a>
                    </div>
                    <div class="card-body p-0">
                        {% if transactions is empty %}
                            <p class="text-muted text-center py-5">Aucune transaction pour ce portefeuille.</p>
                        {% else %}
                            <div class="table-responsive px-4 pb-3">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Carte</th>
                                            <th>Statut</th>
                                            <th class="text-end">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for trx in transactions %}
                                            <tr>
                                                <td><small class="text-muted">{{ trx.date|date('d/m/Y H:i') }}</small></td>
                                                <td>
                                                    {% if trx.type == 'DEPOT' %}
                                                        <span class="badge bg-success-subtle text-success">Dépôt</span>
                                                    {% elseif trx.type == 'RETRAIT' %}
                                                        <span class="badge bg-danger-subtle text-danger">Retrait</span>
                                                    {% else %}
                                                        <span class="badge bg-primary-subtle text-primary">Transfert</span>
                                                    {% endif %}
                                                    <div class="small text-muted mt-1">{{ trx.description }}</div>
                                                </td>
                                                <td>
                                                    {% if trx.source_numero %}
                                                        <small><i class="fas fa-credit-card me-1"></i>...{{ trx.source_numero|slice(-4) }}</small>
                                                    {% elseif trx.dest_numero %}
                                                        <small><i class="fas fa-credit-card me-1"></i>...{{ trx.dest_numero|slice(-4) }}</small>
                                                    {% else %}
                                                        -
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <span class="badge {{ trx.statut in ['COMPLETED', 'TERMINE'] ? 'bg-success' : (trx.statut in ['PENDING', 'EN_ATTENTE'] ? 'bg-warning' : 'bg-danger') }}">
                                                        {{ trx.statut }}
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold {{ trx.type == 'DEPOT' ? 'text-success' : (trx.type == 'RETRAIT' ? 'text-danger' : '') }}">
                                                    {{ trx.type == 'RETRAIT' ? '-' : (trx.type == 'DEPOT' ? '+' : '') }}{{ trx.montant|number_format(2, ',', ' ') }} {{ trx.devise }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {% if transactions.pageCount is defined %}
                                <div class="px-4 pb-3">
                                    {{ knp_pagination_render(transactions) }}
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
