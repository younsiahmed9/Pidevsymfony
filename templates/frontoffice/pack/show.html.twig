{% extends 'frontoffice/base.html.twig' %}

{% block title %}Pack : {{ pack.nomPack }}{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="mb-4">
            <a href="{{ path('pack_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm bg-white">
                <i class="fas fa-arrow-left me-2"></i> Retour aux packs
            </a>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
                    <div class="card-header bg-primary py-4 px-4 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h4 fw-bold text-white mb-1">{{ pack.nomPack }}</h2>
                            <p class="text-white text-opacity-75 mb-0 small">Créé le {{ pack.createdAt|date('d/m/Y') }}</p>
                        </div>
                        <div class="p-3 bg-white bg-opacity-20 rounded-circle text-white">
                            <i class="fas fa-layer-group fa-2x"></i>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <h6 class="text-uppercase text-muted small fw-bold mb-3 ls-wide">Description</h6>
                        <p class="text-secondary mb-4">{{ pack.description ?: "Aucune description fournie." }}</p>
                        
                        <div class="d-flex justify-content-between align-items-center mb-4 pt-4 border-top">
                            <h5 class="fw-bold mb-0">Documents du Pack ({{ pack.documents|length }})</h5>
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#addDocumentModal">
                                <i class="fas fa-plus me-1"></i> Ajouter un document
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border-0">
                                <thead class="table-light">
                                    <tr class="small text-muted text-uppercase fw-bold border-0">
                                        <th class="border-0">Document</th>
                                        <th class="border-0 text-center">Type</th>
                                        <th class="border-0 text-center">Taille</th>
                                        <th class="border-0 text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for doc in pack.documents %}
                                        <tr class="border-bottom">
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="p-2 bg-light rounded me-3">
                                                        <i class="fas fa-file-pdf text-danger"></i>
                                                    </div>
                                                    <div>
                                                        <a href="{{ path('document_show', {id: doc.id}) }}" class="text-dark fw-bold text-decoration-none">
                                                            {{ doc.titre }}
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center text-muted small text-capitalize">{{ doc.typeDocument }}</td>
                                            <td class="text-center text-muted small">{{ (doc.tailleFichier / 1024)|number_format(1) }} KB</td>
                                            <td class="text-end">
                                                <button class="btn btn-outline-danger btn-sm rounded-circle shadow-none" onclick="removeDocument('{{ doc.id }}')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                Aucun document dans ce pack pour le moment.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden border-top border-success border-4">
                    <div class="card-body p-4 text-center">
                        <div class="bg-success bg-opacity-10 p-4 rounded-circle d-inline-block mb-3 text-success">
                            <i class="fas fa-share-alt fa-2x"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Lien de Partage</h5>
                        <p class="text-muted small">Ce lien permet à n'importe qui de consulter les documents de ce pack sans compte.</p>
                        
                        <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden border">
                            <input type="text" id="shareLink" class="form-control border-0 bg-light small px-3" value="{{ url('app_public_pack_share', {token: pack.tokenPartage}) }}" readonly>
                            <button class="btn btn-success" type="button" onclick="copyLink()">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                        
                        <a href="{{ url('app_public_pack_share', {token: pack.tokenPartage}) }}" target="_blank" class="btn btn-outline-success btn-sm w-100 rounded-pill fw-bold">
                            <i class="fas fa-external-link-alt me-2"></i> Tester l'aperçu public
                        </a>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                    <h6 class="fw-bold text-dark mb-3">Statistiques</h6>
                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Documents</span>
                        <span class="fw-bold text-dark">{{ pack.documents|length }}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Mise à jour</span>
                        <span class="fw-bold text-dark">{{ pack.updatedAt|date('d/m/Y') }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Ajout Document -->
<div class="modal fade" id="addDocumentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Ajouter un document au pack</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {% if availableDocuments is empty %}
                    <div class="alert alert-info mb-0">
                        Aucun document disponible à ajouter. Vos documents sont peut-être déjà tous dans ce pack.
                    </div>
                {% else %}
                    <label for="documentSelector" class="form-label fw-bold small text-muted">Choisir un document</label>
                    <select id="documentSelector" class="form-select rounded-3 mb-3">
                        <option value="">-- Sélectionner un document --</option>
                        {% for document in availableDocuments %}
                            <option value="{{ document.id }}">
                                {{ document.titre }}{% if document.typeDocument %} ({{ document.typeDocument }}){% endif %}
                            </option>
                        {% endfor %}
                    </select>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary rounded-pill fw-bold" onclick="addSelectedDocument()">
                            <i class="fas fa-plus me-2"></i> Ajouter le document
                        </button>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
function copyLink() {
    const link = document.getElementById('shareLink');
    link.select();
    document.execCommand('copy');
    alert('✓ Lien copié !');
}

async function removeDocument(docId) {
    if(!confirm('Retirer ce document du pack ?')) return;

    try {
        const response = await fetch(`{{ path('pack_remove_document', {id: pack.id, documentId: 0}) }}`.replace('0', docId), {
            method: 'POST'
        });
        const data = await response.json();
        if (data.success) {
            window.location.reload();
        }
    } catch (error) {
        alert('Erreur lors du retrait.');
    }
}

async function addSelectedDocument() {
    const selector = document.getElementById('documentSelector');
    const documentId = selector ? selector.value : '';

    if (!documentId) {
        alert('Veuillez sélectionner un document.');
        return;
    }

    try {
        const response = await fetch(`{{ path('pack_add_document', {id: pack.id}) }}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ documentId: documentId })
        });

        const data = await response.json();

        if (data.success) {
            window.location.reload();
            return;
        }

        alert(data.message || 'Erreur lors de l\'ajout du document.');
    } catch (error) {
        alert('Erreur lors de l\'ajout du document.');
    }
}
</script>
{% endblock %}
