{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes échéances{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Mes échéances</h1>
            <p class="text-muted mb-0">Suivez les rappels de paiement et de renouvellement.</p>
        </div>
        <a href="{{ path('echeance_new') }}" class="btn btn-primary">Nouvelle échéance</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small class="text-muted">Total</small><div class="h5 mb-0">{{ stats.total|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small class="text-muted">En attente</small><div class="h5 mb-0">{{ stats.pending|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small class="text-muted">En retard</small><div class="h5 mb-0">{{ stats.overdue|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><small class="text-muted">Complétées</small><div class="h5 mb-0">{{ stats.completed|default(0) }}</div></div></div></div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('echeance_index') }}" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Recherche</label>
                    <input type="text" name="q" value="{{ q }}" class="form-control" placeholder="Titre, document...">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Statut</label>
                    <select name="statut" class="form-select">
                        <option value="">Tous</option>
                        {% for s in ['pending', 'notified', 'completed', 'overdue'] %}
                            <option value="{{ s }}" {{ statut == s ? 'selected' : '' }}>{{ s|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Document</th>
                        <th>Montant</th>
                        <th>Échéance</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for echeance in echeances %}
                    <tr>
                        <td>{{ echeance.titre }}</td>
                        <td>{{ echeance.document ? echeance.document.titre : '-' }}</td>
                        <td>{{ echeance.montant is not null ? echeance.montant|number_format(2, ',', ' ') ~ ' TND' : '-' }}</td>
                        <td>{{ echeance.dateEcheance ? echeance.dateEcheance|date('d/m/Y') : '-' }}</td>
                        <td><span class="badge text-bg-light border text-capitalize">{{ echeance.statut }}</span></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm btn-action-toolbar" role="group" aria-label="Actions échéance">
                                <a href="{{ path('echeance_show', {id: echeance.id}) }}" class="btn btn-outline-secondary btn-action-icon btn-sm" title="Voir"><i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Voir</span></a>
                                <a href="{{ path('echeance_edit', {id: echeance.id}) }}" class="btn btn-outline-primary btn-action-icon btn-sm" title="Modifier"><i class="fas fa-pen" aria-hidden="true"></i><span class="visually-hidden">Modifier</span></a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Aucune échéance trouvée.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
