{% extends 'frontoffice/base.html.twig' %}

{% block title %}Échéance: {{ echeance.titre }} - FinTrack{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex gap-2 mb-4">
            <a href="{{ path('echeance_index') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Retour</a>
            <a href="{{ path('echeance_edit', {id: echeance.id}) }}" class="btn btn-primary btn-action-icon" title="Modifier"><i class="fas fa-pen" aria-hidden="true"></i><span class="visually-hidden">Modifier</span></a>
            {% include 'frontoffice/echeance/_delete_form.html.twig' with {action: path('echeance_delete', {id: echeance.id}), echeance: echeance} %}
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6"><label class="text-muted small">Titre</label><div class="fw-semibold">{{ echeance.titre }}</div></div>
                    <div class="col-md-6"><label class="text-muted small">Statut</label><div><span class="badge bg-primary text-uppercase">{{ echeance.statut }}</span></div></div>
                    <div class="col-md-6"><label class="text-muted small">Document</label><div class="fw-semibold">{{ echeance.document ? echeance.document.titre : '-' }}</div></div>
                    <div class="col-md-6"><label class="text-muted small">Date d'échéance</label><div class="fw-bold fs-5 text-primary">{{ echeance.dateEcheance ? echeance.dateEcheance|date('d/m/Y') : '-' }}</div></div>
                    <div class="col-md-6"><label class="text-muted small">Date de rappel</label><div class="fw-semibold">{{ echeance.dateRappel ? echeance.dateRappel|date('d/m/Y') : '-' }}</div></div>
                    <div class="col-md-6"><label class="text-muted small">Montant</label><div class="fw-semibold">{{ echeance.montant ? echeance.montant|number_format(2, ',', ' ') ~ ' TND' : '-' }}</div></div>
                    {% if echeance.description %}<div class="col-12"><label class="text-muted small">Description</label><div>{{ echeance.description }}</div></div>{% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
