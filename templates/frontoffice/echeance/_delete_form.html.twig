<form method="post" action="{{ action }}" onsubmit="return confirm('Supprimer cette échéance ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ echeance.id) }}">
    <button type="submit" class="btn btn-outline-danger btn-sm btn-action-icon btn-sm" title="Supprimer"><i class="fas fa-trash-alt" aria-hidden="true"></i><span class="visually-hidden">Supprimer</span></button>
</form>