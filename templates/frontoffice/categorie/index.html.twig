{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Catégories{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">Mes Catégories</h1>
                <p class="text-muted mb-0">Organisez vos documents par thématiques personnalisées.</p>
            </div>
            <a href="{{ path('categorie_new') }}" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                <i class="fas fa-plus me-2"></i> Nouvelle Catégorie
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 border-0 shadow-sm" role="alert">
                <i class="fas fa-check-circle me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="row g-4">
            {% for categorie in categories %}
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div class="p-3 rounded-4" style="background-color: {{ categorie.couleur|default('#4e73df') }}15;">
                                    <i class="fas {{ categorie.icon|default('fa-folder') }} fa-2x" style="color: {{ categorie.couleur|default('#4e73df') }};"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm rounded-3">
                                        <li><a class="dropdown-item py-2" href="{{ path('categorie_show', {id: categorie.id}) }}" title="Voir détails"><i class="fas fa-fw fa-eye text-primary"></i><span class="visually-hidden">Voir détails</span></a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('categorie_edit', {id: categorie.id}) }}" title="Modifier"><i class="fas fa-fw fa-pen text-warning"></i><span class="visually-hidden">Modifier</span></a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="{{ path('categorie_delete', {'id': categorie.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                                                <button type="submit" class="dropdown-item py-2 text-danger" title="Supprimer"><i class="fas fa-trash-alt" aria-hidden="true"></i><span class="visually-hidden"> Supprimer</span></button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-2">{{ categorie.nomCategorie }}</h5>
                            <p class="card-text text-muted mb-4 text-truncate-2" style="min-height: 3rem;">
                                {{ categorie.description|default('Aucune description fournie.') }}
                            </p>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                <span class="badge rounded-pill px-3 py-2" style="background-color: {{ categorie.couleur|default('#4e73df') }}20; color: {{ categorie.couleur|default('#4e73df') }}; font-weight: 600;">
                                    {{ categorie.documents|length }} Documents
                                </span>
                                <a href="{{ path('categorie_show', {id: categorie.id}) }}" class="btn btn-link text-primary p-0 text-decoration-none fw-bold">
                                    Gérer <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <div class="bg-white p-5 rounded-4 shadow-sm d-inline-block">
                        <i class="fas fa-tags fa-4x text-light mb-4 d-block"></i>
                        <h3 class="fw-bold">Aucune catégorie</h3>
                        <p class="text-muted mb-4">Créez des catégories pour classer vos documents importants.</p>
                        <a href="{{ path('categorie_new') }}" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">
                            Créer ma première catégorie
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<style>
    .transition-hover {
        transition: all 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.08) !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
{% endblock %}