<form method="post" class="needs-validation" novalidate>
    <div class="mb-4">
        <label for="nom_categorie" class="form-label fw-bold text-dark mb-2">Nom de la catégorie</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fas fa-tag text-muted"></i></span>
            <input type="text" id="nom_categorie" name="nom_categorie" class="form-control bg-light border-0 py-3 shadow-none" placeholder="Ex: Documents Fiscaux" value="{{ categorie.nomCategorie|default('') }}" required>
        </div>
        <div class="invalid-feedback">Veuillez donner un nom à cette catégorie.</div>
    </div>

    <div class="mb-4">
        <label for="description" class="form-label fw-bold text-dark mb-2">Description (Optionnelle)</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fas fa-align-left text-muted"></i></span>
            <textarea id="description" name="description" class="form-control bg-light border-0 py-3 shadow-none" rows="3" placeholder="Description de la catégorie...">{{ categorie.description|default('') }}</textarea>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <label for="icon" class="form-label fw-bold text-dark mb-2">Icône FontAwesome</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fas fa-icons text-muted"></i></span>
                <input type="text" id="icon" name="icon" class="form-control bg-light border-0 py-3 shadow-none" placeholder="Ex: fa-file-invoice" value="{{ categorie.icon|default('fa-folder') }}">
            </div>
            <div class="form-text small">Consultez <a href="https://fontawesome.com/v6/search?m=free" target="_blank" class="text-primary text-decoration-none">FontAwesome</a> pour les noms d'icônes.</div>
        </div>
        <div class="col-md-6">
            <label for="couleur" class="form-label fw-bold text-dark mb-2">Couleur thématique</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fas fa-palette text-muted"></i></span>
                <input type="color" id="couleur" name="couleur" class="form-control form-control-color bg-light border-0 py-1 w-100 shadow-none" value="{{ categorie.couleur|default('#4e73df') }}">
            </div>
            <div class="form-text small">Personnalisez l'apparence de cette catégorie.</div>
        </div>
    </div>

    <div class="d-grid mt-5">
        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm py-3 transition-hover">
            <i class="fas fa-save me-2"></i> {{ categorie.id ? 'Mettre à jour' : 'Enregistrer la catégorie' }}
        </button>
    </div>
</form>

<style>
    .form-control-color {
        height: 58px;
        padding: 0.5rem;
    }
</style>

<script>
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }
                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>