{% extends 'frontoffice/base.html.twig' %}

{% block title %}Nouvelle Catégorie{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="mb-4">
            <a href="{{ path('categorie_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="fas fa-arrow-left me-2"></i> Retour à la liste
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-primary py-4 text-center">
                        <div class="bg-white bg-opacity-25 d-inline-block p-3 rounded-circle mb-3">
                            <i class="fas fa-folder-plus fa-2x text-white"></i>
                        </div>
                        <h2 class="h3 fw-bold text-white mb-0">Nouvelle Catégorie</h2>
                        <p class="text-white text-opacity-75 small mb-0">Créez un nouvel espace pour organiser vos documents.</p>
                    </div>
                    <div class="card-body p-4 p-md-5 bg-white">
                        {{ include('frontoffice/categorie/_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}