<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture Produit - FinTrack</title>
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
            color: #1f2937;
            margin: 24px;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px solid #dbeafe;
        }
        .brand {
            font-size: 24px;
            font-weight: bold;
            color: #1d4ed8;
            margin-bottom: 4px;
        }
        .subtitle {
            color: #6b7280;
            font-size: 11px;
        }
        .meta {
            text-align: right;
            color: #4b5563;
            font-size: 11px;
        }
        .grid {
            display: table;
            width: 100%;
            margin-bottom: 18px;
        }
        .col {
            display: table-cell;
            width: 50%;
            vertical-align: top;
            padding: 12px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
        }
        .section-title {
            font-size: 11px;
            text-transform: uppercase;
            color: #6b7280;
            margin-bottom: 8px;
            letter-spacing: .04em;
        }
        .value {
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 4px;
        }
        .invoice-box {
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 18px;
        }
        .invoice-head {
            background: #eff6ff;
            color: #1d4ed8;
            padding: 10px 14px;
            font-weight: bold;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            border-bottom: 1px solid #e5e7eb;
            padding: 10px 14px;
            text-align: left;
        }
        th {
            background: #f8fafc;
            color: #334155;
            font-size: 11px;
            text-transform: uppercase;
        }
        .totals {
            margin-top: 8px;
            text-align: right;
            font-size: 13px;
        }
        .totals strong {
            font-size: 15px;
            color: #0f172a;
        }
        .qr-block {
            margin-top: 18px;
            padding: 12px;
            border: 1px dashed #94a3b8;
            border-radius: 10px;
            text-align: center;
        }
        .qr-block img {
            width: 160px;
            height: 160px;
            margin-bottom: 8px;
        }
        .small {
            color: #6b7280;
            font-size: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <div class="brand">FinTrack</div>
            <div class="subtitle">Facture produit générée automatiquement</div>
        </div>
        <div class="meta">
            <div><strong>Facture:</strong> {{ invoiceNumber }}</div>
            <div><strong>Générée le:</strong> {{ generatedAt|date('d/m/Y H:i') }}</div>
        </div>
    </div>

    <div class="grid">
        <div class="col">
            <div class="section-title">Émetteur</div>
            <div class="value">FinTrack</div>
            <div class="small">support@fintrack.local</div>
            <div class="small">Tunis, Tunisia</div>
        </div>
        <div class="col">
            <div class="section-title">Client</div>
            <div class="value">{{ user.fullName ?: 'Client FinTrack' }}</div>
            <div class="small">{{ user.email }}</div>
        </div>
    </div>

    <div class="invoice-box">
        <div class="invoice-head">Détail du produit</div>
        <table>
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Code</th>
                    <th>Type</th>
                    <th>Montant</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ product.nomProduit }}</td>
                    <td>{{ product.codeUnique ?: '-' }}</td>
                    <td>{{ product.typeProduit }}</td>
                    <td>{{ product.montant|number_format(2, ',', ' ') }} TND</td>
                </tr>
            </tbody>
        </table>
        <div class="totals">
            Total à payer: <strong>{{ product.montant|number_format(2, ',', ' ') }} TND</strong>
        </div>
    </div>

    <div class="qr-block">
        <img src="{{ qrCodeDataUri }}" alt="QR Code facture">
        <div><strong>Scanner avec votre téléphone pour télécharger la facture</strong></div>
        <div class="small">Scannez ce code avec la caméra de votre téléphone</div>
    </div>
</body>
</html>
