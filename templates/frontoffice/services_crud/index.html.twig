{% extends 'base.html.twig' %}

{% block title %}FinTrack - Gestion des produits et services{% endblock %}

{% block body %}
<!-- Navbar simple -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold fs-3" href="{{ path('app_home') }}">
            <i class="fas fa-chart-line text-primary me-2"></i>FinTrack
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                <li class="nav-item"><a class="nav-link fw-bold text-primary" href="{{ path('app_services_crud') }}">Services</a></li>
                <li class="nav-item"><a class="btn btn-primary rounded-pill px-4" href="{{ path('app_dashboard') }}">Dashboard</a></li>
            </ul>
        </div>
    </div>
</nav>

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Gestion des <span class="text-primary">Produits & Services</span></h1>
        <p class="lead">CRUD complet - Métiers de base et avancés</p>
    </div>

    <!-- Onglets -->
    <ul class="nav nav-tabs justify-content-center mb-4">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#produits">
                <i class="fas fa-box me-2"></i>Produits
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#services">
                <i class="fas fa-cogs me-2"></i>Services
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#factures">
                <i class="fas fa-file-invoice me-2"></i>Factures
            </a>
        </li>
    </ul>

    <!-- Contenu des onglets -->
    <div class="tab-content">
        <!-- Onglet PRODUITS -->
        <div class="tab-pane fade show active" id="produits">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-box me-2"></i>Liste des produits</h4>
                    <a href="{{ path('app_produit_new') }}" class="btn btn-light btn-sm rounded-pill">
                        <i class="fas fa-plus me-1"></i>Ajouter un produit
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Type</th>
                                    <th>Montant</th>
                                    <th>Code unique</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for produit in produits %}
                                <tr>
                                    <td>{{ produit.id }}</td>
                                    <td>{{ produit.nomProduit }}</td>
                                    <td>{{ produit.typeProduit }}</td>
                                    <td><strong>{{ produit.montant }} DT</strong></td>
                                    <td><code>{{ produit.codeUnique }}</code></td>
                                    <td>
                                        {% if produit.statut == 'disponible' %}
                                            <span class="badge bg-success">Disponible</span>
                                        {% elseif produit.statut == 'vendu' %}
                                            <span class="badge bg-warning">Vendu</span>
                                        {% else %}
                                            <span class="badge bg-danger">Expiré</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('app_produit_show', {'id': produit.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_produit_delete', {'id': produit.id}) }}" style="display:inline-block" onsubmit="return confirm('Archiver ce produit ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                            <button class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">Aucun produit trouvé</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Onglet SERVICES -->
        <div class="tab-pane fade" id="services">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-cogs me-2"></i>Liste des services</h4>
                    <a href="{{ path('app_service_new') }}" class="btn btn-light btn-sm rounded-pill">
                        <i class="fas fa-plus me-1"></i>Ajouter un service
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Type</th>
                                    <th>Tarif</th>
                                    <th>Fréquence</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for service in services %}
                                <tr>
                                    <td>{{ service.id }}</td>
                                    <td>{{ service.nomService }}</td>
                                    <td>{{ service.typeService }}</td>
                                    <td><strong>{{ service.tarif }} DT</strong></td>
                                    <td>{{ service.frequence ?: '-' }}</td>
                                    <td>
                                        {% if service.statut == 'actif' %}
                                            <span class="badge bg-success">Actif</span>
                                        {% elseif service.statut == 'suspendu' %}
                                            <span class="badge bg-warning">Suspendu</span>
                                        {% else %}
                                            <span class="badge bg-danger">Expiré</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('app_service_show', {'id': service.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_service_edit', {'id': service.id}) }}" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_service_delete', {'id': service.id}) }}" style="display:inline-block" onsubmit="return confirm('Archiver ce service ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                                            <button class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">Aucun service trouvé</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Onglet FACTURES -->
        <div class="tab-pane fade" id="factures">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-file-invoice me-2"></i>Liste des factures</h4>
                    <a href="{{ path('app_facture_new') }}" class="btn btn-light btn-sm rounded-pill">
                        <i class="fas fa-plus me-1"></i>Générer une facture
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>N° Facture</th>
                                    <th>Date</th>
                                    <th>Échéance</th>
                                    <th>Montant</th>
                                    <th>Concerne</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for facture in factures %}
                                <tr>
                                    <td><strong>{{ facture.numeroFacture }}</strong></td>
                                    <td>{{ facture.dateFacture|date('d/m/Y') }}</td>
                                    <td>{{ facture.dateEcheance|date('d/m/Y') }}</td>
                                    <td><strong>{{ facture.montant }} DT</strong></td>
                                    <td>
                                        {% if facture.produit %}
                                            <span class="badge bg-info">Produit: {{ facture.produit.nomProduit }}</span>
                                        {% elseif facture.service %}
                                            <span class="badge bg-success">Service: {{ facture.service.nomService }}</span>
                                        {% else %}
                                            <span class="badge bg-secondary">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if facture.statut == 'payee' %}
                                            <span class="badge bg-success">Payée</span>
                                        {% elseif facture.statut == 'impayee' %}
                                            <span class="badge bg-danger">Impayée</span>
                                        {% else %}
                                            <span class="badge bg-warning">En attente</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('app_facture_show', {'id': facture.id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_facture_edit', {'id': facture.id}) }}" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        {% if facture.statut != 'payee' %}
                                            <form method="post" action="{{ path('app_facture_pay', {'id': facture.id}) }}" style="display:inline-block">
                                                <input type="hidden" name="_token" value="{{ csrf_token('pay' ~ facture.id) }}">
                                                <button class="btn btn-sm btn-success">
                                                    <i class="fas fa-money-bill"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                        <form method="post" action="{{ path('app_facture_delete', {'id': facture.id}) }}" style="display:inline-block" onsubmit="return confirm('Archiver cette facture ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ facture.id) }}">
                                            <button class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">Aucune facture trouvée</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}