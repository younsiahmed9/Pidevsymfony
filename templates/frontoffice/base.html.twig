<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <title>{% block title %}FinTrack{% endblock %}</title>
    <script>
        (function () {
            var savedTheme = localStorage.getItem('ft-theme');
            var preferredDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var theme = savedTheme || (preferredDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- CSS Plugins (local) -->
    <link rel="stylesheet" href="{{ asset('frontoffice/css/bootstrap/bootstrap.css') }}">
    <link rel="stylesheet" href="{{ asset('frontoffice/plugins/font-awesome/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('frontoffice/plugins/font-awesome/solid.css') }}">
    <link rel="stylesheet" href="{{ asset('frontoffice/plugins/font-awesome/brands.css') }}">
    
    <!-- Main Style Sheet (Asset Symfony) -->
    <link rel="stylesheet" href="{{ asset('frontoffice/css/style.css') }}">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">

    <style>
        html, body {
            width: 100%;
        }

        body {
            overflow-x: hidden;
        }

        main {
            padding: 1rem 0 2rem;
        }

        @media (max-width: 576px) {
            main {
                padding: 0.75rem 0 1.5rem;
            }
        }

        html:not([data-theme='dark']) .form-control,
        html:not([data-theme='dark']) .form-select,
        html:not([data-theme='dark']) .form-control:focus,
        html:not([data-theme='dark']) .form-select:focus,
        html:not([data-theme='dark']) input,
        html:not([data-theme='dark']) select,
        html:not([data-theme='dark']) textarea {
            color: #111111 !important;
            -webkit-text-fill-color: #111111 !important;
            background-color: #ffffff !important;
        }

        html:not([data-theme='dark']) .form-control::placeholder,
        html:not([data-theme='dark']) textarea::placeholder,
        html:not([data-theme='dark']) input::placeholder {
            color: #6b7280 !important;
            opacity: 1;
        }

        html:not([data-theme='dark']) select option {
            color: #111111 !important;
            background-color: #ffffff !important;
        }

        html[data-theme='dark'] body {
            background-color: #0f172a;
            color: #e5e7eb;
        }

        html[data-theme='dark'] .bg-light,
        html[data-theme='dark'] .bg-tertiary {
            background-color: #111827 !important;
        }

        html[data-theme='dark'] .card,
        html[data-theme='dark'] .dropdown-menu,
        html[data-theme='dark'] .table,
        html[data-theme='dark'] .list-group-item {
            background-color: #1f2937 !important;
            color: #e5e7eb !important;
            border-color: #374151 !important;
        }

        html[data-theme='dark'] .text-dark,
        html[data-theme='dark'] .text-muted,
        html[data-theme='dark'] .form-text,
        html[data-theme='dark'] p,
        html[data-theme='dark'] h1,
        html[data-theme='dark'] h2,
        html[data-theme='dark'] h3,
        html[data-theme='dark'] h4,
        html[data-theme='dark'] h5,
        html[data-theme='dark'] h6,
        html[data-theme='dark'] label,
        html[data-theme='dark'] span,
        html[data-theme='dark'] a {
            color: #e5e7eb !important;
        }

        html[data-theme='dark'] .form-control,
        html[data-theme='dark'] .form-select,
        html[data-theme='dark'] .btn-light,
        html[data-theme='dark'] .input-group-text {
            background-color: #111827 !important;
            color: #e5e7eb !important;
            border-color: #374151 !important;
        }
    </style>

    {# Couche UI premium : espacements, ombres, navigation, formulaires, tableaux (sans changer la structure) #}
    <link rel="stylesheet" href="{{ asset('frontoffice/css/fintrack-premium.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body>

    <!-- Barre de navigation -->
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <!-- Alertes Flash -->
    {% include 'partials/_animated_flashes.html.twig' %}

    <!-- Contenu Principal -->
    <main>
        {% block body %}{% endblock %}
    </main>

    <!-- Pied de page -->
    {% include 'frontoffice/partials/_footer.html.twig' %}

    <!-- JS Plugins (local) -->
    <script src="{{ asset('frontoffice/plugins/bootstrap/bootstrap.bundle.min.js') }}"></script>
    
    <!-- Main Script -->
    <script src="{{ asset('frontoffice/js/app.js') }}"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
