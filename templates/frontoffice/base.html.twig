<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <title>{% block title %}FinTrack{% endblock %}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- CSS Plugins via CDN ou assets locaux, adapter si nécessaire -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Main Style Sheet (Asset Symfony) -->
    <link rel="stylesheet" href="{{ asset('frontoffice/css/style.css') }}">
    <style>
        .btn-success,
        .btn-primary,
        .btn-outline-success,
        .btn-outline-primary,
        .bg-success,
        .bg-success-subtle,
        .text-success {
            --bs-success-rgb: 13, 110, 253;
        }

        .btn-primary {
            background-color: #0d6efd !important;
            border-color: #0d6efd !important;
            color: #fff !important;
        }

        .btn-primary:hover,
        .btn-primary:focus,
        .btn-primary:active,
        .btn-primary.active {
            background-color: #0b5ed7 !important;
            border-color: #0a58ca !important;
            color: #fff !important;
        }

        .btn-outline-primary {
            color: #0d6efd !important;
            border-color: #0d6efd !important;
        }

        .btn-outline-primary:hover,
        .btn-outline-primary:focus,
        .btn-outline-primary:active,
        .btn-outline-primary.active {
            background-color: #0d6efd !important;
            border-color: #0d6efd !important;
            color: #fff !important;
        }

        .btn-success {
            background-color: #0d6efd !important;
            border-color: #0d6efd !important;
            color: #fff !important;
        }

        .btn-outline-success {
            color: #0d6efd !important;
            border-color: #0d6efd !important;
        }

        .btn-outline-success:hover,
        .btn-outline-success:focus,
        .btn-outline-success:active,
        .btn-outline-success.active {
            background-color: #0d6efd !important;
            border-color: #0d6efd !important;
            color: #fff !important;
        }

        .bg-success { background-color: #0d6efd !important; }
        .bg-success-subtle { background-color: rgba(13, 110, 253, 0.15) !important; }
        .text-success { color: #0d6efd !important; }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

    <!-- Barre de navigation -->
    {% include 'frontoffice/partials/_navbar.html.twig' %}

    <!-- Alertes Flash -->
    <div class="container mt-3">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <!-- Contenu Principal -->
    <main>
        {% block body %}{% endblock %}
    </main>

    <!-- Pied de page -->
    {% include 'frontoffice/partials/_footer.html.twig' %}

    <!-- JS Plugins -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.css"></script>
    
    <!-- Main Script -->
    <script src="{{ asset('frontoffice/js/app.js') }}"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
