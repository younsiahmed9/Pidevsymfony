<form method="post" action="{{ path('facture_delete', {'id': facture.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette facture ? Cette action est irréversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ facture.id) }}">
    <button type="submit" class="btn btn-outline-danger btn-sm btn-action-icon btn-sm" title="Supprimer la facture">
        <i class="fas fa-trash-alt" aria-hidden="true"></i><span class="visually-hidden">Supprimer la facture</span>
    </button>
</form>
