{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Factures - FinTrack{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">Mes Factures</h1>
                <p class="text-muted mb-0">Suivez l'état de vos paiements et vos échéances.</p>
            </div>
            <a href="{{ path('facture_new') }}" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                <i class="fas fa-plus me-2"></i> Nouvelle Facture
            </a>
        </div>

        <!-- Summary Statistics -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-inline-block mx-auto mb-3">
                        <i class="fas fa-file-invoice text-primary fa-2x"></i>
                    </div>
                    <h6 class="text-muted small text-uppercase fw-bold">Total Factures</h6>
                    <p class="h3 fw-bold text-dark mb-0">{{ factures|length }}</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle d-inline-block mx-auto mb-3">
                        <i class="fas fa-check-double text-success fa-2x"></i>
                    </div>
                    <h6 class="text-muted small text-uppercase fw-bold">Factures Payées</h6>
                    <p class="h3 fw-bold text-dark mb-0">{{ factures|filter(f => f.statut == 'payee')|length }}</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle d-inline-block mx-auto mb-3">
                        <i class="fas fa-clock text-danger fa-2x"></i>
                    </div>
                    <h6 class="text-muted small text-uppercase fw-bold">À Payer</h6>
                    <p class="h3 fw-bold text-dark mb-0">{{ factures|filter(f => f.statut == 'non_payee')|length }}</p>
                </div>
            </div>
        </div>

        <!-- Factures Table -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Historique de facturation</h5>
            </div>
            <div class="card-body p-0">
                {% if factures is empty %}
                    <div class="text-center py-5">
                        <div class="bg-light d-inline-block p-4 rounded-circle mb-3">
                            <i class="fas fa-file-invoice-dollar fa-3x text-muted opacity-50"></i>
                        </div>
                        <h5 class="fw-bold">Aucune facture enregistrée</h5>
                        <p class="text-muted mb-4">Gérez vos documents financiers en un seul endroit.</p>
                        <a href="{{ path('facture_new') }}" class="btn btn-primary rounded-pill px-5">Créer une facture</a>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 border-0">Référence</th>
                                    <th class="border-0 text-center">Date</th>
                                    <th class="border-0 text-center">Échéance</th>
                                    <th class="border-0 text-end">Montant</th>
                                    <th class="border-0 text-center">Statut</th>
                                    <th class="border-0 text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for facture in factures %}
                                    <tr class="pointer-event" onclick="window.location='{{ path('facture_show', {id: facture.id}) }}'">
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">{{ facture.numeroFacture }}</div>
                                            <div class="small text-muted">
                                                {% if facture.serviceNom %}
                                                    Service: {{ facture.serviceNom }}
                                                {% elseif facture.produitNom %}
                                                    Produit: {{ facture.produitNom }}
                                                {% else %}
                                                    Transaction diverse
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td class="text-center">{{ facture.dateFacture|date('d/m/Y') }}</td>
                                        <td class="text-center">{{ facture.dateEcheance ? facture.dateEcheance|date('d/m/Y') : '-' }}</td>
                                        <td class="text-end fw-bold text-primary pe-4">
                                            {{ facture.montant|number_format(2, ',', ' ') }} TND
                                        </td>
                                        <td class="text-center">
                                            {% set badge_class = facture.statut == 'payee' ? 'success' : (facture.statut == 'non_payee' ? 'danger' : 'warning') %}
                                            <span class="badge rounded-pill bg-{{ badge_class }} px-3">
                                                {{ facture.statut|capitalize|replace({'_': ' '}) }}
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="dropdown">
                                                <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" onclick="event.stopPropagation()">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                                    <li><a class="dropdown-item" href="{{ path('facture_show', {id: facture.id}) }}"><i class="fas fa-eye me-2 text-primary"></i> Voir</a></li>
                                                    <li><a class="dropdown-item" href="{{ path('facture_edit', {id: facture.id}) }}"><i class="fas fa-edit me-2 text-warning"></i> Modifier</a></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<style>
    .pointer-event { cursor: pointer; transition: background-color 0.2s; }
    .pointer-event:hover { background-color: #f8fafc; }
</style>
{% endblock %}
