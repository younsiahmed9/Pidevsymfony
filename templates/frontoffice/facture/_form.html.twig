<form method="POST" novalidate>
    {% set factureData = facture|default({}) %}
    {% set formErrors = formErrors|default({}) %}
    <div class="row g-4">
        <div class="col-md-12">
            <div class="form-group">
                <label for="numeroFacture" class="form-label fw-bold text-muted small text-uppercase">Référence de la facture</label>
                <input type="text" id="numeroFacture" name="numeroFacture" class="form-control form-control-lg border-0 bg-light shadow-none" value="{{ factureData.numeroFacture|default('') }}" placeholder="Ex: FAC-2026-001">
                <div class="form-text">Laissez vide pour une génération automatique. Le montant sera calculé automatiquement selon le service/produit sélectionné.</div>
                {% for error in formErrors.numeroFacture|default([]) %}
                    <div class="text-danger small mt-1">{{ error }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label for="montant" class="form-label fw-bold text-muted small text-uppercase">Montant (TND)</label>
                <div class="input-group">
                    <span class="input-group-text border-0 bg-light"><i class="fas fa-coins text-primary"></i></span>
                    <input type="number" id="montant" name="montant" class="form-control form-control-lg border-0 bg-light shadow-none" step="0.01" value="{{ factureData.montant|default('') }}" placeholder="0.00" required>
                </div>
                {% for error in formErrors.montant|default([]) %}
                    <div class="text-danger small mt-1">{{ error }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label for="statut" class="form-label fw-bold text-muted small text-uppercase">État de la facture</label>
                <select id="statut" name="statut" class="form-select form-select-lg border-0 bg-light shadow-none" required>
                    <option value="non_payee" {{ factureData.statut|default('non_payee') == 'non_payee' ? 'selected' : '' }}>En attente de paiement</option>
                    <option value="payee" {{ factureData.statut|default('non_payee') == 'payee' ? 'selected' : '' }}>Payée</option>
                    <option value="en_retard" {{ factureData.statut|default('non_payee') == 'en_retard' ? 'selected' : '' }}>En retard</option>
                </select>
                {% for error in formErrors.statut|default([]) %}
                    <div class="text-danger small mt-1">{{ error }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label for="dateFacture" class="form-label fw-bold text-muted small text-uppercase">Date d'émission</label>
                <input type="date" id="dateFacture" name="dateFacture" class="form-control form-control-lg border-0 bg-light shadow-none" value="{{ factureData.dateFacture|default('now'|date('Y-m-d')) }}" required>
                {% for error in formErrors.dateFacture|default([]) %}
                    <div class="text-danger small mt-1">{{ error }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label for="dateEcheance" class="form-label fw-bold text-muted small text-uppercase">Date d'échéance</label>
                <input type="date" id="dateEcheance" name="dateEcheance" class="form-control form-control-lg border-0 bg-light shadow-none" value="{{ factureData.dateEcheance|default('') }}">
                {% for error in formErrors.dateEcheance|default([]) %}
                    <div class="text-danger small mt-1">{{ error }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label for="service" class="form-label fw-bold text-muted small text-uppercase">Service associé (Optionnel)</label>
                <select id="service" name="service" class="form-select form-select-lg border-0 bg-light shadow-none">
                    <option value="" data-prix="0">Aucun service</option>
                    {% for service in services|default([]) %}
                        <option value="{{ service.id }}" data-prix="{{ service.tarif }}" {{ factureData.service|default('') == service.id ? 'selected' : '' }}>{{ service.nomService }} - {{ service.tarif|number_format(2, ',', ' ') }} TND</option>
                    {% endfor %}
                </select>
                {% for error in formErrors.service|default([]) %}
                    <div class="text-danger small mt-1">{{ error }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label for="produit" class="form-label fw-bold text-muted small text-uppercase">Produit associé (Optionnel)</label>
                <select id="produit" name="produit" class="form-select form-select-lg border-0 bg-light shadow-none">
                    <option value="" data-prix="0">Aucun produit</option>
                    {% for produit in produits|default([]) %}
                        <option value="{{ produit.id }}" data-prix="{{ produit.montant }}" {{ factureData.produit|default('') == produit.id ? 'selected' : '' }}>{{ produit.nomProduit }} - {{ produit.montant|number_format(2, ',', ' ') }} TND</option>
                    {% endfor %}
                </select>
                {% for error in formErrors.produit|default([]) %}
                    <div class="text-danger small mt-1">{{ error }}</div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="mt-5 pt-4 border-top d-flex gap-3">
        <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
            <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer la facture') }}
        </button>
        <a href="{{ path('facture_index') }}" class="btn btn-light btn-lg px-4 rounded-pill">
            Annuler
        </a>
    </div>
</form>

<script>
(function() {
    const serviceSelect = document.getElementById('service');
    const produitSelect = document.getElementById('produit');
    const montantInput = document.getElementById('montant');
    
    function calculerMontant() {
        let montant = 0;
        
        // Récupérer le prix du service sélectionné
        const serviceOption = serviceSelect.options[serviceSelect.selectedIndex];
        if (serviceOption && serviceOption.dataset.prix) {
            montant += parseFloat(serviceOption.dataset.prix);
        }
        
        // Récupérer le prix du produit sélectionné
        const produitOption = produitSelect.options[produitSelect.selectedIndex];
        if (produitOption && produitOption.dataset.prix) {
            montant += parseFloat(produitOption.dataset.prix);
        }
        
        // Mettre à jour le champ montant
        montantInput.value = montant.toFixed(2);
        
        // Ajouter un indicateur visuel si le montant est calculé automatiquement
        if (montant > 0) {
            montantInput.style.backgroundColor = '#e8f5e8';
            montantInput.style.borderColor = '#28a745';
        } else {
            montantInput.style.backgroundColor = '';
            montantInput.style.borderColor = '';
        }
    }
    
    // Écouter les changements sur les sélecteurs
    serviceSelect.addEventListener('change', calculerMontant);
    produitSelect.addEventListener('change', calculerMontant);
    
    // Calculer au chargement si des valeurs sont pré-sélectionnées
    window.addEventListener('load', function() {
        calculerMontant();
    });
    
    // Permettre la modification manuelle du montant
    montantInput.addEventListener('input', function() {
        // Réinitialiser les styles si l'utilisateur modifie manuellement
        this.style.backgroundColor = '';
        this.style.borderColor = '';
    });
})();
</script>
