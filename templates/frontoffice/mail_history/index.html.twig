{% extends 'frontoffice/base.html.twig' %}

{% block title %}Historique Emails - FinTrack{% endblock %}

{% block body %}
<section class="section py-5 bg-tertiary">
    <div class="container mt-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="h4 fw-bold mb-1">Historique des emails</h2>
                <p class="text-muted mb-0">Traçabilité des envois Brevo liés à votre compte.</p>
            </div>
            <a href="{{ path('front_dashboard_index') }}" class="btn btn-outline-primary">Retour tableau de bord</a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Template</th>
                                <th>Destinataire</th>
                                <th>Sujet</th>
                                <th>Statut</th>
                                <th>Provider</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                                <tr>
                                    <td>{{ log.createdAt ? log.createdAt|date('Y-m-d H:i:s') : '-' }}</td>
                                    <td>{{ log.mailTemplate }}</td>
                                    <td>{{ log.recipientEmail }}</td>
                                    <td>{{ log.subject }}</td>
                                    <td>
                                        <span class="badge {{ log.status == 'SENT' ? 'bg-success' : (log.status == 'FAILED' ? 'bg-danger' : 'bg-secondary') }}">
                                            {{ log.status }}
                                        </span>
                                    </td>
                                    <td>{{ log.provider }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Aucun envoi email enregistré.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}