{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Cartes Virtuelles - FinTrack{% endblock %}

{% block body %}
<section class="section py-5 bg-tertiary">
    <div class="container mt-4">
        <div class="row mb-4 align-items-center">
            <div class="col-md-6">
                <h2 class="h3 fw-bold mb-0">Mes Cartes Virtuelles</h2>
                <p class="text-muted">Gérez vos cartes et vos plafonds</p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <a href="{{ path('front_carte_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Nouvelle carte
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        {% if cartes is empty %}
                            <div class="text-center p-5">
                                <div class="mb-3">
                                    <i class="fas fa-credit-card fa-3x text-muted opacity-50"></i>
                                </div>
                                <h5>Aucune carte trouvée</h5>
                                <p class="text-muted">Créez votre première carte virtuelle pour vos achats.</p>
                                <a href="{{ path('front_carte_new') }}" class="btn btn-outline-primary mt-2">Créer une carte</a>
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Numéro</th>
                                            <th>Type & Statut</th>
                                            <th class="text-end">Plafond</th>
                                            <th class="text-end">Solde</th>
                                            <th class="text-end pe-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for carte in cartes %}
                                            <tr>
                                                <td class="ps-4 font-monospace">
                                                    <i class="fas fa-credit-card text-primary me-2"></i> 
                                                    **** **** **** {{ carte.numero_carte|slice(-4) }}
                                                </td>
                                                <td>
                                                    {% if carte.type == 'GOLD' %}
                                                        <span class="badge bg-warning text-dark me-1">GOLD</span>
                                                    {% elseif carte.type == 'SILVER' %}
                                                        <span class="badge bg-secondary me-1">SILVER</span>
                                                    {% else %}
                                                        <span class="badge bg-info me-1">NORMAL</span>
                                                    {% endif %}

                                                    <span class="badge {{ carte.is_active ? 'bg-success' : 'bg-danger' }}">
                                                        {{ carte.is_active ? 'Active' : 'Inactive' }}
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <small class="text-muted">{{ carte.plafond|number_format(0, ',', ' ') }} {{ carte.devise }}</small>
                                                </td>
                                                <td class="text-end fw-bold text-dark">
                                                    {{ carte.solde|number_format(2, ',', ' ') }} {{ carte.devise }}
                                                </td>
                                                <td class="text-end pe-4">
                                                    <a href="{{ path('front_carte_show', {'id': carte.id}) }}" class="btn btn-sm btn-outline-info btn-action-icon btn-sm me-1" title="Voir">
                                                        <i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Voir</span>
                                                    </a>
                                                    <a href="{{ path('front_carte_edit', {'id': carte.id}) }}" class="btn btn-sm btn-outline-primary btn-action-icon btn-sm me-1" title="Modifier">
                                                        <i class="fas fa-pen" aria-hidden="true"></i><span class="visually-hidden">Modifier</span>
                                                    </a>
                                                    
                                                    <form method="post" action="{{ path('front_carte_toggle', {'id': carte.id}) }}" class="d-inline-block mb-0">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ carte.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-action-icon btn-sm {{ carte.is_active ? 'btn-outline-warning' : 'btn-outline-primary' }}" title="{{ carte.is_active ? 'Désactiver' : 'Activer' }}">
                                                            <i class="fas {{ carte.is_active ? 'fa-lock' : 'fa-unlock' }}" aria-hidden="true"></i><span class="visually-hidden">{{ carte.is_active ? 'Désactiver' : 'Activer' }}</span>
                                                        </button>
                                                    </form>

                                                    {% include 'frontoffice/carte/_delete_form.html.twig' with { carte: carte } %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                    {% if cartes is not empty and cartes.pageCount is defined %}
                        <div class="card-footer bg-white py-3">
                            <div class="d-flex justify-content-center">
                                {{ knp_pagination_render(cartes) }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
