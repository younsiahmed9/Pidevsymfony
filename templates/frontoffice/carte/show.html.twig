{% extends 'frontoffice/base.html.twig' %}

{% block title %}Détails de la Carte - FinTrack{% endblock %}

{% block body %}
<section class="section py-5 bg-tertiary">
    <div class="container mt-4">
        <!-- Bouton retour -->
        <a href="{{ path('front_carte_index') }}" class="text-muted text-decoration-none d-inline-block mb-3">
            <i class="fas fa-arrow-left me-1"></i> Retour aux cartes
        </a>

        <div class="row">
            <!-- Info de la carte -->
            <div class="col-lg-5 mb-4">
                <!-- Visuel de la carte -->
                <div class="card border-0 text-white mb-4 rounded-4 shadow-lg overflow-hidden position-relative
                    {% if carte.type == 'GOLD' %} bg-warning
                    {% elseif carte.type == 'SILVER' %} bg-secondary
                    {% else %} bg-primary
                    {% endif %}">
                    <div class="card-body p-4 position-relative" style="z-index: 2;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="mb-0 text-white-50">WALLET APP</h5>
                            <div>
                                {% if carte.type == 'GOLD' %}
                                    <span class="badge bg-white text-warning">GOLD</span>
                                {% elseif carte.type == 'SILVER' %}
                                    <span class="badge bg-white text-secondary">SILVER</span>
                                {% else %}
                                    <span class="badge bg-white text-primary">NORMAL</span>
                                {% endif %}
                            </div>
                        </div>
                        <h3 class="font-monospace text-white mb-4 letter-spacing-lg mt-3">
                            {% for i in 0..3 %}
                                {{ carte.numero_carte|slice(i*4, 4) }} {% if not loop.last %}&nbsp;&nbsp;{% endif %}
                            {% endfor %}
                        </h3>
                        <div class="d-flex justify-content-between">
                            <div>
                                <small class="text-white-50 d-block">EXPIRATION</small>
                                <span class="fw-bold font-monospace">{{ carte.date_expiration|date('m/y') }}</span>
                            </div>
                            <div>
                                <small class="text-white-50 d-block">CVV</small>
                                <span class="fw-bold font-monospace">{{ carte.cvv }}</span>
                            </div>
                            <div class="text-end">
                                <i class="fab fa-cc-visa fa-2x"></i>
                            </div>
                        </div>
                    </div>
                    <!-- Forme de fond pour le style -->
                    <div class="position-absolute top-0 end-0 bg-white opacity-10 rounded-circle" style="width: 200px; height: 200px; margin-top: -50px; margin-right: -50px; z-index: 1;"></div>
                </div>

                <!-- Détails supplémentaires -->
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <span class="text-muted">Statut</span>
                                <span class="badge {{ carte.is_active ? 'bg-success' : 'bg-danger' }}">
                                    {{ carte.is_active ? 'Active' : 'Inactive' }}
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <span class="text-muted">Portefeuille Rattaché</span>
                                <a href="{{ path('front_portefeuille_show', {'id': carte.portefeuille_id}) }}" class="fw-bold text-decoration-none">
                                    {{ carte.portefeuille_nom }}
                                </a>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <span class="text-muted">Solde</span>
                                <span class="fw-bold fs-5 text-primary">{{ carte.solde|number_format(2, ',', ' ') }} {{ carte.devise }}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 border-bottom-0">
                                <span class="text-muted">Plafond</span>
                                <span>{{ carte.plafond|number_format(0, ',', ' ') }} {{ carte.devise }}</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Transactions de la carte -->
            <div class="col-lg-7 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-exchange-alt me-2 text-primary"></i>Transactions liées</h5>
                    </div>
                    <div class="card-body p-0">
                        {% if transactions is empty %}
                            <p class="text-muted text-center py-5">Aucune transaction avec cette carte.</p>
                        {% else %}
                            <div class="table-responsive px-4 pb-3">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Statut</th>
                                            <th class="text-end">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for trx in transactions %}
                                            <tr>
                                                <td><small class="text-muted">{{ trx.date|date('d/m/Y H:i') }}</small></td>
                                                <td>
                                                    <span class="text-primary"><i class="fas fa-exchange-alt me-1"></i>Transfert</span>
                                                    <div class="small text-muted mt-1">{{ trx.description }}</div>
                                                </td>
                                                <td>
                                                    <span class="badge {{ trx.statut in ['COMPLETED', 'TERMINE'] ? 'bg-success' : (trx.statut in ['PENDING', 'EN_ATTENTE'] ? 'bg-warning' : 'bg-danger') }}">
                                                        {{ trx.statut }}
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold {{ trx.carte_source_id and trx.carte_source_id == carte.id ? 'text-danger' : 'text-success' }}">
                                                    {{ trx.carte_source_id and trx.carte_source_id == carte.id ? '-' : '+' }}{{ trx.montant|number_format(2, ',', ' ') }} {{ trx.devise }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {% if transactions.pageCount is defined %}
                                <div class="px-4 pb-3">
                                    {{ knp_pagination_render(transactions) }}
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.letter-spacing-lg {
    letter-spacing: 2px;
}
</style>
{% endblock %}
