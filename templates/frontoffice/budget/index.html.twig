{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Budgets{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">Mes Budgets</h1>
                <p class="text-muted mb-0">Gérez vos limites de dépenses par catégorie.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-info btn-lg rounded-pill shadow-sm px-4" id="ai-advice-btn">
                    <i class="fas fa-magic me-2"></i> Conseiller IA
                </button>
                <a href="{{ path('bundle_index') }}" class="btn btn-outline-success btn-lg rounded-pill shadow-sm px-4">
                    <i class="fas fa-tractor me-2"></i> Faire la Moisson
                </a>
                <a href="{{ path('budget_new') }}" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                    <i class="fas fa-plus me-2"></i> Nouveau Budget
                </a>
            </div>
        </div>

        <div class="row g-4">
            {% for budget in budgets %}
                {% set progress = budget.montant_total > 0 ? (budget.total_depense / budget.montant_total * 100) : 0 %}
                {% set progress_capped = progress > 100 ? 100 : progress %}
                {% set progress_color = progress > 90 ? 'danger' : (progress > 70 ? 'warning' : 'success') %}
                
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                                    <i class="fas fa-wallet text-primary fa-lg"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                        <li><a class="dropdown-item py-2" href="{{ path('budget_show', {id: budget.id_budget}) }}" title="Voir détails"><i class="fas fa-fw fa-eye text-primary"></i><span class="visually-hidden">Voir détails</span></a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('budget_edit', {id: budget.id_budget}) }}" title="Modifier"><i class="fas fa-fw fa-pen text-warning"></i><span class="visually-hidden">Modifier</span></a></li>
                                    </ul>
                                </div>
                            </div>

                            <h5 class="card-title fw-bold mb-1">{{ budget.nom_budget }}</h5>
                            <p class="text-muted small mb-4">{{ budget.periode|capitalize }}</p>

                            <div class="d-flex justify-content-between align-items-end mb-2">
                                <span class="text-muted small">Progression</span>
                                <span class="fw-bold {{ progress > 100 ? 'text-danger' : '' }}">{{ progress|number_format(0) }}%</span>
                            </div>
                            <div class="progress mb-4" style="height: 8px;">
                                <div class="progress-bar bg-{{ progress_color }} rounded-pill" role="progressbar" style="width: {{ progress_capped }}%"></div>
                            </div>

                            <div class="row g-0 py-3 border-top mt-auto">
                                <div class="col-6 border-end">
                                    <div class="small text-muted mb-1">Dépensé</div>
                                    <div class="fw-bold text-dark">{{ budget.total_depense|number_format(2, ',', ' ') }} TND</div>
                                </div>
                                <div class="col-6 ps-3">
                                    <div class="small text-muted mb-1">Limite</div>
                                    <div class="fw-bold text-primary">{{ budget.montant_total|number_format(2, ',', ' ') }} TND</div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">
                            <div class="d-flex justify-content-center">
                                <a href="{{ path('budget_show', {id: budget.id_budget}) }}" class="btn btn-sm btn-outline-primary btn-action-icon" title="Détails du budget"><i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Détails du budget</span></a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <div class="bg-white p-5 rounded-4 shadow-sm d-inline-block">
                        <i class="fas fa-piggy-bank fa-4x text-light mb-4 d-block"></i>
                        <h3 class="fw-bold">Aucun budget pour le moment</h3>
                        <p class="text-muted mb-4">Commencez par créer un budget pour mieux gérer vos finances.</p>
                        <a href="{{ path('budget_new') }}" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">
                            Créer mon premier budget
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- AI Advice Modal -->
<div class="modal fade" id="aiAdviceModal" tabindex="-1" aria-labelledby="aiAdviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-info text-white py-4 px-4 border-0">
                <h5 class="modal-title fw-bold" id="aiAdviceModalLabel">
                    <i class="fas fa-robot me-2"></i> Conseils Personnalisés de FinTrack AI
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white" id="ai-advice-content">
                <div class="text-center py-5" id="ai-loading">
                    <div class="spinner-border text-info mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p class="text-muted fw-bold">Analyse de vos d&eacute;penses et budgets en cours...</p>
                    <p class="small text-muted">Cela peut prendre quelques secondes.</p>
                </div>
                <div id="ai-result" class="d-none">
                    <div class="ai-advice-text">
                        <!-- Content injected by JS -->
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light p-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const adviceBtn = document.getElementById('ai-advice-btn');
        const adviceModalEl = document.getElementById('aiAdviceModal');
        const adviceContent = document.getElementById('ai-result');
        const loadingSpinner = document.getElementById('ai-loading');
        
        if (adviceBtn && adviceModalEl) {
            const adviceModal = new bootstrap.Modal(adviceModalEl);
            
            adviceBtn.addEventListener('click', function () {
                adviceModal.show();
                adviceContent.classList.add('d-none');
                loadingSpinner.classList.remove('d-none');

                fetch("{{ path('depense_ai_advice') }}", {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Erreur serveur');
                    return response.json();
                })
                .then(data => {
                    loadingSpinner.classList.add('d-none');
                    adviceContent.classList.remove('d-none');
                    
                    if (data.advice) {
                        // Utilisation de marked pour le rendu markdown
                        const aiTextDiv = adviceContent.querySelector('.ai-advice-text');
                        aiTextDiv.innerHTML = marked.parse(data.advice);
                    } else {
                        adviceContent.innerHTML = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i> ' + (data.error || 'Impossible de g&eacute;n&eacute;rer des conseils.') + '</div>';
                    }
                })
                .catch(error => {
                    loadingSpinner.classList.add('d-none');
                    adviceContent.classList.remove('d-none');
                    adviceContent.innerHTML = '<div class="alert alert-danger"><i class="fas fa-times-circle me-2"></i> Erreur lors de la communication avec l\'IA.</div>';
                });
            });
        }
    });
</script>

<style>
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
    }
</style>
{% endblock %}
