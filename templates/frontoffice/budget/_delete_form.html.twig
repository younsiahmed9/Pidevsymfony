<form method="post" action="{{ path('budget_delete', {'id': budget.id_budget}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce budget ? Cette action est irréversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ budget.id_budget) }}">
    <button class="btn btn-outline-danger btn-sm rounded-pill px-3">
        <i class="fas fa-trash-alt me-1"></i> Supprimer le budget
    </button>
</form>
