{% extends 'frontoffice/base.html.twig' %}

{% block title %}Panier - FinTrack{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">Mon Panier</h1>
                <p class="text-muted mb-0">Retrouvez ici vos articles avant validation de commande.</p>
            </div>
        </div>

        <!-- Panier Vide -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-5 text-center">
                <div class="bg-light d-inline-block p-4 rounded-circle mb-3">
                    <i class="fas fa-shopping-cart fa-3x text-muted opacity-50"></i>
                </div>
                <h5 class="fw-bold">Votre panier est vide</h5>
                <p class="text-muted mb-4">Ajoutez des produits à votre panier pour poursuivre vos achats.</p>
                <a href="{{ path('produit_index') }}" class="btn btn-primary rounded-pill px-5">
                    <i class="fas fa-shopping-bag me-2"></i> Parcourir les produits
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
