{% extends 'frontoffice/base.html.twig' %}

{% block title %}Liste des Produits{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📦 Liste des Produits</h1>
        <a href="{{ path('front_produit_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouveau Produit
        </a>
    </div>

    {# MESSAGES FLASH #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Montant</th>
                        <th>Code</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for produit in produits %}
                    <tr>
                        <td>{{ produit.id }}</td>
                        <td class="fw-bold">{{ produit.nomProduit }}</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                {{ produit.typeProduit|replace({'_': ' '})|capitalize }}
                            </span>
                        </td>
                        <td class="fw-bold text-primary">{{ produit.montant }} DT</td>
                        <td><code>{{ produit.codeUnique }}</code></td>
                        <td>
                            <span class="badge bg-{{ produit.statut == 'disponible' ? 'success' : (produit.statut == 'vendu' ? 'warning' : 'danger') }}">
                                {{ produit.statut|capitalize }}
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('front_produit_show', {id: produit.id}) }}" class="btn btn-outline-secondary" title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('front_produit_edit', {id: produit.id}) }}" class="btn btn-outline-warning" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="POST" action="{{ path('front_produit_delete', {id: produit.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir archiver ce produit ?')" style="display: inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                    <button class="btn btn-outline-danger" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            Aucun produit trouvé.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
