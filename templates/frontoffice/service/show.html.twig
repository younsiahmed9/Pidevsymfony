{% extends 'frontoffice/base.html.twig' %}

{% block title %}Service: {{ service.nomService }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1 class="mb-4">{{ service.nomService }}</h1>
            
            <div class="card shadow-sm">
                <div class="card-header bg-{{ service.statut == 'actif' ? 'success' : (service.statut == 'suspendu' ? 'warning' : 'danger') }} text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Détails du Service</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th class="text-muted" style="width: 200px;">ID:</th>
                            <td class="fw-bold">#{{ service.id }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Nom:</th>
                            <td class="fw-bold">{{ service.nomService }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Type:</th>
                            <td><span class="badge bg-light text-dark border">{{ service.typeService|capitalize }}</span></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Tarif:</th>
                            <td class="text-primary h5 fw-bold">${{ service.tarif }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Fréquence:</th>
                            <td>{{ service.frequence|capitalize|default('-') }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Date Début:</th>
                            <td><i class="far fa-calendar-alt me-1 text-muted"></i> {{ service.dateDebut ? service.dateDebut|date('d/m/Y') : '-' }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Date Fin:</th>
                            <td><i class="far fa-calendar-alt me-1 text-muted"></i> {{ service.dateFin ? service.dateFin|date('d/m/Y') : '-' }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Durée:</th>
                            <td><span class="badge bg-info-subtle text-info"><i class="far fa-clock me-1"></i> {{ service.calculateDuration() ?? '-' }} jours</span></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Statut:</th>
                            <td>
                                <span class="badge bg-{{ service.statut == 'actif' ? 'success' : (service.statut == 'suspendu' ? 'warning' : 'danger') }}-subtle text-{{ service.statut == 'actif' ? 'success' : (service.statut == 'suspendu' ? 'warning' : 'danger') }} border border-{{ service.statut == 'actif' ? 'success' : (service.statut == 'suspendu' ? 'warning' : 'danger') }}">
                                    {{ service.statut|upper }}
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <a href="{{ path('front_service_edit', {id: service.id}) }}" class="btn btn-warning flex-grow-1">✏️ Modifier</a>
                <form method="POST" action="{{ path('front_service_delete', {id: service.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce service ? Cette action est irréversible.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                    <button class="btn btn-danger">🗑️ Supprimer</button>
                </form>
                <a href="{{ path('front_service_index') }}" class="btn btn-secondary">← Retour</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
