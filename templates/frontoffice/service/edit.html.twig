{% extends 'frontoffice/base.html.twig' %}

{% block title %}Modifier Service: {{ service.nomService }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4">✏️ Modifier {{ service.nomService }}</h1>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            
            <div class="form-group mb-3">
                {{ form_label(form.nomService) }}
                {{ form_widget(form.nomService, {'attr': {'class': 'form-control'}}) }}
                <div class="text-danger small mt-1">
                    {{ form_errors(form.nomService) }}
                </div>
            </div>

            <div class="form-group mb-3">
                {{ form_label(form.typeService) }}
                {{ form_widget(form.typeService, {'attr': {'class': 'form-control'}}) }}
                <div class="text-danger small mt-1">
                    {{ form_errors(form.typeService) }}
                </div>
            </div>

            <div class="form-group mb-3">
                {{ form_label(form.tarif) }}
                {{ form_widget(form.tarif, {'attr': {'class': 'form-control'}}) }}
                <div class="text-danger small mt-1">
                    {{ form_errors(form.tarif) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        {{ form_label(form.frequence) }}
                        {{ form_widget(form.frequence, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger small mt-1">
                            {{ form_errors(form.frequence) }}
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        {{ form_label(form.dateDebut) }}
                        {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger small mt-1">
                            {{ form_errors(form.dateDebut) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        {{ form_label(form.dateFin) }}
                        {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger small mt-1">
                            {{ form_errors(form.dateFin) }}
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        {{ form_label(form.statut) }}
                        {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger small mt-1">
                            {{ form_errors(form.statut) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4 rounded-pill">
                    <i class="fas fa-save me-1"></i>Enregistrer
                </button>
                <a href="{{ path('front_service_index') }}" class="btn btn-outline-secondary px-4 rounded-pill">
                    <i class="fas fa-arrow-left me-1"></i>Retour
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
