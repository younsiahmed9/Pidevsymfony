<form method="post" action="{{ path('depense_delete', {'id': depense.id_depense}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette dépense ? Cette action est irréversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depense.id_depense) }}">
    <button type="submit" class="btn btn-outline-danger btn-sm btn-action-icon btn-sm" title="Supprimer la dépense">
        <i class="fas fa-trash-alt" aria-hidden="true"></i><span class="visually-hidden">Supprimer la dépense</span>
    </button>
</form>
