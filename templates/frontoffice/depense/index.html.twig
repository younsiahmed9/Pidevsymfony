{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Dépenses - FinTrack{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">Mes Dépenses</h1>
                <p class="text-muted mb-0">Gardez un œil sur chaque dépense effectuée.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-info btn-lg rounded-pill shadow-sm px-4" id="ai-advice-btn">
                    <i class="fas fa-magic me-2"></i> Conseiller IA
                </button>
                <a href="{{ path('bundle_index') }}" class="btn btn-outline-success btn-lg rounded-pill shadow-sm px-4">
                    <i class="fas fa-tractor me-2"></i> Faire la Moisson
                </a>
                <a href="{{ path('depense_new') }}" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                    <i class="fas fa-plus me-2"></i> Enregistrer une dépense
                </a>
            </div>
        </div>

        <!-- Summary Statistics -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle d-inline-block mx-auto mb-3">
                        <i class="fas fa-coins text-danger fa-2x"></i>
                    </div>
                    <h6 class="text-muted small text-uppercase fw-bold">Dépenses Totales</h6>
                    <p class="h3 fw-bold text-dark mb-0">{{ totalAmount|number_format(2, ',', ' ') }} TND</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-inline-block mx-auto mb-3">
                        <i class="fas fa-receipt text-primary fa-2x"></i>
                    </div>
                    <h6 class="text-muted small text-uppercase fw-bold">Nombre de dépenses</h6>
                    <p class="h3 fw-bold text-dark mb-0">{{ depenses|length }}</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle d-inline-block mx-auto mb-3">
                        <i class="fas fa-calendar-check text-success fa-2x"></i>
                    </div>
                    <h6 class="text-muted small text-uppercase fw-bold">Moyenne mensuelle</h6>
                    <p class="h3 fw-bold text-dark mb-0">{{ avgAmount|number_format(2, ',', ' ') }} TND</p>
                </div>
            </div>
        </div>

        <!-- Transactions Table -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Toutes les transactions</h5>
            </div>
            <div class="card-body p-0">
                {% if depenses is empty %}
                    <div class="text-center py-5">
                        <div class="bg-light d-inline-block p-4 rounded-circle mb-3">
                            <i class="fas fa-receipt fa-3x text-muted opacity-50"></i>
                        </div>
                        <h5 class="fw-bold">Aucune dépense enregistrée</h5>
                        <p class="text-muted mb-4">Commencez par ajouter votre première dépense.</p>
                        <a href="{{ path('depense_new') }}" class="btn btn-primary rounded-pill px-5">Ajouter une dépense</a>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 border-0">Date</th>
                                    <th class="border-0">Catégorie</th>
                                    <th class="border-0">Budget associé</th>
                                    <th class="border-0 text-end">Montant</th>
                                    <th class="border-0 text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for depense in depenses %}
                                    <tr class="pointer-event" onclick="window.location='{{ path('depense_show', {id: depense.id_depense}) }}'">
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">{{ depense.date_depense|date('d M Y') }}</div>
                                            <div class="small text-muted">{{ depense.mode_paiement|capitalize }}</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-3 rounded-pill">{{ depense.categorie }}</span>
                                        </td>
                                        <td>
                                            {% if depense.nom_budget %}
                                                <span class="text-primary fw-bold"><i class="fas fa-wallet me-1 small"></i> {{ depense.nom_budget }}</span>
                                            {% else %}
                                                <span class="text-muted small">Libre</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end fw-bold text-danger pe-4">
                                            -{{ depense.montant|number_format(2, ',', ' ') }} TND
                                        </td>
                                        <td class="text-center">
                                            <div class="dropdown">
                                                <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" onclick="event.stopPropagation()">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                                    <li><a class="dropdown-item" href="{{ path('depense_show', {id: depense.id_depense}) }}"><i class="fas fa-eye me-2 text-primary"></i> Voir</a></li>
                                                    <li><a class="dropdown-item" href="{{ path('depense_edit', {id: depense.id_depense}) }}"><i class="fas fa-edit me-2 text-warning"></i> Modifier</a></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>

</style>

<!-- AI Advice Modal -->
<div class="modal fade" id="aiAdviceModal" tabindex="-1" aria-labelledby="aiAdviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-info text-white py-4 px-4 border-0">
                <h5 class="modal-title fw-bold" id="aiAdviceModalLabel">
                    <i class="fas fa-robot me-2"></i> Conseils Personnalisés de FinTrack AI
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white" id="ai-advice-content">
                <div class="text-center py-5" id="ai-loading">
                    <div class="spinner-border text-info mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p class="text-muted fw-bold">Analyse de vos dépenses et budgets en cours...</p>
                    <p class="small text-muted">Cela peut prendre quelques secondes.</p>
                </div>
                <div id="ai-result" class="d-none">
                    <div class="ai-advice-text">
                        <!-- Content injected by JS -->
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light p-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const adviceBtn = document.getElementById('ai-advice-btn');
        const adviceModalEl = document.getElementById('aiAdviceModal');
        const adviceContent = document.getElementById('ai-result');
        const loadingSpinner = document.getElementById('ai-loading');
        
        if (adviceBtn && adviceModalEl) {
            const adviceModal = new bootstrap.Modal(adviceModalEl);
            
            adviceBtn.addEventListener('click', function () {
                adviceModal.show();
                adviceContent.classList.add('d-none');
                loadingSpinner.classList.remove('d-none');

                fetch("{{ path('depense_ai_advice') }}", {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Erreur serveur');
                    return response.json();
                })
                .then(data => {
                    loadingSpinner.classList.add('d-none');
                    adviceContent.classList.remove('d-none');
                    
                    if (data.advice) {
                        // Utilisation de marked pour le rendu markdown
                        const aiTextDiv = adviceContent.querySelector('.ai-advice-text');
                        aiTextDiv.innerHTML = marked.parse(data.advice);
                    } else {
                        adviceContent.innerHTML = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i> ' + (data.error || 'Impossible de générer des conseils.') + '</div>';
                    }
                })
                .catch(error => {
                    loadingSpinner.classList.add('d-none');
                    adviceContent.classList.remove('d-none');
                    adviceContent.innerHTML = '<div class="alert alert-danger"><i class="fas fa-times-circle me-2"></i> Une erreur est survenue lors de la connexion au conseiller IA.</div>';
                });
            });
        }
    });
</script>

<style>
    .ai-advice-text {
        color: #334155;
        line-height: 1.6;
    }
    .ai-advice-text h1, .ai-advice-text h2, .ai-advice-text h3 {
        color: #0ea5e9;
        font-weight: 700;
        margin-top: 1.5rem;
    }
    .ai-advice-text ul {
        padding-left: 1.25rem;
    }
    .ai-advice-text li {
        margin-bottom: 0.5rem;
    }
    .ai-advice-text blockquote {
        border-left: 4px solid #0ea5e9;
        padding-left: 1rem;
        font-style: italic;
        color: #64748b;
        background: #f0f9ff;
        padding: 1rem;
        border-radius: 0 0.5rem 0.5rem 0;
    }
</style>
{% endblock %}
