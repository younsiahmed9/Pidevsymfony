{% extends 'frontoffice/base.html.twig' %}

{% block title %}Mes Comptes - FinTrack{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
            <div>
                <h1 class="h2 fw-bold text-dark mb-1">Mes Comptes Bancaires</h1>
                <p class="text-muted mb-0">Visualisez vos soldes et gérez vos comptes en temps réel.</p>
            </div>
            <a href="{{ path('compte_new') }}" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                <i class="fas fa-plus me-2"></i> Ouvrir un Compte
            </a>
        </div>

        <form method="get" class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4 filter-toolbar">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="q" class="form-label small text-uppercase fw-bold text-muted">Recherche numéro</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text border-0 bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="q" name="q" class="form-control border-0 bg-white" value="{{ filters.q|default('') }}" placeholder="Ex: TN01...">
                    </div>
                </div>
                <div class="col-md-4">
                    <label for="type_compte" class="form-label small text-uppercase fw-bold text-muted">Type de compte</label>
                    <select id="type_compte" name="type_compte" class="form-select form-select-lg border-0 bg-white">
                        <option value="">Tous</option>
                        <option value="courant" {{ filters.type_compte|default('') == 'courant' ? 'selected' : '' }}>Courant</option>
                        <option value="epargne" {{ filters.type_compte|default('') == 'epargne' ? 'selected' : '' }}>Épargne</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Filtrer</button>
                    <a href="{{ path('compte_index') }}" class="btn btn-outline-secondary w-100 rounded-pill">Reset</a>
                </div>
            </div>
        </form>

        <div class="section-header-card courant mb-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-university"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-0">Comptes courants</h2>
                    <p class="text-muted small mb-0">Gestion quotidienne et accès aux demandes de crédit</p>
                </div>
            </div>
            <span class="count-pill">{{ comptesCourants|default([])|length }}</span>
        </div>
        <div class="row g-4 mb-5">
            {% for compte in comptesCourants|default([]) %}
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                                    <i class="fas fa-university text-primary fa-lg"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                        <li><a class="dropdown-item py-2" href="{{ path('compte_show', {id: compte.id}) }}" title="Voir"><i class="fas fa-fw fa-eye text-primary"></i><span class="visually-hidden">Voir</span></a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('compte_edit', {id: compte.id}) }}" title="Modifier"><i class="fas fa-fw fa-pen text-warning"></i><span class="visually-hidden">Modifier</span></a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('credit_index', {compte_id: compte.id}) }}" title="Crédits du compte"><i class="fas fa-fw fa-hand-holding-usd text-info"></i><span class="visually-hidden">Crédits du compte</span></a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('credit_new', {compte_id: compte.id}) }}" title="Demander un crédit"><i class="fas fa-fw fa-plus-circle text-success"></i><span class="visually-hidden">Demander un crédit</span></a></li>
                                    </ul>
                                </div>
                            </div>

                            <h5 class="card-title fw-bold mb-1">{{ compte.numeroCompte }}</h5>
                            <span class="badge bg-light text-dark border px-2 rounded-pill small mb-4 text-uppercase">{{ compte.typeCompte }}</span>

                            <div class="mb-4">
                                <div class="small text-muted text-uppercase fw-bold mb-1">Solde Actuel</div>
                                <div class="h3 fw-bold text-primary mb-0">{{ compte.solde|number_format(2, ',', ' ') }} TND</div>
                            </div>

                            <div class="py-3 border-top d-flex justify-content-between align-items-center">
                                <div class="small text-muted">
                                    <i class="fas fa-calendar-alt me-1"></i> Depuis le {{ compte.dateCreation|date('d/m/Y') }}
                                </div>
                                {% set badge_class = compte.etat == 'actif' ? 'success' : (compte.etat == 'bloque' ? 'danger' : 'secondary') %}
                                <span class="badge rounded-pill bg-{{ badge_class }} px-3">
                                    {{ compte.etat|capitalize }}
                                </span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <a href="{{ path('compte_show', {id: compte.id}) }}" class="btn btn-sm btn-outline-secondary btn-action-icon" title="Détails du compte"><i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Détails du compte</span></a>
                                <a href="{{ path('credit_index', {compte_id: compte.id}) }}" class="btn btn-sm btn-outline-info btn-action-icon" title="Crédits liés"><i class="fas fa-hand-holding-usd" aria-hidden="true"></i><span class="visually-hidden">Crédits liés</span></a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <div class="bg-white p-4 rounded-4 shadow-sm d-inline-block">
                        <h3 class="h6 fw-bold mb-1">Aucun compte courant</h3>
                        <p class="text-muted mb-0">Créez un compte courant pour gérer vos crédits.</p>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="section-header-card epargne mb-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-wrap bg-success bg-opacity-10 text-success">
                    <i class="fas fa-piggy-bank"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-0">Comptes épargne</h2>
                    <p class="text-muted small mb-0">Comptes dédiés à l'accumulation et aux intérêts</p>
                </div>
            </div>
            <span class="count-pill">{{ comptesEpargne|default([])|length }}</span>
        </div>
        <div class="row g-4">
            {% for compte in comptesEpargne|default([]) %}
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-success bg-opacity-10 p-3 rounded-3">
                                    <i class="fas fa-piggy-bank text-success fa-lg"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                        <li><a class="dropdown-item py-2" href="{{ path('compte_show', {id: compte.id}) }}" title="Voir"><i class="fas fa-fw fa-eye text-primary"></i><span class="visually-hidden">Voir</span></a></li>
                                        <li><a class="dropdown-item py-2" href="{{ path('compte_edit', {id: compte.id}) }}" title="Modifier"><i class="fas fa-fw fa-pen text-warning"></i><span class="visually-hidden">Modifier</span></a></li>
                                    </ul>
                                </div>
                            </div>

                            <h5 class="card-title fw-bold mb-1">{{ compte.numeroCompte }}</h5>
                            <span class="badge bg-light text-dark border px-2 rounded-pill small mb-4 text-uppercase">{{ compte.typeCompte }}</span>

                            <div class="mb-4">
                                <div class="small text-muted text-uppercase fw-bold mb-1">Solde Actuel</div>
                                <div class="h3 fw-bold text-success mb-0">{{ compte.solde|number_format(2, ',', ' ') }} TND</div>
                            </div>

                            <div class="py-3 border-top d-flex justify-content-between align-items-center">
                                <div class="small text-muted">
                                    <i class="fas fa-calendar-alt me-1"></i> Depuis le {{ compte.dateCreation|date('d/m/Y') }}
                                </div>
                                {% set badge_class = compte.etat == 'actif' ? 'success' : (compte.etat == 'bloque' ? 'danger' : 'secondary') %}
                                <span class="badge rounded-pill bg-{{ badge_class }} px-3">
                                    {{ compte.etat|capitalize }}
                                </span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">
                            <div class="d-flex justify-content-center">
                                <a href="{{ path('compte_show', {id: compte.id}) }}" class="btn btn-sm btn-outline-secondary btn-action-icon" title="Détails du compte"><i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Détails du compte</span></a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <div class="bg-white p-4 rounded-4 shadow-sm d-inline-block">
                        <h3 class="h6 fw-bold mb-1">Aucun compte épargne</h3>
                        <p class="text-muted mb-0">Vous pouvez créer un compte épargne depuis le bouton d'ouverture.</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<style>
    .filter-toolbar {
        background: linear-gradient(145deg, #f8fafc, #eef4ff);
    }
    .section-header-card {
        background: #ffffff;
        border-radius: 1rem;
        border: 1px solid rgba(15, 23, 42, 0.06);
        padding: 0.9rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .icon-wrap {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }
    .count-pill {
        min-width: 34px;
        height: 34px;
        padding: 0 0.6rem;
        border-radius: 999px;
        background: #f1f5f9;
        color: #0f172a;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
    }
</style>
{% endblock %}
