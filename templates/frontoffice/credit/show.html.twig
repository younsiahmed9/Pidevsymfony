{% extends 'frontoffice/base.html.twig' %}

{% block title %}Détails de mon Crédit - FinTrack{% endblock %}

{% block body %}
<section class="py-5 bg-light min-vh-100">
    <div class="container py-4">
        <!-- Navigation & Actions -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
            <div class="d-flex align-items-center">
                <a href="{{ path('credit_index') }}" class="btn btn-white shadow-sm rounded-circle p-3 me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="h3 fw-bold mb-0">Détails de mon prêt</h1>
                    <p class="text-muted mb-0">Réf: #{{ credit.id }} - Souscrit le {{ credit.dateDebut|date('d/m/Y') }}</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                {% if credit.status == 'en_attente' %}
                    {{ include('frontoffice/credit/_delete_form.html.twig') }}
                {% endif %}
                <button onclick="window.print()" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="fas fa-print me-2"></i> Imprimer l'échéancier
                </button>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left: Financial Overview -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-0">
                        <div class="bg-primary p-5 text-center text-white">
                            <h6 class="text-white-50 small text-uppercase fw-bold mb-2">Montant du Capital</h6>
                            <h2 class="display-4 fw-bold mb-0">{{ credit.montant|number_format(2, ',', ' ') }} TND</h2>
                            <div class="mt-3">
                                {% set badge_class = credit.status == 'approuve' ? 'success' : (credit.status == 'refuse' ? 'danger' : (credit.status == 'en_attente' ? 'warning' : 'info')) %}
                                <span class="badge bg-white text-{{ badge_class }} fs-6 px-4 py-2 rounded-pill">
                                    {{ credit.status|capitalize|replace({'_': ' '}) }}
                                </span>
                            </div>
                        </div>
                        <div class="p-5 bg-white">
                            <div class="row g-4 text-center">
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block mb-1">Mensualité</label>
                                    <span class="h4 fw-bold text-danger">{{ credit.mensualite|number_format(2, ',', ' ') }} TND</span>
                                </div>
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block mb-1">Durée Restante</label>
                                    <span class="h4 fw-bold text-dark">{{ credit.dureeMois }} mois</span>
                                </div>
                                <div class="col-md-4">
                                    <label class="small text-muted text-uppercase fw-bold d-block mb-1">Taux d'intérêt</label>
                                    <span class="h4 fw-bold text-primary">{{ credit.tauxInteret }}%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Simulation Info -->
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-4">Résumé du remboursement</h5>
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle">
                            <tbody>
                                <tr class="border-bottom">
                                    <td class="text-muted py-3">Total des intérêts</td>
                                    {% set total = credit.mensualite * credit.dureeMois %}
                                    <td class="text-end fw-bold py-3">{{ (total - credit.montant)|number_format(2, ',', ' ') }} TND</td>
                                </tr>
                                <tr class="border-bottom">
                                    <td class="text-muted py-3">Coût total du crédit</td>
                                    <td class="text-end fw-bold text-dark py-3">{{ total|number_format(2, ',', ' ') }} TND</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-3">Compte de prélèvement</td>
                                    <td class="text-end fw-bold text-primary py-3">
                                        <i class="fas fa-university me-1"></i> {{ credit.compte.numeroCompte }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right: Support & Tips -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-4 mb-4">
                    <h6 class="fw-bold text-uppercase small text-white-50 mb-3">Besoin d'aide ?</h6>
                    <p class="small mb-4">Une question sur votre crédit ou un changement de situation ? Nos conseillers sont là pour vous.</p>
                    <a href="#" class="btn btn-primary rounded-pill w-100 fw-bold">Contacter un conseiller</a>
                </div>

                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h6 class="fw-bold text-uppercase small text-muted mb-3">Documents utiles</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3">
                            <a href="#" class="text-decoration-none d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3"><i class="fas fa-file-pdf text-danger"></i></div>
                                <span class="small text-dark fw-bold">Conditions Générales</span>
                            </a>
                        </li>
                        <li>
                            <a href="#" class="text-decoration-none d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3"><i class="fas fa-file-invoice-dollar text-primary"></i></div>
                                <span class="small text-dark fw-bold">Tableau d'amortissement</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @media print {
        .btn, .bg-dark, .col-lg-4 { display: none !important; }
        .col-lg-8 { width: 100% !important; }
        .container { max-width: 100% !important; width: 100% !important; }
    }
</style>
{% endblock %}
