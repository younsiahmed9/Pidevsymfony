{% extends 'frontoffice/base.html.twig' %}

{% block title %}Connexion - FinTrack{% endblock %}

{% block body %}
<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                <div class="auth-card">
                    <div class="auth-card-body">
                        <div class="auth-header">
                            <div class="mb-3">
                                <i class="fas fa-chart-line fa-3x text-primary"></i>
                            </div>
                            <h2 class="auth-title">Bon retour !</h2>
                            <p class="auth-subtitle">Connectez-vous à votre espace FinTrack</p>
                        </div>

                        {% if error %}
                            <div class="alert alert-danger border-0 rounded-3 small mb-4">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}

                        <form method="post" action="{{ path('app_login') }}" class="auth-login-form" novalidate>
                            <div class="mb-3">
                                <label for="email" class="form-label">Adresse Email</label>
                                <input type="email" value="{{ last_username|default('') }}" name="email" id="email" class="form-control form-control-lg shadow-none" autocomplete="email" required autofocus placeholder="nom@exemple.com">
                                <div class="text-danger small mt-1" data-error-for="email"></div>
                            </div>
                            
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label for="password" class="form-label mb-0">Mot de passe</label>
                                    <a href="#" class="small auth-link">Oublié ?</a>
                                </div>
                                <input type="password" name="password" id="password" class="form-control form-control-lg shadow-none" autocomplete="current-password" required placeholder="••••••••">
                                    <div class="text-danger small mt-1" data-error-for="password"></div>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <button class="btn btn-auth w-100 mb-3" type="submit">
                                Se connecter
                            </button>

                            <div class="text-center text-muted small mb-3">ou continuez avec</div>

                            <div class="d-grid gap-2 mb-3">
                                <a href="{{ path('connect_google_start') }}" class="btn btn-outline-danger w-100 rounded-3">
                                    <i class="fab fa-google me-2"></i>Continuer avec Google
                                </a>
                                <a href="{{ path('connect_github_start') }}" class="btn btn-outline-dark w-100 rounded-3">
                                    <i class="fab fa-github me-2"></i>Continuer avec GitHub
                                </a>
                                <a href="{{ path('connect_facebook_start') }}" class="btn btn-outline-primary w-100 rounded-3">
                                    <i class="fab fa-facebook-f me-2"></i>Continuer avec Facebook
                                </a>
                            </div>
                            
                            <div class="auth-footer">
                                <p class="mb-0">Nouveau sur FinTrack ? <a href="{{ path('app_register') }}" class="auth-link">Créer un compte</a></p>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a href="{{ path('app_home') }}" class="text-muted text-decoration-none small">
                        <i class="fas fa-arrow-left me-1"></i> Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        var form = document.querySelector('.auth-login-form');
        if (!form) {
            return;
        }

        var showError = function (name, message) {
            var input = form.querySelector('[name="' + name + '"]');
            var errorBox = form.querySelector('[data-error-for="' + name + '"]');
            if (input) {
                input.classList.toggle('is-invalid', !!message);
                input.classList.toggle('is-valid', !message && input.value.trim() !== '');
            }
            if (errorBox) {
                errorBox.textContent = message || '';
            }
        };

        var validate = function () {
            var emailInput = form.querySelector('[name="email"]');
            var passwordInput = form.querySelector('[name="password"]');
            var valid = true;

            if (!emailInput || !emailInput.value.trim()) {
                showError('email', 'L’adresse email est obligatoire.');
                valid = false;
            } else {
                showError('email', '');
            }

            if (!passwordInput || !passwordInput.value.trim()) {
                showError('password', 'Le mot de passe est obligatoire.');
                valid = false;
            } else {
                showError('password', '');
            }

            return valid;
        };

        form.addEventListener('input', function (event) {
            if (event.target && event.target.name) {
                showError(event.target.name, '');
            }
        });

        form.addEventListener('submit', function (event) {
            if (!validate()) {
                event.preventDefault();
            }
        });
    })();
</script>
{% endblock %}
