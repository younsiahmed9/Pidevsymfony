{% extends 'frontoffice/base.html.twig' %}

{% block title %}Connexion - FinTrack{% endblock %}

{% block body %}
<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                <div class="auth-card">
                    <div class="auth-card-body">
                        <div class="auth-header">
                            <div class="mb-3">
                                <i class="fas fa-chart-line fa-3x text-primary"></i>
                            </div>
                            <h2 class="auth-title">Bon retour !</h2>
                            <p class="auth-subtitle">Connectez-vous à votre espace FinTrack</p>
                        </div>

                        {% if error %}
                            <div class="alert alert-danger border-0 rounded-3 small mb-4">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}

                        <form method="post" action="{{ path('app_login') }}" class="auth-login-form" novalidate>
                            <div class="mb-3">
                                <label for="email" class="form-label">Adresse Email</label>
                                <input type="email" value="{{ last_username|default('') }}" name="email" id="email" class="form-control form-control-lg shadow-none" autocomplete="email" required autofocus placeholder="nom@exemple.com">
                                <div class="text-danger small mt-1" data-error-for="email"></div>
                            </div>
                            
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label for="password" class="form-label mb-0">Mot de passe</label>
                                    <a href="#" class="small auth-link">Oublié ?</a>
                                </div>
                                <input type="password" name="password" id="password" class="form-control form-control-lg shadow-none" autocomplete="current-password" required placeholder="••••••••">
                                    <div class="text-danger small mt-1" data-error-for="password"></div>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <button class="btn btn-auth w-100 mb-3" type="submit">
                                Se connecter
                            </button>

                            <button type="button" class="btn btn-outline-dark w-100 mb-3" data-bs-toggle="modal" data-bs-target="#faceIdLoginModal">
                                Se connecter avec Face ID
                            </button>
                            
                            <div class="auth-footer">
                                <p class="mb-0">Nouveau sur FinTrack ? <a href="{{ path('app_register') }}" class="auth-link">Créer un compte</a></p>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a href="{{ path('app_home') }}" class="text-muted text-decoration-none small">
                        <i class="fas fa-arrow-left me-1"></i> Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="faceIdLoginModal" tabindex="-1" aria-labelledby="faceIdLoginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="faceIdLoginModalLabel">Connexion Face ID</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="{{ path('app_face_id_login') }}" data-face-id-form>
                <div class="modal-body">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('face_id_login') }}">
                    <input type="hidden" name="face_descriptor" data-face-id-input>
                    <input type="hidden" name="face_email" data-face-id-email>
                    <div class="ratio ratio-16x9 bg-dark rounded overflow-hidden mb-3">
                        <video class="w-100 h-100" autoplay muted playsinline data-face-id-video></video>
                    </div>
                    <p class="text-muted mb-0" data-face-id-status>Autorisez la camera puis lancez le scan.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary" data-face-id-submit>Scanner et se connecter</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        var form = document.querySelector('.auth-login-form');
        if (!form) {
            return;
        }

        var showError = function (name, message) {
            var input = form.querySelector('[name="' + name + '"]');
            var errorBox = form.querySelector('[data-error-for="' + name + '"]');
            if (input) {
                input.classList.toggle('is-invalid', !!message);
                input.classList.toggle('is-valid', !message && input.value.trim() !== '');
            }
            if (errorBox) {
                errorBox.textContent = message || '';
            }
        };

        var validate = function () {
            var emailInput = form.querySelector('[name="email"]');
            var passwordInput = form.querySelector('[name="password"]');
            var valid = true;

            if (!emailInput || !emailInput.value.trim()) {
                showError('email', 'L’adresse email est obligatoire.');
                valid = false;
            } else {
                showError('email', '');
            }

            if (!passwordInput || !passwordInput.value.trim()) {
                showError('password', 'Le mot de passe est obligatoire.');
                valid = false;
            } else {
                showError('password', '');
            }

            return valid;
        };

        form.addEventListener('input', function (event) {
            if (event.target && event.target.name) {
                showError(event.target.name, '');
            }
        });

        form.addEventListener('submit', function (event) {
            if (!validate()) {
                event.preventDefault();
            }
        });

        var faceEmailInput = document.querySelector('[data-face-id-email]');
        if (faceEmailInput) {
            var syncEmail = function () {
                var currentEmail = (form.querySelector('[name="email"]') || {}).value || '';
                faceEmailInput.value = currentEmail.trim().toLowerCase();
            };

            syncEmail();
            form.querySelector('[name="email"]').addEventListener('input', syncEmail);
            document.getElementById('faceIdLoginModal').addEventListener('show.bs.modal', syncEmail);
        }
    })();
</script>
<script src="{{ asset('frontoffice/js/face-id.js') }}"></script>
{% endblock %}
