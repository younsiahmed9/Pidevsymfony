{% extends "base.html.twig" %}

{% block title %}Forgot Password - FinTrack{% endblock %}

{% block body %}
<section class="section bg-tertiary position-relative overflow-hidden">
    <div class="container">
        <div class="row justify-content-center align-items-start">
            <div class="col-lg-5 mb-5 mb-lg-0">
                <div class="block pe-0 pe-xl-5">
                    <p class="text-primary text-uppercase fw-bold mb-3">Forgot Password</p>
                    <h1 class="mb-4">Reset your password</h1>
                    <p class="mb-4">Enter your email address and we will send you a secure link to create a new password.</p>
                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary">Back to login</a>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="bg-white p-4 p-md-5 shadow-sm">
                    <h2 class="h4 mb-4">Send reset link</h2>
                    <form method="post" action="{{ path('app_forgot_password') }}">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address</label>
                            <input type="email" id="email" name="email" class="form-control shadow-none" required autofocus>
                        </div>
                        <button class="btn btn-primary w-100" type="submit">Send reset link</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
