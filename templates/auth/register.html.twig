{% extends "frontoffice/base.html.twig" %}

{% block title %}Inscription - FinTrack{% endblock %}

{% block body %}
<section class="banner bg-tertiary position-relative overflow-hidden">
	<div class="container">
		<div class="row align-items-center justify-content-center">
			<div class="col-lg-6 mb-5 mb-lg-0">
				<div class="block text-center text-lg-start pe-0 pe-xl-5">
					<p class="text-primary text-uppercase fw-bold mb-3">Inscription</p>
					<h1 class="mb-4">Créez votre compte FinTrack</h1>
					<p class="mb-4">Sélectionnez CLIENT ou ADMIN. Après la soumission, vous recevrez un code de vérification par email. Votre compte n'est créé qu'après la validation du code.</p>
					<a href="{{ path('app_login') }}" class="btn btn-outline-primary">Vous avez déjà un compte ?</a>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="ps-lg-5 text-center">
					<div class="bg-white p-4 p-md-5 shadow-sm rounded h-100">
						<h2 class="h4 mb-4">Créer un compte</h2>
						{{ form_start(form) }}
						<div class="row g-3">
							<div class="col-md-6">
								{{ form_label(form.email, 'Adresse email') }}
								{{ form_widget(form.email, {'attr': {'class': 'form-control shadow-none'}}) }}
								{{ form_errors(form.email) }}
							</div>
							<div class="col-md-6">
								{{ form_label(form.fullName, 'Nom complet') }}
								{{ form_widget(form.fullName, {'attr': {'class': 'form-control shadow-none'}}) }}
								{{ form_errors(form.fullName) }}
							</div>
							<div class="col-md-6">
								{{ form_label(form.plainPassword.first, 'Mot de passe') }}
								{{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control shadow-none'}}) }}
								{{ form_errors(form.plainPassword.first) }}
							</div>
							<div class="col-md-6">
								{{ form_label(form.plainPassword.second, 'Confirmer le mot de passe') }}
								{{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control shadow-none'}}) }}
								{{ form_errors(form.plainPassword.second) }}
							</div>
							<div class="col-md-6">
								{{ form_label(form.roleChoice, 'Type de compte') }}
								{{ form_widget(form.roleChoice, {'attr': {'class': 'form-control shadow-none', 'onchange': 'toggleAdminFields()'}}) }}
								{{ form_errors(form.roleChoice) }}
							</div>
							<div class="col-md-6" id="adminFieldWrap">
								{{ form_label(form.adminCode, 'Code administrateur') }}
								{{ form_widget(form.adminCode, {'attr': {'class': 'form-control shadow-none', 'placeholder': 'Requis pour ADMIN'}}) }}
								{{ form_errors(form.adminCode) }}
							</div>
							<div class="col-md-6" id="cinFieldWrap">
								{{ form_label(form.cin, 'CIN') }}
								{{ form_widget(form.cin, {'attr': {'class': 'form-control shadow-none', 'placeholder': 'Optionnel'}}) }}
							</div>
							<div class="col-md-6" id="phoneFieldWrap">
								{{ form_label(form.phone, 'Téléphone') }}
								{{ form_widget(form.phone, {'attr': {'class': 'form-control shadow-none', 'placeholder': 'Optionnel'}}) }}
							</div>
						</div>
						<div class="mt-4">
							<button class="btn btn-primary w-100" type="submit">Créer un compte</button>
						</div>
						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="has-shapes">
		<svg class="shape shape-left text-light" viewBox="0 0 192 752" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M-30.883 0C-41.3436 36.4248 -22.7145 75.8085 4.29154 102.398C31.2976 128.987 65.8677 146.199 97.6457 166.87C129.424 187.542 160.139 213.902 172.162 249.847C193.542 313.799 149.886 378.897 129.069 443.036C97.5623 540.079 122.109 653.229 191 728.495" stroke="currentColor" stroke-miterlimit="10" /><path d="M-55.5959 7.52271C-66.0565 43.9475 -47.4274 83.3312 -20.4214 109.92C6.58466 136.51 41.1549 153.722 72.9328 174.393C104.711 195.064 135.426 221.425 147.449 257.37C168.829 321.322 125.174 386.42 104.356 450.559C72.8494 547.601 97.3965 660.752 166.287 736.018" stroke="currentColor" stroke-miterlimit="10" /></svg>
		<svg class="shape shape-right text-light" viewBox="0 0 731 746" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.1794 745.14C1.80036 707.275 -5.75764 666.015 8.73984 629.537C27.748 581.745 80.4729 554.968 131.538 548.843C182.604 542.703 234.032 552.841 285.323 556.748C336.615 560.64 391.543 557.276 433.828 527.964C492.452 487.323 511.701 408.123 564.607 360.255C608.718 320.353 675.307 307.183 731.29 327.323" stroke="currentColor" stroke-miterlimit="10" /></svg>
	</div>
</section>

<script>
function toggleAdminFields() {
    const roleChoiceElement = document.getElementById('{{ form.roleChoice.vars.id }}');
    const adminFieldWrap = document.getElementById('adminFieldWrap');
    const cinFieldWrap = document.getElementById('cinFieldWrap');
    const phoneFieldWrap = document.getElementById('phoneFieldWrap');

    if (!roleChoiceElement) {
        return;
    }

    const isAdmin = roleChoiceElement.value === 'ADMIN';
    adminFieldWrap.style.display = isAdmin ? 'block' : 'none';
    cinFieldWrap.style.display = isAdmin ? 'none' : 'block';
    phoneFieldWrap.style.display = isAdmin ? 'none' : 'block';
}

document.addEventListener('DOMContentLoaded', toggleAdminFields);
</script>
{% endblock %}
