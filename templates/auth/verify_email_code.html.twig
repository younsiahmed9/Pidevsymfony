{% extends "base.html.twig" %}

{% block title %}Email Verification - FinTrack{% endblock %}

{% block body %}
<section class="section bg-tertiary position-relative overflow-hidden">
    <div class="container">
        <div class="row justify-content-center align-items-start">
            <div class="col-lg-5 mb-5 mb-lg-0">
                <div class="block pe-0 pe-xl-5">
                    <p class="text-primary text-uppercase fw-bold mb-3">Verify Email</p>
                    <h1 class="mb-4">Confirm your registration</h1>
                    <p class="mb-4">We sent a 6-digit code to {{ pendingEmail }}. Enter it below to finalize your account.</p>
                    <a href="{{ path('app_register') }}" class="btn btn-outline-primary">Back to register</a>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="bg-white p-4 p-md-5 shadow-sm">
                    <h2 class="h4 mb-2">Verification code</h2>
                    <p class="text-muted mb-4">Code expires in about {{ minutesLeft }} minute(s).</p>

                    <form method="post" action="{{ path('app_register_verify_code') }}">
                        <div class="mb-3">
                            <label for="verification_code" class="form-label">6-digit code</label>
                            <input
                                type="text"
                                id="verification_code"
                                name="verification_code"
                                class="form-control shadow-none"
                                maxlength="6"
                                pattern="[0-9]{6}"
                                autocomplete="one-time-code"
                                inputmode="numeric"
                                placeholder="123456"
                                required
                            >
                        </div>
                        <button class="btn btn-primary w-100" type="submit">Verify and continue</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
