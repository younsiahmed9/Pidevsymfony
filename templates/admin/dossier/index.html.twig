{% extends 'admin/base.html.twig' %}
{% block title %}Dossiers - Admin FinTrack{% endblock %}
{% block page_title %}Gestion des Dossiers{% endblock %}
{% block page_subtitle %}{{ dossiers|length }} dossier(s){% endblock %}

{% block content %}
<div class="form-card mb-4">
    <form method="GET" action="{{ path('admin_dossier_index') }}" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label small fw-medium">Recherche</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                <input type="text" name="q" value="{{ q }}" class="form-control" placeholder="Nom du dossier, utilisateur, description...">
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2 align-items-end">
            <button type="submit" class="btn flex-fill" style="background:#f97316;color:#fff;border-color:#f97316;"><i class="fas fa-filter"></i> Rechercher</button>
            <a href="{{ path('admin_dossier_index') }}" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">{{ dossiers|length }} resultat(s)</span>
    <a href="{{ path('admin_dossier_new') }}" class="btn-primary-custom"><i class="fas fa-plus"></i> Nouveau dossier</a>
</div>

<div class="row g-4">
    {% for dossier in dossiers %}
    <div class="col-md-4">
        <div class="form-card h-100">
            <div class="d-flex align-items-center mb-3">
                <div class="stat-icon me-3" style="background:#fff7ed;min-width:48px;">
                    <i class="fas fa-folder" style="color:#f97316;"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-0 fw-semibold">{{ dossier.nomDossier }}</h6>
                    <small class="text-muted">{{ dossier.utilisateur }}</small>
                </div>
            </div>
            {% if dossier.description %}
            <p class="text-muted small mb-3">{{ dossier.description|slice(0, 100) }}{% if dossier.description|length > 100 %}...{% endif %}</p>
            {% endif %}
            <div class="d-flex align-items-center justify-content-between mt-auto">
                <span class="badge bg-light text-dark"><i class="fas fa-file me-1"></i>{{ dossier.documents|length }} document(s)</span>
                <div class="d-flex gap-1">
                    <a href="{{ path('admin_dossier_show', {id: dossier.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                    <a href="{{ path('admin_dossier_edit', {id: dossier.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                    <form action="{{ path('admin_dossier_delete', {id: dossier.id}) }}" method="post" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dossier.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            <small class="text-muted d-block mt-2">Cree le {{ dossier.createdAt|date('d/m/Y') }}</small>
        </div>
    </div>
    {% else %}
    <div class="col-12">
        <div class="text-center py-5 text-muted">
            <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-25"></i>
            Aucun dossier trouve
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}