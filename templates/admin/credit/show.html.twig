{% extends 'admin/base.html.twig' %}
{% block title %}Crédit #{{ credit.id }} - Admin FinTrack{% endblock %}
{% block page_title %}Détail du Crédit{% endblock %}
{% block page_subtitle %}#{{ credit.id }}{% endblock %}

{% block content %}
<div class="d-flex gap-2 mb-4">
    <a href="{{ path('admin_credit_index') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Retour</a>
    <a href="{{ path('admin_credit_edit', {id: credit.id}) }}" class="btn-primary-custom"><i class="fas fa-edit"></i> Modifier</a>
    <form action="{{ path('admin_credit_delete', {id: credit.id}) }}" method="post" onsubmit="return confirm('Supprimer ce crédit ?')">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ credit.id) }}">
        <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash me-1"></i>Supprimer</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="form-card">
            <h6 class="fw-semibold mb-4 pb-2 border-bottom">Informations du crédit</h6>
            <div class="row g-3">
                <div class="col-md-6"><label class="text-muted small">Compte</label><div class="fw-semibold">{{ credit.compte }}</div></div>
                <div class="col-md-6"><label class="text-muted small">Statut</label><div><span class="badge {{ credit.status == 'approuve' ? 'bg-success' : (credit.status == 'refuse' ? 'bg-danger' : (credit.status == 'rembourse' ? 'bg-info' : 'bg-warning text-dark')) }}">{{ credit.status|replace({'_': ' '}) }}</span></div></div>
                <div class="col-md-6"><label class="text-muted small">Montant</label><div class="fw-bold fs-5" style="color:#f97316;">{{ credit.montant|number_format(2, ',', ' ') }} DT</div></div>
                <div class="col-md-6"><label class="text-muted small">Mensualité calculée</label><div class="fw-bold fs-5" style="color:#16a34a;">{{ credit.mensualite ? credit.mensualite|number_format(2, ',', ' ')~' DT' : '—' }}</div></div>
                <div class="col-md-6"><label class="text-muted small">Taux d'intérêt</label><div class="fw-semibold">{{ credit.tauxInteret }}%</div></div>
                <div class="col-md-6"><label class="text-muted small">Durée</label><div class="fw-semibold">{{ credit.dureeMois }} mois</div></div>
                <div class="col-md-6"><label class="text-muted small">Date de début</label><div class="fw-semibold">{{ credit.dateDebut|date('d/m/Y') }}</div></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-card">
            <h6 class="fw-semibold mb-3 pb-2 border-bottom">Résumé</h6>
            {% if credit.mensualite %}
            {% set totalRembourse = credit.mensualite * credit.dureeMois %}
            <div class="mb-2"><label class="text-muted small">Coût total des intérêts</label><div class="fw-semibold text-danger">+{{ (totalRembourse - credit.montant)|number_format(2, ',', ' ') }} DT</div></div>
            <div class="mb-2"><label class="text-muted small">Total remboursé</label><div class="fw-semibold">{{ totalRembourse|number_format(2, ',', ' ') }} DT</div></div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
