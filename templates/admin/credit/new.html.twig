{% extends 'admin/base.html.twig' %}
{% block title %}Nouveau Crédit - Admin FinTrack{% endblock %}
{% block page_title %}Nouveau Crédit{% endblock %}
{% block page_subtitle %}Créer une demande de crédit{% endblock %}

{% block content %}
<div class="mb-4"><a href="{{ path('admin_credit_index') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Retour</a></div>
<div class="row"><div class="col-md-8">
    <div class="form-card">
        <h6 class="fw-semibold mb-4 pb-2 border-bottom">Informations du crédit</h6>
        {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-md-12"><div class="mb-3">{{ form_label(form.compte, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.compte) }}{{ form_errors(form.compte) }}</div></div>
            <div class="col-md-6"><div class="mb-3">{{ form_label(form.montant, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.montant) }}{{ form_errors(form.montant) }}</div></div>
            <div class="col-md-6"><div class="mb-3">{{ form_label(form.tauxInteret, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.tauxInteret) }}{{ form_errors(form.tauxInteret) }}</div></div>
            <div class="col-md-6"><div class="mb-3">{{ form_label(form.dureeMois, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.dureeMois) }}{{ form_errors(form.dureeMois) }}</div></div>
            <div class="col-md-6"><div class="mb-3">{{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.dateDebut) }}{{ form_errors(form.dateDebut) }}</div></div>
            <div class="col-md-6"><div class="mb-3">{{ form_label(form.status, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}{{ form_widget(form.status) }}{{ form_errors(form.status) }}</div></div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn-primary-custom"><i class="fas fa-save"></i> Créer le crédit</button>
            <a href="{{ path('admin_credit_index') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div></div>
{% endblock %}
