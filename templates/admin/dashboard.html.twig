{% extends "base.html.twig" %}

{% block title %}Admin Dashboard - FinTrack{% endblock %}

{% block footer %}{% endblock %}

{% block stylesheets %}
<style>
    .admin-page {
        min-height: calc(100vh - 145px);
        overflow: visible;
        padding-bottom: 2rem;
    }

    .admin-layout {
        align-items: stretch;
        min-height: 100%;
    }

    .admin-sidebar {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 12px 28px rgba(17, 24, 39, 0.08);
        height: auto;
        overflow: hidden;
        background: linear-gradient(180deg, #071a34 0%, #0b2347 100%);
    }

    .admin-sidebar .card-body {
        height: 100%;
        overflow-y: auto;
        padding: 1rem;
    }

    .admin-menu-nav {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .admin-menu-group-title {
        color: #8fa9d6;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        margin: 0 0 0.6rem;
    }

    .admin-menu-divider {
        border-color: rgba(255, 255, 255, 0.08);
        margin: 1rem 0;
    }

    .admin-menu-btn {
        text-align: left;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        background: rgba(255, 255, 255, 0.04);
        color: #d6e4ff;
        font-weight: 600;
        transition: all 0.2s ease;
        width: 100%;
    }

    .admin-menu-btn.active,
    .admin-menu-btn:hover {
        background: #1f4fa1;
        border-color: #5f8fe4;
        color: #fff;
    }

    .admin-site-link {
        display: block;
        width: 100%;
        text-align: left;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        background: rgba(255, 255, 255, 0.03);
        color: #d6e4ff;
        font-weight: 600;
        transition: all 0.2s ease;
        margin-bottom: 0.6rem;
    }

    .admin-site-link:hover {
        background: #173969;
        color: #fff;
        border-color: #5f8fe4;
    }

    .admin-content {
        height: auto;
        overflow: visible;
        padding-right: 0.35rem;
    }

    .chart-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 12px 28px rgba(17, 24, 39, 0.08);
        height: 100%;
    }

    .chart-card .card-header {
        background: #f7f9fc;
        border-bottom: 1px solid #e8edf5;
        font-weight: 700;
    }

    .chart-wrap {
        position: relative;
        min-height: 280px;
    }

    .actions-cell {
        min-width: 220px;
        white-space: nowrap;
    }

    .action-inline-form {
        display: inline;
    }

    .users-board {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 14px 35px rgba(17, 24, 39, 0.08);
        background: #ffffff;
    }

    .users-board-header {
        background: linear-gradient(120deg, #123a7b 0%, #2258a8 100%);
        color: #fff;
        padding: 1rem 1.25rem;
    }

    .users-board-title {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .users-count-badge {
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.35);
        color: #fff;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
    }

    .users-table {
        margin-bottom: 0;
    }

    .users-table thead th {
        background: #f7f9fc;
        color: #2f3f5a;
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-weight: 700;
        border-bottom: 1px solid #e8edf5;
        white-space: nowrap;
        padding: 0.85rem 0.85rem;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .users-table tbody td {
        border-bottom: 1px solid #eef2f8;
        padding: 0.85rem 0.85rem;
        vertical-align: middle;
    }

    .users-table tbody tr:hover {
        background: #f9fbff;
    }

    .user-id-pill {
        display: inline-block;
        min-width: 36px;
        text-align: center;
        border-radius: 999px;
        padding: 0.2rem 0.55rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: #1e3a5f;
        background: #e8f1ff;
    }

    .avatar-chip {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e3ebf8;
        box-shadow: 0 2px 8px rgba(13, 34, 66, 0.08);
    }

    .avatar-fallback {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #eef3ff;
        color: #264472;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #e3ebf8;
    }

    .name-cell {
        line-height: 1.15;
    }

    .name-main {
        font-weight: 600;
        color: #1f2e49;
    }

    .name-sub {
        color: #7083a0;
        font-size: 0.78rem;
    }

    .role-chip,
    .status-chip {
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .role-admin {
        background: #fff1bf;
        color: #7b5a00;
    }

    .role-client {
        background: #d7efff;
        color: #0d4c73;
    }

    .status-active {
        background: #d9f6e6;
        color: #0f6a40;
    }

    .status-inactive {
        background: #ffe0e0;
        color: #8a1f1f;
    }

    .date-cell {
        color: #5f7190;
        font-size: 0.82rem;
        white-space: nowrap;
    }

    .users-table-wrap {
        max-height: 52vh;
        overflow: auto;
    }

    @media (max-width: 991.98px) {
        .admin-page {
            height: auto;
            overflow: visible;
        }

        .admin-sidebar {
            height: auto;
        }

        .admin-menu-nav {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .admin-menu-btn {
            width: auto;
            border-radius: 999px;
            background: #f5f8ff;
            color: #24416b;
            border-color: #d9e2f2;
        }

        .admin-content {
            height: auto;
            overflow: visible;
            padding-right: 0;
        }

        .users-table-wrap {
            max-height: none;
        }

        .actions-cell {
            min-width: 170px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4 admin-page">
    <h1 class="mb-3">Admin Dashboard</h1>

    <div class="row g-4 admin-layout">
        <div class="col-lg-3">
            <div class="card admin-sidebar">
                <div class="card-body">
                    <p class="admin-menu-group-title">Admin Menu</p>
                    <div class="admin-menu-nav nav" role="tablist" aria-label="Admin menu tabs">
                        <button class="admin-menu-btn" id="gestion-compte-tab" data-bs-toggle="tab" data-bs-target="#gestion-compte-pane" type="button" role="tab" aria-controls="gestion-compte-pane" aria-selected="false">gestion_compte</button>
                        <button class="admin-menu-btn" id="gestion-depense-tab" data-bs-toggle="tab" data-bs-target="#gestion-depense-pane" type="button" role="tab" aria-controls="gestion-depense-pane" aria-selected="false">gestion_depense</button>
                        <button class="admin-menu-btn" id="gestion-document-tab" data-bs-toggle="tab" data-bs-target="#gestion-document-pane" type="button" role="tab" aria-controls="gestion-document-pane" aria-selected="false">gestion_document</button>
                        <button class="admin-menu-btn" id="gestion-service-produit-tab" data-bs-toggle="tab" data-bs-target="#gestion-service-produit-pane" type="button" role="tab" aria-controls="gestion-service-produit-pane" aria-selected="false">gestion_service_et_produit</button>
                        <button class="admin-menu-btn active" id="gestion-user-tab" data-bs-toggle="tab" data-bs-target="#users-management-pane" type="button" role="tab" aria-controls="users-management-pane" aria-selected="true">gestion_user</button>
                        <button class="admin-menu-btn" id="gestion-portefeuille-tab" data-bs-toggle="tab" data-bs-target="#gestion-portefeuille-pane" type="button" role="tab" aria-controls="gestion-portefeuille-pane" aria-selected="false">gestion-portefeuille</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content admin-content">
                <div class="tab-pane fade show active" id="users-management-pane" role="tabpanel" aria-labelledby="gestion-user-tab">
                    <div class="alert alert-info">
                        <strong>Users Management</strong> - All user statistics and management data are available below.
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="card text-white bg-primary">
                                <div class="card-body">
                                    <h5 class="card-title">Total Users</h5>
                                    <p class="card-text display-6">{{ stats.totalUsers }}</p>
                                    <p class="card-text small">System wide</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <div class="card text-white bg-success">
                                <div class="card-body">
                                    <h5 class="card-title">Active Clients</h5>
                                    <p class="card-text display-6">{{ stats.activeClients }}</p>
                                    <p class="card-text small">With active accounts</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <div class="card text-white bg-warning">
                                <div class="card-body">
                                    <h5 class="card-title">Administrators</h5>
                                    <p class="card-text display-6">{{ stats.administrators }}</p>
                                    <p class="card-text small">Admin users</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <div class="card text-white bg-info">
                                <div class="card-body">
                                    <h5 class="card-title">System Status</h5>
                                    <p class="card-text">{{ stats.activeUsers }} active users</p>
                                    <p class="card-text small">System online</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-lg-7 mb-3 mb-lg-0">
                            <div class="card chart-card">
                                <div class="card-header">Statistics Overview (Bar)</div>
                                <div class="card-body">
                                    <div class="chart-wrap">
                                        <canvas id="usersBarChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card chart-card">
                                <div class="card-header">Users Distribution (Circular)</div>
                                <div class="card-body">
                                    <div class="chart-wrap">
                                        <canvas id="usersDoughnutChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="card mb-4 users-board">
                        <div class="users-board-header d-flex justify-content-between align-items-center">
                            <h5 class="users-board-title">All Users</h5>
                            <span class="users-count-badge">{{ stats.totalUsers }} users</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive users-table-wrap">
                                <table class="table users-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Photo</th>
                                            <th>Full Name</th>
                                            <th>Email</th>
                                            <th>Role</th>
                                            <th>Status</th>
                                            <th>Created</th>
                                            <th>Updated</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for user in users %}
                                            <tr>
                                                <td><span class="user-id-pill">{{ user.id }}</span></td>
                                                <td>
                                                    {% if user.profilePhoto %}
                                                        <img
                                                            src="{{ user.profilePhoto starts with 'http://' or user.profilePhoto starts with 'https://' or user.profilePhoto starts with '/' ? user.profilePhoto : asset(user.profilePhoto) }}"
                                                            alt="{{ user.fullName ?: user.email }}"
                                                            class="avatar-chip"
                                                        >
                                                    {% else %}
                                                        <div class="avatar-fallback">
                                                            {{ (user.fullName ?: user.email)|slice(0,1)|upper }}
                                                        </div>
                                                    {% endif %}
                                                </td>
                                                <td class="name-cell">
                                                    <div class="name-main">{{ user.fullName ?: 'No full name' }}</div>
                                                    <div class="name-sub">ID: {{ user.id }}</div>
                                                </td>
                                                <td class="name-sub">{{ user.email }}</td>
                                                <td>
                                                    <span class="role-chip {{ user.role == 'ADMIN' ? 'role-admin' : 'role-client' }}">
                                                        {{ user.role }}
                                                    </span>
                                                </td>
                                                <td>
                                                    {% if user.isActive %}
                                                        <span class="status-chip status-active">Active</span>
                                                    {% else %}
                                                        <span class="status-chip status-inactive">Inactive</span>
                                                    {% endif %}
                                                </td>
                                                <td class="date-cell">{{ user.createdAt ? user.createdAt|date('Y-m-d H:i') : '-' }}</td>
                                                <td class="date-cell">{{ user.updatedAt ? user.updatedAt|date('Y-m-d H:i') : '-' }}</td>
                                                <td class="actions-cell">
                                                    <button
                                                        class="btn btn-sm btn-outline-primary"
                                                        type="button"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editUserModal-{{ user.id }}"
                                                    >
                                                        Edit
                                                    </button>
                                                    {% if app.user and app.user.id == user.id %}
                                                        <button class="btn btn-sm btn-outline-secondary ms-1" type="button" disabled>Delete</button>
                                                    {% else %}
                                                        <form class="action-inline-form" method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Delete this user?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_user_' ~ user.id) }}">
                                                            <button class="btn btn-sm btn-outline-danger ms-1" type="submit">Delete</button>
                                                        </form>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="9" class="text-center py-4">No users found.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    {% for user in users %}
                        <div class="modal fade" id="editUserModal-{{ user.id }}" tabindex="-1" aria-labelledby="editUserModalLabel-{{ user.id }}" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="editUserModalLabel-{{ user.id }}">Edit User #{{ user.id }}</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form method="post" action="{{ path('app_admin_user_update', {id: user.id}) }}">
                                        <div class="modal-body">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_edit_user_' ~ user.id) }}">

                                            <div class="mb-3">
                                                <label class="form-label" for="full_name_{{ user.id }}">Full Name</label>
                                                <input class="form-control" id="full_name_{{ user.id }}" name="full_name" type="text" value="{{ user.fullName ?: '' }}">
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label" for="email_{{ user.id }}">Email</label>
                                                <input class="form-control" id="email_{{ user.id }}" name="email" type="email" value="{{ user.email }}" required>
                                            </div>

                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" id="is_active_{{ user.id }}" name="is_active" value="1" {{ user.isActive ? 'checked' : '' }}>
                                                <label class="form-check-label" for="is_active_{{ user.id }}">Active account</label>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Save</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                </div>

                <div class="tab-pane fade" id="gestion-compte-pane" role="tabpanel" aria-labelledby="gestion-compte-tab">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">gestion_compte</h5>
                            <span class="badge bg-primary">Profile</span>
                        </div>
                        <div class="card-body">
                            <p>
                                <strong>Administrator:</strong> {{ app.user.fullName ?: app.user.email }}<br>
                                <strong>Email:</strong> {{ app.user.email }}<br>
                                <strong>Member Since:</strong> {{ app.user.createdAt | date('M d, Y') }}<br>
                                <strong>Account Status:</strong>
                                {% if app.user.isActive %}
                                    <span class="badge bg-success">Active</span>
                                {% else %}
                                    <span class="badge bg-danger">Inactive</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="gestion-depense-pane" role="tabpanel" aria-labelledby="gestion-depense-tab">
                    <div class="card">
                        <div class="card-header"><h5 class="card-title mb-0">gestion_depense</h5></div>
                        <div class="card-body">
                            <p class="mb-0">Section de gestion des depenses.</p>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="gestion-document-pane" role="tabpanel" aria-labelledby="gestion-document-tab">
                    <div class="card">
                        <div class="card-header"><h5 class="card-title mb-0">gestion_document</h5></div>
                        <div class="card-body">
                            <p class="mb-0">Section de gestion des documents.</p>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="gestion-service-produit-pane" role="tabpanel" aria-labelledby="gestion-service-produit-tab">
                    <div class="card">
                        <div class="card-header"><h5 class="card-title mb-0">gestion_service_et_produit</h5></div>
                        <div class="card-body">
                            <p class="mb-0">Section de gestion des services et produits.</p>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="gestion-portefeuille-pane" role="tabpanel" aria-labelledby="gestion-portefeuille-tab">
                    <div class="card">
                        <div class="card-header"><h5 class="card-title mb-0">gestion-portefeuille</h5></div>
                        <div class="card-body">
                            <p class="mb-0">Section de gestion du portefeuille.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            const stats = {
                totalUsers: {{ stats.totalUsers }},
                activeUsers: {{ stats.activeUsers }},
                activeClients: {{ stats.activeClients }},
                administrators: {{ stats.administrators }}
            };

            const inactiveUsers = Math.max(stats.totalUsers - stats.activeUsers, 0);
            const clients = Math.max(stats.totalUsers - stats.administrators, 0);

            const barCanvas = document.getElementById('usersBarChart');
            if (barCanvas) {
                new Chart(barCanvas, {
                    type: 'bar',
                    data: {
                        labels: ['Active Users', 'Inactive Users', 'Active Clients', 'Administrators'],
                        datasets: [{
                            label: 'Users',
                            data: [stats.activeUsers, inactiveUsers, stats.activeClients, stats.administrators],
                            backgroundColor: ['#2f6fed', '#f36a6a', '#18a979', '#f0ad4e'],
                            borderRadius: 8,
                            maxBarThickness: 54
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
            }

            const doughnutCanvas = document.getElementById('usersDoughnutChart');
            if (doughnutCanvas) {
                new Chart(doughnutCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: ['Clients', 'Administrators'],
                        datasets: [{
                            data: [clients, stats.administrators],
                            backgroundColor: ['#2383e2', '#f0ad4e'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }
        })();
    </script>
{% endblock %}
