{% extends 'admin/base.html.twig' %}
{% block title %}Categories - Admin FinTrack{% endblock %}
{% block page_title %}Gestion des Categories{% endblock %}
{% block page_subtitle %}{{ categories|length }} categorie(s){% endblock %}

{% block content %}
<div class="form-card mb-4">
    <form method="GET" action="{{ path('admin_categorie_index') }}" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label small fw-medium">Recherche</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                <input type="text" name="q" value="{{ q }}" class="form-control" placeholder="Nom de la categorie, description...">
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2 align-items-end">
            <button type="submit" class="btn flex-fill" style="background:#f97316;color:#fff;border-color:#f97316;"><i class="fas fa-filter"></i> Rechercher</button>
            <a href="{{ path('admin_categorie_index') }}" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">{{ categories|length }} resultat(s)</span>
    <a href="{{ path('admin_categorie_new') }}" class="btn-primary-custom"><i class="fas fa-plus"></i> Nouvelle categorie</a>
</div>

<div class="row g-4">
    {% for categorie in categories %}
    <div class="col-md-4">
        <div class="form-card h-100">
            <div class="d-flex align-items-center mb-3">
                <div class="stat-icon me-3" style="background:{{ categorie.couleur ? categorie.couleur~'22' : '#f3f4f6' }};min-width:48px;">
                    <i class="fas {{ categorie.icon ?? 'fa-tag' }}" style="color:{{ categorie.couleur ?? '#6b7280' }}"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-semibold">{{ categorie.nomCategorie }}</h6>
                    <span class="badge mt-1" style="background:{{ categorie.couleur ?? '#6b7280' }};font-size:0.65rem;">{{ categorie.couleur ?? 'aucune couleur' }}</span>
                </div>
            </div>
            {% if categorie.description %}
            <p class="text-muted small mb-3">{{ categorie.description|slice(0, 80) }}{% if categorie.description|length > 80 %}...{% endif %}</p>
            {% endif %}
            <div class="d-flex align-items-center justify-content-between mt-auto">
                <span class="badge bg-light text-dark"><i class="fas fa-file me-1"></i>{{ categorie.documents|length }} doc(s)</span>
                <div class="d-flex gap-1">
                    <a href="{{ path('admin_categorie_show', {id: categorie.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                    <a href="{{ path('admin_categorie_edit', {id: categorie.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                    <form action="{{ path('admin_categorie_delete', {id: categorie.id}) }}" method="post" onsubmit="return confirm('Supprimer ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12"><div class="text-center py-5 text-muted"><i class="fas fa-tags fa-3x mb-3 d-block opacity-25"></i>Aucune categorie trouvee</div></div>
    {% endfor %}
</div>
{% endblock %}