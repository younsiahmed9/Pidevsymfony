{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
    /* ===== GLOBAL FIX — style.css sets body color:#fff which breaks forms ===== */
    body { color: #212529 !important; }
    p, li, small { color: inherit; }
    /* Form elements */
    input, input[type="text"], input[type="email"], input[type="password"],
    input[type="number"], input[type="date"], input[type="search"],
    textarea, .form-control, .form-select {
        color: #212529 !important;
        background-color: #fff !important;
        border-color: #dee2e6 !important;
    }
    input::placeholder, textarea::placeholder { color: #9ca3af !important; opacity: 1; }
    select, select.form-select, select option { color: #212529 !important; background-color: #fff !important; }
    .form-label, label { color: #374151 !important; }
    .form-text { color: #6c757d !important; }
    .form-check-label { color: #374151 !important; }
    .form-check-input { background-color: #fff !important; border-color: #dee2e6 !important; }
    .input-group-text { color: #6c757d !important; background-color: #f9fafb !important; border-color: #dee2e6 !important; }
    /* Tables */
    .table td, .table th { color: #374151 !important; }
    .table-light, .table-light th, .table-light td,
    thead.table-light th, tbody.table-light td { background-color: #f8f9fa !important; color: #374151 !important; }
    thead tr th { color: #6b7280 !important; }
    /* Badges & misc */
    .badge.bg-light { color: #374151 !important; background-color: #f3f4f6 !important; }
    .badge.text-dark { color: #212529 !important; }
    /* Alerts */
    .alert-success { color: #15803d !important; background-color: #dcfce7 !important; }
    .alert-danger { color: #b91c1c !important; background-color: #fee2e2 !important; }
    .alert-warning { color: #92400e !important; background-color: #fef3c7 !important; }
    .alert-info { color: #0369a1 !important; background-color: #e0f2fe !important; }
    /* Cards (for non-sidebar pages) */
    .card { color: #212529; }
    .card-body, .card-title, .card-text { color: #212529 !important; }
    /* Headings in content area */
    .content-area h1, .content-area h2, .content-area h3,
    .content-area h4, .content-area h5, .content-area h6 { color: #0d0d1a; }
    /* Topbar */
    .topbar h5 { color: #0d0d1a !important; }
    .text-muted { color: #6c757d !important; }

    /* ===== ADMIN LAYOUT OVERRIDES ===== */
    body { background: #f0f0f5; }

    /* Sidebar — very dark charcoal with orange accent */
    .sidebar {
        width: 265px;
        min-height: 100vh;
        background: linear-gradient(180deg, #0d0d1a 0%, #13132a 60%, #0d0d1a 100%);
        position: fixed; left: 0; top: 0; z-index: 1000;
        padding-top: 0; overflow-y: auto;
        border-right: 1px solid rgba(249,115,22,0.15);
        box-shadow: 4px 0 20px rgba(0,0,0,0.4);
    }

    /* Brand block */
    .sidebar .brand {
        padding: 0;
        border-bottom: none;
        background: #f97316;
    }
    .sidebar .brand-inner {
        display: flex; align-items: center; gap: 0.75rem;
        padding: 1.25rem 1.5rem;
    }
    .sidebar .brand-icon {
        width: 38px; height: 38px; border-radius: 10px;
        background: rgba(255,255,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; font-weight: 800; color: #fff;
        flex-shrink: 0;
    }
    .sidebar .brand-text { color: #fff; line-height: 1.2; }
    .sidebar .brand-text .brand-name { font-size: 1.05rem; font-weight: 700; }
    .sidebar .brand-text .brand-role {
        font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1.5px;
        opacity: 0.85;
    }

    /* Nav section labels */
    .sidebar .nav-section {
        padding: 1.2rem 1.5rem 0.3rem;
        color: rgba(249,115,22,0.6);
        font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600;
    }

    /* Nav links */
    .sidebar .nav-link {
        color: rgba(255,255,255,0.55);
        padding: 0.65rem 1.5rem;
        display: flex; align-items: center; gap: 0.75rem;
        transition: all 0.2s; border-left: 3px solid transparent;
        text-decoration: none; font-size: 0.875rem; font-weight: 400;
        margin: 1px 0;
    }
    .sidebar .nav-link i { width: 18px; text-align: center; font-size: 0.85rem; }
    .sidebar .nav-link:hover {
        color: #fff; background: rgba(249,115,22,0.12);
        border-left-color: rgba(249,115,22,0.5);
    }
    .sidebar .nav-link.active {
        color: #fff; background: rgba(249,115,22,0.18);
        border-left-color: #f97316; font-weight: 500;
    }
    .sidebar .nav-link.active i { color: #f97316; }

    /* Sidebar footer */
    .sidebar-footer {
        padding: 1rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.07);
        margin-top: auto;
    }

    /* Main area */
    .main-content { margin-left: 265px; min-height: 100vh; background: #f0f0f5; }

    /* Topbar */
    .topbar {
        background: #fff;
        padding: 0.85rem 2rem;
        border-bottom: 3px solid #f97316;
        display: flex; align-items: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        position: sticky; top: 0; z-index: 100;
    }
    .topbar-admin-badge {
        background: #f97316; color: #fff;
        padding: 0.2rem 0.75rem; border-radius: 100px;
        font-size: 0.7rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    }
    .topbar-avatar {
        width: 36px; height: 36px; border-radius: 10px;
        background: linear-gradient(135deg,#f97316,#ea580c);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 700; font-size: 0.85rem;
        box-shadow: 0 2px 8px rgba(249,115,22,0.35);
    }

    /* Content area */
    .content-area { padding: 2rem; }

    /* Stat cards — admin style */
    .stat-card {
        background: #fff; border-radius: 14px; padding: 1.5rem;
        border: none; border-top: 4px solid #f97316;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,0.1); }
    .stat-card .stat-icon { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    .stat-card .stat-value { font-size: 2rem; font-weight: 700; color: #0d0d1a; }
    .stat-card .stat-label { font-size: 0.78rem; color: #9ca3af; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-card .stat-link { font-size: 0.78rem; color: #f97316; text-decoration: none; font-weight: 500; }
    .stat-card .stat-link:hover { text-decoration: underline; }

    /* Table card */
    .table-card {
        background: #fff; border-radius: 14px; border: none;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden;
    }
    .table-card .table-header {
        padding: 1.1rem 1.5rem; border-bottom: 1px solid #f1f5f9;
        display: flex; align-items: center; justify-content: space-between;
        background: #fafafa;
    }
    .table-card .table-header h6 { color: #0d0d1a; font-weight: 600; }

    /* Form card */
    .form-card {
        background: #fff; border-radius: 14px; padding: 2rem;
        border: none; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    /* Buttons */
    .btn-primary-custom {
        background: #f97316; border: none; color: #fff !important;
        padding: 0.55rem 1.25rem; border-radius: 8px; font-weight: 500;
        text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;
        cursor: pointer; font-size: 0.875rem; transition: background 0.2s;
    }
    .btn-primary-custom:hover { background: #ea580c; }
    .btn-orange { background: #f97316; border: none; color: #fff; }
    .btn-orange:hover { background: #ea580c; color: #fff; }

    /* Tables */
    .table th {
        font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px;
        color: #9ca3af; font-weight: 600; border-top: none; background: #fafafa;
    }
    .table td { vertical-align: middle; color: #374151; font-size: 0.875rem; }
    .action-btns a, .action-btns button { padding: 0.3rem 0.6rem; border-radius: 6px; font-size: 0.8rem; }

    /* Status badges */
    .badge-status { padding: 0.25rem 0.75rem; border-radius: 100px; font-size: 0.73rem; font-weight: 600; display: inline-block; }
    .badge-actif, .badge-valide, .badge-approuve, .badge-completed { background: #dcfce7; color: #15803d; }
    .badge-suspendu, .badge-a_renouveler, .badge-en_attente, .badge-pending, .badge-notified { background: #fef3c7; color: #b45309; }
    .badge-clos, .badge-expire, .badge-rejete, .badge-overdue { background: #fee2e2; color: #b91c1c; }
    .badge-archive, .badge-rembourse { background: #e0e7ff; color: #4338ca; }

    /* Alerts */
    .alert { border-radius: 10px; border: none; }
    .alert-success { background: #dcfce7; color: #15803d; }
    .alert-danger { background: #fee2e2; color: #b91c1c; }

    /* KPI row special */
    .kpi-highlight { border-top-color: #f97316 !important; }
    .kpi-blue { border-top-color: #3b82f6 !important; }
    .kpi-green { border-top-color: #22c55e !important; }
    .kpi-purple { border-top-color: #a855f7 !important; }
    .kpi-yellow { border-top-color: #eab308 !important; }
    .kpi-red { border-top-color: #ef4444 !important; }
</style>
{% endblock %}

{% block body %}
<!-- ===== ADMIN SIDEBAR ===== -->
<nav class="sidebar d-flex flex-column">
    <!-- Brand -->
    <div class="brand">
        <div class="brand-inner">
            <div class="brand-icon">F</div>
            <div class="brand-text">
                <div class="brand-name">FinTrack</div>
                <div class="brand-role">Administration</div>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <div class="pt-2 flex-grow-1">
        <div class="nav-section">Général</div>
        <a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.current_route == 'admin_dashboard' ? 'active' : '' }}">
            <i class="fas fa-th-large"></i> Tableau de bord
        </a>

        <div class="nav-section">Module Compte</div>
        <a href="{{ path('admin_compte_index') }}" class="nav-link {{ 'admin_compte' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-university"></i> Comptes
        </a>
        <a href="{{ path('admin_credit_index') }}" class="nav-link {{ 'admin_credit' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-credit-card"></i> Crédits
        </a>

        <div class="nav-section">Module Documents</div>
        <a href="{{ path('admin_document_index') }}" class="nav-link {{ 'admin_document' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-file-alt"></i> Documents
        </a>
        <a href="{{ path('admin_dossier_index') }}" class="nav-link {{ 'admin_dossier' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-folder-open"></i> Dossiers
        </a>
        <a href="{{ path('admin_echeance_index') }}" class="nav-link {{ 'admin_echeance' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-calendar-check"></i> Échéances
        </a>
        <a href="{{ path('admin_categorie_index') }}" class="nav-link {{ 'admin_categorie' in app.current_route ? 'active' : '' }}">
            <i class="fas fa-tags"></i> Catégories
        </a>

        <div class="nav-section">Navigation</div>
        <a href="{{ path('user_dashboard') }}" class="nav-link">
            <i class="fas fa-users"></i> Vue Utilisateur
        </a>
        <a href="{{ path('home') }}" class="nav-link">
            <i class="fas fa-home"></i> Accueil
        </a>
    </div>

    <!-- Sidebar footer -->
    <div class="sidebar-footer">
        <div style="display:flex;align-items:center;gap:0.6rem;">
            <div style="width:32px;height:32px;border-radius:8px;background:rgba(249,115,22,0.25);display:flex;align-items:center;justify-content:center;color:#f97316;font-weight:700;font-size:0.8rem;">A</div>
            <div style="line-height:1.2;">
                <div style="color:#fff;font-size:0.8rem;font-weight:500;">Administrateur</div>
                <div style="color:rgba(255,255,255,0.35);font-size:0.7rem;">Accès complet</div>
            </div>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="main-content">
    <!-- Topbar -->
    <div class="topbar">
        <div class="d-flex align-items-center justify-content-between w-100">
            <div>
                <h5 class="mb-0 fw-bold" style="color:#0d0d1a;">{% block page_title %}Administration{% endblock %}</h5>
                <small class="text-muted" style="font-size:0.78rem;">{% block page_subtitle %}{% endblock %}</small>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="topbar-admin-badge"><i class="fas fa-shield-alt me-1"></i>Admin</span>
                <div class="topbar-avatar">A</div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="content-area">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-check-circle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {% block content %}{% endblock %}
    </div>
</div>
{% endblock %}
