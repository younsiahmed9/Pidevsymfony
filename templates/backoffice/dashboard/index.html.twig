{% extends 'backoffice/base.html.twig' %}

{% block title %}Admin Dashboard - FinTrack{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
    <style>
        .backoffice-dashboard {
            display: grid;
            gap: 1.5rem;
        }

        .backoffice-dashboard .card {
            width: 100%;
            align-items: stretch;
            box-sizing: border-box;
        }

        .hero-card,
        .section-card,
        .kpi-card {
            border: 0;
            border-radius: 24px;
            box-shadow: 0 14px 36px rgba(17, 24, 39, 0.08);
            background: #fff;
        }

        .hero-card {
            background: linear-gradient(135deg, #06162d 0%, #123a7b 50%, #1f6feb 100%);
            color: #fff;
            box-shadow: 0 18px 45px rgba(9, 29, 62, 0.22);
        }

        .hero-card .card-body,
        .section-card .card-body,
        .kpi-card .card-body {
            width: 100%;
            padding: 1.5rem;
            box-sizing: border-box;
        }

        .hero-eyebrow,
        .section-eyebrow,
        .kpi-label,
        .module-title,
        .section-title,
        .chart-title {
            margin: 0;
        }

        .hero-eyebrow {
            margin-bottom: 0.35rem;
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.7);
        }

        .hero-title {
            margin: 0 0 0.65rem;
            font-size: clamp(1.6rem, 2.2vw, 2.25rem);
            font-weight: 800;
        }

        .hero-text,
        .section-text,
        .card-text-muted,
        .table-muted,
        .wallet-owner {
            color: #6b7f9e;
        }

        .hero-text {
            max-width: 60rem;
            color: rgba(255, 255, 255, 0.92);
        }

        .hero-meta {
            display: inline-flex;
            align-items: center;
            margin-top: 1rem;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #fff;
            font-size: 0.84rem;
            font-weight: 600;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 1rem;
        }

        .kpi-label {
            color: #6b7f9e;
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 0.35rem;
        }

        .kpi-value {
            margin: 0;
            color: #173058;
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1.05;
        }

        .section-card {
            overflow: hidden;
        }

        .section-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #e6edf7;
            background: #f8fbff;
        }

        .section-title {
            color: #173058;
            font-size: 1.05rem;
            font-weight: 800;
        }

        .toolbar-card {
            padding: 1rem;
            border: 1px solid #e5edf8;
            border-radius: 18px;
            background: #f8fbff;
        }

        .table-shell {
            overflow: auto;
            border: 1px solid #e7edf6;
            border-radius: 18px;
            background: #fff;
        }

        .clean-table {
            margin-bottom: 0;
        }

        .clean-table thead th {
            background: #f7f9fc;
            color: #2f3f5a;
            font-size: 0.78rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            font-weight: 700;
            border-bottom: 1px solid #e8edf5;
            white-space: nowrap;
            padding: 0.85rem;
        }

        .clean-table tbody td {
            border-bottom: 1px solid #eef2f8;
            padding: 0.85rem;
            vertical-align: middle;
        }

        .clean-table tbody tr:hover {
            background: #f9fbff;
        }

        .avatar-fallback {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            background: #eef4ff;
            color: #173058;
            border: 1px solid #dbe6f7;
        }

        .user-name-main {
            font-weight: 700;
            color: #173058;
        }

        .user-name-sub,
        .wallet-owner,
        .table-muted {
            font-size: 0.82rem;
            color: #6b7f9e;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 0.35rem 0.7rem;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .pill-admin {
            background: #fff1bf;
            color: #7b5a00;
        }

        .pill-client {
            background: #dff1ff;
            color: #0d4f73;
        }

        .pill-active {
            background: #d9f6e6;
            color: #0f6a40;
        }

        .pill-soft {
            background: #eaf2ff;
            color: #0d4f9d;
        }

        .module-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .module-card {
            padding: 1rem;
            border-radius: 18px;
            border: 1px solid #e5ecf6;
            background: #fff;
        }

        .module-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            margin-bottom: 0.75rem;
            background: #eaf2ff;
            color: #0d6efd;
        }

        .module-title {
            margin-bottom: 0.25rem;
            color: #173058;
            font-weight: 700;
        }

        .module-text {
            margin: 0;
            color: #6b7f9e;
            font-size: 0.88rem;
        }

        .wallet-kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .wallet-chart-grid {
            display: grid;
            grid-template-columns: 1.7fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .chart-box {
            min-height: 220px;
            border-radius: 18px;
            border: 1px solid #e5ecf6;
            background: #fff;
            padding: 1rem;
        }

        .chart-title {
            color: #173058;
            font-weight: 700;
        }

        .chart-subtitle {
            margin: 0 0 0.85rem;
            color: #6b7f9e;
            font-size: 0.86rem;
        }

        .footer-note {
            text-align: center;
            color: #6b7f9e;
            font-size: 0.9rem;
            padding: 1rem 0 0.5rem;
        }

        @media (max-width: 1199.98px) {
            .kpi-grid,
            .module-grid,
            .wallet-kpi-grid,
            .wallet-chart-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 767.98px) {
            .kpi-grid,
            .module-grid,
            .wallet-kpi-grid,
            .wallet-chart-grid {
                grid-template-columns: 1fr;
            }

            .section-header,
            .hero-card .card-body,
            .section-card .card-body,
            .kpi-card .card-body {
                padding: 1rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% set total_users = total_users|default(stats.totalUsers|default(0)) %}
    {% set active_clients = active_clients|default(stats.activeClients|default(0)) %}
    {% set administrators = administrators|default(stats.administrators|default(0)) %}
    {% set total_portefeuilles = total_portefeuilles|default(portefeuilles|length|default(0)) %}
    {% set total_balance = total_balance|default(portefeuilleStats.totalSolde|default(total_solde_portefeuilles|default(0))) %}
    {% set total_cards = total_cards|default(portefeuilleStats.totalCards|default(0)) %}
    {% set total_solde_portefeuilles = total_solde_portefeuilles|default(portefeuilleStats.totalSolde|default(0)) %}
    {% set proprietaires_count = proprietaires_count|default(portefeuilleStats.totalOwners|default(0)) %}
    {% set cartes_count = cartes_count|default(portefeuilleStats.totalCards|default(0)) %}
    {% set cartes_actives_count = cartes_actives_count|default(portefeuilleStats.activeCards|default(0)) %}
    {% set devises_utilisees_count = devises_utilisees_count|default(portefeuilleStats.totalDevises|default(0)) %}
    {% set card_types = card_types|default(portefeuilleStats.cardTypes|default([])) %}
    {% set transactions_count = transactions_count|default(kpis.nb_transactions|default(0)) %}

    <div class="backoffice-dashboard">
        <section class="card hero-card">
            <div class="card-body">
                <div class="hero-eyebrow">FinTrack backoffice</div>
                <h1 class="hero-title">Admin dashboard</h1>
                <p class="hero-text">A cleaner command center for the system. Keep an eye on users, wallets, cards and documents from a single organized view.</p>
                <div class="hero-meta">Logged in as admin</div>
            </div>
        </section>

        <section class="kpi-grid" aria-label="KPI statistics">
            <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Total users</p><p class="kpi-value">{{ total_users }}</p><p class="card-text-muted">System wide</p></div></div>
            <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Active clients</p><p class="kpi-value">{{ active_clients }}</p><p class="card-text-muted">Client accounts</p></div></div>
            <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Administrators</p><p class="kpi-value">{{ administrators }}</p><p class="card-text-muted">Admin users</p></div></div>
            <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Portefeuilles</p><p class="kpi-value">{{ total_portefeuilles }}</p><p class="card-text-muted">Wallets tracked</p></div></div>
            <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Total balance</p><p class="kpi-value">{{ total_balance|number_format(2, '.', ',') }}</p><p class="card-text-muted">Combined holdings</p></div></div>
            <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Cards</p><p class="kpi-value">{{ total_cards }}</p><p class="card-text-muted">Virtual cards</p></div></div>
        </section>

        <section class="card section-card" id="users-management">
            <div class="section-header">
                <h2 class="section-title">Users Management</h2>
                <p class="section-text">Search, sort and manage account data from one place.</p>
            </div>
            <div class="card-body">
                <form class="toolbar-card mb-3" method="get" action="{{ path('admin_dashboard') }}#users-management">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-5">
                            <label class="form-label mb-1">Search</label>
                            <input type="search" name="q" class="form-control" value="{{ search|default('') }}" placeholder="Name, email, role or ID">
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label mb-1">Sort</label>
                            <select class="form-select" name="sort">
                                <option value="id" {{ sort == 'id' ? 'selected' : '' }}>ID</option>
                                <option value="nom" {{ sort == 'nom' ? 'selected' : '' }}>Name</option>
                                <option value="email" {{ sort == 'email' ? 'selected' : '' }}>Email</option>
                                <option value="role" {{ sort == 'role' ? 'selected' : '' }}>Role</option>
                                <option value="solde" {{ sort == 'solde' ? 'selected' : '' }}>Balance</option>
                                <option value="created_at" {{ sort == 'created_at' ? 'selected' : '' }}>Created date</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label mb-1">Order</label>
                            <select class="form-select" name="direction">
                                <option value="desc" {{ direction == 'desc' ? 'selected' : '' }}>DESC</option>
                                <option value="asc" {{ direction == 'asc' ? 'selected' : '' }}>ASC</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-3 d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Apply</button>
                            <a href="{{ path('admin_dashboard') }}#users-management" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    </div>
                </form>

                <div class="table-shell">
                    <table class="table clean-table align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Photo</th>
                                <th>Full name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Balance</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users|default([]) %}
                                {% set fallbackName = (user.prenom|default('') ~ ' ' ~ user.nom|default(''))|trim %}
                                {% set fullName = user.full_name|default(fallbackName) %}
                                <tr>
                                    <td><span class="pill pill-soft">{{ user.id }}</span></td>
                                    <td><div class="avatar-fallback">{{ (fullName ?: user.email)|slice(0, 1)|upper }}</div></td>
                                    <td>
                                        <div class="user-name-main">{{ fullName ?: 'No full name' }}</div>
                                        <div class="user-name-sub">ID: {{ user.id }}</div>
                                    </td>
                                    <td class="user-name-sub">{{ user.email }}</td>
                                    <td><span class="pill {{ (user.role|lower == 'admin') ? 'pill-admin' : 'pill-client' }}">{{ user.role|upper }}</span></td>
                                    <td><span class="pill pill-active">{{ user.is_active ? 'Active' : 'Inactive' }}</span></td>
                                    <td class="table-muted">{{ user.solde|number_format(2, '.', ',') }}</td>
                                    <td class="table-muted">
                                        {% if user.created_at %}
                                            {{ user.created_at|date('Y-m-d H:i') }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button
                                                class="btn btn-sm btn-outline-primary"
                                                type="button"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editUserModal-{{ user.id }}"
                                            >
                                                Edit
                                            </button>
                                            {% if app.user and app.user.id == user.id %}
                                                <button class="btn btn-sm btn-outline-danger" type="button" disabled>Delete</button>
                                            {% else %}
                                                <form method="post" action="{{ path('admin_backoffice_user_delete', {id: user.id}) }}" class="d-inline" onsubmit="return confirm('Delete this user?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('backoffice_delete_user_' ~ user.id) }}">
                                                    <input type="hidden" name="q" value="{{ search|default('') }}">
                                                    <input type="hidden" name="sort" value="{{ sort|default('created_at') }}">
                                                    <input type="hidden" name="direction" value="{{ direction|default('desc') }}">
                                                    <input type="hidden" name="pf_q" value="{{ portefeuilleFilters.q|default('') }}">
                                                    <input type="hidden" name="pf_sort" value="{{ portefeuilleFilters.sort|default('created_at') }}">
                                                    <input type="hidden" name="pf_direction" value="{{ portefeuilleFilters.direction|default('desc') }}">
                                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        {% for user in users|default([]) %}
            {% set fallbackName = (user.prenom|default('') ~ ' ' ~ user.nom|default(''))|trim %}
            {% set fullName = user.full_name|default(fallbackName) %}
            <div class="modal fade" id="editUserModal-{{ user.id }}" tabindex="-1" aria-labelledby="editUserModalLabel-{{ user.id }}" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editUserModalLabel-{{ user.id }}">Edit User #{{ user.id }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form method="post" action="{{ path('admin_backoffice_user_update', {id: user.id}) }}">
                            <div class="modal-body">
                                <input type="hidden" name="_token" value="{{ csrf_token('backoffice_edit_user_' ~ user.id) }}">
                                <input type="hidden" name="q" value="{{ search|default('') }}">
                                <input type="hidden" name="sort" value="{{ sort|default('created_at') }}">
                                <input type="hidden" name="direction" value="{{ direction|default('desc') }}">
                                <input type="hidden" name="pf_q" value="{{ portefeuilleFilters.q|default('') }}">
                                <input type="hidden" name="pf_sort" value="{{ portefeuilleFilters.sort|default('created_at') }}">
                                <input type="hidden" name="pf_direction" value="{{ portefeuilleFilters.direction|default('desc') }}">

                                <div class="mb-3">
                                    <label class="form-label" for="full_name_{{ user.id }}">Full Name</label>
                                    <input class="form-control" id="full_name_{{ user.id }}" name="full_name" type="text" value="{{ fullName }}">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="email_{{ user.id }}">Email</label>
                                    <input class="form-control" id="email_{{ user.id }}" name="email" type="email" value="{{ user.email }}" required>
                                </div>

                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="is_active_{{ user.id }}" name="is_active" value="1" {{ user.is_active ? 'checked' : '' }}>
                                    <label class="form-check-label" for="is_active_{{ user.id }}">Active account</label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}

        <section class="card section-card">
            <div class="section-header">
                <h2 class="section-title">System snapshot</h2>
                <p class="section-text">A quick visual check of the current data.</p>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-lg-4">
                        <div class="card kpi-card h-100"><div class="card-body"><p class="kpi-label">Transactions</p><p class="kpi-value">{{ transactions_count }}</p><p class="card-text-muted">Recorded transactions</p></div></div>
                    </div>
                    <div class="col-lg-8">
                        <div class="card kpi-card h-100">
                            <div class="card-body">
                                <p class="kpi-label">Card types</p>
                                <div class="table-shell">
                                    <table class="table clean-table mb-0">
                                        <thead><tr><th>Type</th><th class="text-end">Count</th></tr></thead>
                                        <tbody>
                                            {% for type in card_types %}
                                                <tr><td>{{ type.type }}</td><td class="text-end fw-bold">{{ type.count|default(type.total)|default(0) }}</td></tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="card section-card" id="module-shortcuts">
            <div class="section-header">
                <h2 class="section-title">Module shortcuts</h2>
            </div>
            <div class="card-body">
                <div class="module-grid">
                    <div class="module-card"><div class="module-icon"><i class="fas fa-user-gear"></i></div><div class="module-title">gestion_compte</div><p class="module-text">Administrator profile and account settings.</p></div>
                    <div class="module-card"><div class="module-icon"><i class="fas fa-wallet"></i></div><div class="module-title">gestion_depense</div><p class="module-text">Expense operations and spending flows.</p></div>
                    <div class="module-card"><div class="module-icon"><i class="fas fa-file-lines"></i></div><div class="module-title">gestion_document</div><p class="module-text">Documents, uploads and admin files.</p></div>
                    <div class="module-card"><div class="module-icon"><i class="fas fa-box-open"></i></div><div class="module-title">gestion_service_et_produit</div><p class="module-text">Services and products catalog management.</p></div>
                </div>
            </div>
        </section>

        <section class="card section-card" id="portefeuille-management">
            <div class="section-header">
                <h2 class="section-title">Gestion Portefeuille</h2>
                <p class="section-text">Search, sort and export wallet data without leaving the dashboard.</p>
            </div>
            <div class="card-body">
                <div class="wallet-kpi-grid">
                    <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Portefeuilles</p><p class="kpi-value">{{ total_portefeuilles }}</p><p class="card-text-muted">Nombre total</p></div></div>
                    <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Solde cumulé</p><p class="kpi-value">{{ total_solde_portefeuilles|number_format(2, '.', ',') }}</p><p class="card-text-muted">Somme des soldes</p></div></div>
                    <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Propriétaires</p><p class="kpi-value">{{ proprietaires_count }}</p><p class="card-text-muted">Clients distincts</p></div></div>
                    <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Cartes</p><p class="kpi-value">{{ cartes_count }}</p><p class="card-text-muted">Total cartes</p></div></div>
                    <div class="card kpi-card"><div class="card-body"><p class="kpi-label">Cartes actives</p><p class="kpi-value">{{ cartes_actives_count }}</p><p class="card-text-muted">{{ devises_utilisees_count }} devises utilisées</p></div></div>
                </div>

                <div class="wallet-chart-grid">
                    <div class="chart-box">
                        <p class="chart-title">Types de cartes</p>
                        <p class="chart-subtitle">Distribution of wallet card types.</p>
                        <div class="table-shell">
                            <table class="table clean-table mb-0">
                                <thead><tr><th>Type</th><th class="text-end">Nombre</th></tr></thead>
                                <tbody>
                                    {% for type in card_types %}
                                        <tr><td>{{ type.type }}</td><td class="text-end fw-bold">{{ type.count|default(type.total)|default(0) }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="chart-box">
                        <p class="chart-title">Statistiques par type</p>
                        <p class="chart-subtitle">Quick breakdown of the cards already in the database.</p>
                        <div class="table-shell">
                            <table class="table clean-table mb-0">
                                <thead><tr><th>Type</th><th class="text-end">Count</th></tr></thead>
                                <tbody>
                                    {% for type in card_types %}
                                        <tr><td>{{ type.type }}</td><td class="text-end fw-bold">{{ type.count|default(type.total)|default(0) }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <form class="toolbar-card mb-3" method="get" action="{{ path('admin_dashboard') }}#portefeuille-management">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-5">
                            <label class="form-label mb-1">Recherche dynamique</label>
                            <input type="search" name="pf_q" class="form-control" value="{{ portefeuilleFilters.q|default('') }}" placeholder="Nom portefeuille, devise, email propriétaire...">
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label mb-1">Tri</label>
                            <select class="form-select" name="pf_sort">
                                <option value="id" {{ portefeuilleFilters.sort|default('created_at') == 'id' ? 'selected' : '' }}>ID</option>
                                <option value="nom" {{ portefeuilleFilters.sort|default('created_at') == 'nom' ? 'selected' : '' }}>Nom</option>
                                <option value="solde_total" {{ portefeuilleFilters.sort|default('created_at') == 'solde_total' ? 'selected' : '' }}>Solde</option>
                                <option value="devise" {{ portefeuilleFilters.sort|default('created_at') == 'devise' ? 'selected' : '' }}>Devise</option>
                                <option value="owner" {{ portefeuilleFilters.sort|default('created_at') == 'owner' ? 'selected' : '' }}>Propriétaire</option>
                                <option value="created_at" {{ portefeuilleFilters.sort|default('created_at') == 'created_at' ? 'selected' : '' }}>Date création</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="form-label mb-1">Ordre</label>
                            <select class="form-select" name="pf_direction">
                                <option value="desc" {{ portefeuilleFilters.direction|default('desc') == 'desc' ? 'selected' : '' }}>DESC</option>
                                <option value="asc" {{ portefeuilleFilters.direction|default('desc') == 'asc' ? 'selected' : '' }}>ASC</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-12 d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Apply</button>
                            <a class="btn btn-outline-secondary" href="{{ path('admin_dashboard') }}#portefeuille-management">Reset</a>
                        </div>
                    </div>
                </form>

                <div class="table-shell">
                    <table class="table clean-table align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Propriétaire</th>
                                <th>Solde</th>
                                <th>Devise</th>
                                <th>Créé le</th>
                                <th>Mis à jour</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for portefeuille in portefeuilles|default([]) %}
                                {% set fallbackOwnerName = (portefeuille.owner_prenom|default('') ~ ' ' ~ portefeuille.owner_nom|default(''))|trim %}
                                {% set ownerName = portefeuille.owner_full_name|default(fallbackOwnerName) %}
                                <tr>
                                    <td><span class="pill pill-soft">{{ portefeuille.id }}</span></td>
                                    <td class="user-name-main">{{ portefeuille.nom }}</td>
                                    <td>
                                        <div class="user-name-main">{{ ownerName ?: 'Unknown owner' }}</div>
                                        <div class="wallet-owner">{{ portefeuille.owner_email|default('') }}</div>
                                    </td>
                                    <td class="table-muted">{{ portefeuille.solde_total|number_format(2, '.', ',') }}</td>
                                    <td><span class="pill pill-client">{{ portefeuille.devise_principale }}</span></td>
                                    <td class="table-muted">
                                        {% if portefeuille.created_at %}
                                            {{ portefeuille.created_at|date('Y-m-d H:i') }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td class="table-muted">
                                        {% if portefeuille.updated_at %}
                                            {{ portefeuille.updated_at|date('Y-m-d H:i') }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <footer class="footer-note">© 2026 FinTrack Admin. Tous droits réservés.</footer>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}
