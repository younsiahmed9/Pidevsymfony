{% extends 'backoffice/base_admin.html.twig' %}

{% block title %}Admin Dashboard - FinTrack{% endblock %}

{% block stylesheets %}
<style>
    .admin-page {
        min-height: calc(100vh - 145px);
        overflow: visible;
        padding-bottom: 2rem;
    }

    .admin-layout {
        align-items: stretch;
        min-height: 100%;
    }

    .admin-sidebar {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 12px 28px rgba(17, 24, 39, 0.08);
        height: auto;
        overflow: hidden;
        background: linear-gradient(180deg, #071a34 0%, #0b2347 100%);
    }

    .admin-sidebar .card-body {
        height: 100%;
        overflow-y: auto;
        padding: 1rem;
    }

    .admin-menu-nav {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .admin-menu-group-title {
        color: #8fa9d6;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        margin: 0 0 0.6rem;
    }

    .admin-menu-btn {
        text-align: left;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        background: rgba(255, 255, 255, 0.04);
        color: #d6e4ff;
        font-weight: 600;
        transition: all 0.2s ease;
        width: 100%;
        text-decoration: none;
    }

    .admin-menu-btn.active,
    .admin-menu-btn:hover {
        background: #1f4fa1;
        border-color: #5f8fe4;
        color: #fff;
    }

    .chart-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 12px 28px rgba(17, 24, 39, 0.08);
        height: 100%;
    }

    .chart-card .card-header {
        background: #f7f9fc;
        border-bottom: 1px solid #e8edf5;
        font-weight: 700;
        padding: 1rem;
    }

    .chart-wrap {
        position: relative;
        min-height: 250px;
        padding: 1rem;
    }

    .stats-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

    .stats-card:hover {
        transform: translateY(-5px);
    }

    .board-card {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 14px 35px rgba(17, 24, 39, 0.08);
        background: #ffffff;
        margin-bottom: 2rem;
    }

    .board-header {
        background: linear-gradient(120deg, #123a7b 0%, #2258a8 100%);
        color: #fff;
        padding: 1rem 1.25rem;
    }

    .board-title {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .table thead th {
        background: #f7f9fc;
        color: #2f3f5a;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        padding: 1rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4 admin-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Dashboard Administration</h1>
        <div class="text-muted">{{ "now"|date("d F Y") }}</div>
    </div>

    <div class="row g-4 admin-layout">
        <!-- Sidebar Menu -->
        <div class="col-lg-3">
            <div class="card admin-sidebar">
                <div class="card-body">
                    <p class="admin-menu-group-title">Navigation</p>
                    <div class="admin-menu-nav">
                        <a href="{{ path('admin_dashboard') }}" class="admin-menu-btn active">📊 Dashboard Overview</a>
                        <a href="{{ path('admin_facture_index') }}" class="admin-menu-btn">📋 Gestion Factures</a>
                        <a href="{{ path('admin_service_index') }}" class="admin-menu-btn">⚙️ Gestion Services</a>
                        <a href="{{ path('admin_produit_index') }}" class="admin-menu-btn">📦 Gestion Produits</a>
                    </div>
                    
                    <hr class="admin-menu-divider">
                    
                    <p class="admin-menu-group-title">Liens Rapides</p>
                    <div class="admin-menu-nav">
                        <a href="{{ path('admin_facture_new') }}" class="admin-menu-btn text-success">+ Nouvelle Facture</a>
                        <a href="{{ path('admin_service_stats') }}" class="admin-menu-btn">📈 Stats Services</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Stats Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card stats-card bg-primary text-white h-100">
                        <div class="card-body">
                            <h6 class="card-title opacity-75">Chiffre d'Affaires</h6>
                            <h3 class="mb-0">${{ totalCA|number_format(2, '.', ',') }}</h3>
                            <small>Taux recouv: {{ tauxRecouvrement|number_format(1) }}%</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stats-card bg-danger text-white h-100">
                        <div class="card-body">
                            <h6 class="card-title opacity-75">Impayés / Expirés</h6>
                            <h3 class="mb-0">{{ countFacturesImpayees + countFacturesExpires }}</h3>
                            <small>Montant: ${{ (montantImpaye + montantExpire)|number_format(2) }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stats-card bg-success text-white h-100">
                        <div class="card-body">
                            <h6 class="card-title opacity-75">Services Actifs</h6>
                            <h3 class="mb-0">{{ servicesActifs }}</h3>
                            <small>Moy. tarif: ${{ averageTarif|number_format(2) }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card stats-card bg-info text-white h-100">
                        <div class="card-body">
                            <h6 class="card-title opacity-75">Produits Dispo</h6>
                            <h3 class="mb-0">{{ produitDisponible }}</h3>
                            <small>Valeur: ${{ totalMontantProduit|number_format(2) }}</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="card chart-card">
                        <div class="card-header">Aperçu des Factures ($)</div>
                        <div class="card-body">
                            <div class="chart-wrap">
                                <canvas id="facturesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card chart-card">
                        <div class="card-header">Répartition Services</div>
                        <div class="card-body">
                            <div class="chart-wrap">
                                <canvas id="servicesDoughnutChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Items Row -->
            <div class="card board-card">
                <div class="board-header d-flex justify-content-between align-items-center">
                    <h5 class="board-title">Dernières Factures</h5>
                    <a href="{{ path('admin_facture_index') }}" class="btn btn-sm btn-light">Tout voir</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Numéro</th>
                                    <th>Montant</th>
                                    <th>Cible</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for facture in recentFactures %}
                                    <tr>
                                        <td><span class="badge bg-light text-dark">{{ facture.id }}</span></td>
                                        <td><strong>{{ facture.numeroFacture }}</strong></td>
                                        <td>${{ facture.montant|number_format(2, '.', ',') }}</td>
                                        <td>
                                            {% if facture.service %}
                                                <span class="text-success">⚙️ {{ facture.service.nomService }}</span>
                                            {% elseif facture.produit %}
                                                <span class="text-info">📦 {{ facture.produit.nomProduit }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge {% if facture.statut == 'payee' %}bg-success{% elseif facture.statut == 'impayee' %}bg-danger{% else %}bg-warning{% endif %}">
                                                {{ facture.statut }}
                                            </span>
                                        </td>
                                        <td>
                                            <a href="{{ path('admin_facture_show', {id: facture.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="6" class="text-center py-4">Aucune facture récente.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Factures Chart
        const factCtx = document.getElementById('facturesChart').getContext('2d');
        new Chart(factCtx, {
            type: 'bar',
            data: {
                labels: ['CA Total', 'Impayés', 'Expirés'],
                datasets: [{
                    label: 'Montant ($)',
                    data: [{{ totalCA }}, {{ montantImpaye }}, {{ montantExpire }}],
                    backgroundColor: ['#0d6efd', '#dc3545', '#ffc107'],
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // Services Doughnut
        const servCtx = document.getElementById('servicesDoughnutChart').getContext('2d');
        new Chart(servCtx, {
            type: 'doughnut',
            data: {
                labels: ['Actifs', 'Suspendus', 'Expirés'],
                datasets: [{
                    data: [{{ servicesActifs }}, {{ servicesSuspendus }}, {{ servicesExpires }}],
                    backgroundColor: ['#198754', '#ffc107', '#dc3545'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                },
                cutout: '70%'
            }
        });
    });
</script>
{% endblock %}
