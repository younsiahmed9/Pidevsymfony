{% extends 'backoffice/base.html.twig' %}

{% block title %}Gestion des Documents - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
        <div>
            <h1 class="h3 mb-1 text-gray-800"><i class="fas fa-file-invoice me-2 text-primary"></i>Gestion des Documents</h1>
            <p class="text-muted small mb-0">Administrez tous les documents importés par les utilisateurs.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('admin_categorie_new') }}" class="btn btn-outline-primary shadow-sm rounded-pill px-4">
                <i class="fas fa-tags fa-sm me-1"></i> Nouvelle Catégorie
            </a>
            <a href="{{ path('admin_document_new') }}" class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Nouveau Document
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <form method="GET" action="{{ path('admin_document_index') }}" class="row g-3 align-items-end">
                <div class="col-md-10">
                    <label class="form-label small fw-bold text-uppercase text-muted">Rechercher par titre, type, utilisateur ou tags</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="q" value="{{ q }}" class="form-control bg-light border-0 shadow-none" placeholder="Titre, utilisateur, tags...">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-header py-3 bg-white border-bottom-0 rounded-top-4">
            <h6 class="m-0 font-weight-bold text-primary">📋 Liste des Documents</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th>Document</th>
                            <th>Type / Catégorie</th>
                            <th>Propriétaire</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Date Doc.</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for document in documents %}
                            <tr>
                                <td class="ps-4 text-muted small">#{{ document.id }}</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3">
                                            <i class="fas fa-file-pdf text-primary"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">{{ document.titre }}</span>
                                            <span class="text-muted small"><i class="fas fa-folder-open me-1"></i>{{ document.dossier.nomDossier|default('Hors dossier') }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill text-capitalize small d-block mb-1">
                                        {{ document.typeDocument }}
                                    </span>
                                    <span class="small text-muted">
                                        <i class="fas fa-tag me-1" style="color: {{ document.categorie.couleur|default('#ccc') }};"></i>
                                        {{ document.categorie.nomCategorie|default('Sans catégorie') }}
                                    </span>
                                </td>
                                <td>
                                    <span class="small fw-bold text-dark">{{ document.utilisateur.fullName ?: document.utilisateur.email }}</span>
                                    <span class="text-muted d-block small">{{ document.utilisateur.email }}</span>
                                </td>
                                <td class="text-center">
                                    {% set status_color = document.statut == 'valide' ? 'success' : (document.statut == 'expire' ? 'danger' : 'warning') %}
                                    <span class="badge bg-{{ status_color }} bg-opacity-10 text-{{ status_color }} px-3 py-2 rounded-pill text-capitalize small">
                                        {{ document.statut }}
                                    </span>
                                </td>
                                <td class="text-center small text-muted">{{ document.dateDocument|date('d/m/Y') }}</td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                        <a href="{{ path('admin_document_show', {id: document.id}) }}" class="btn btn-sm btn-white border-end" title="Voir"><i class="fas fa-eye text-primary"></i></a>
                                        <a href="{{ path('admin_document_edit', {id: document.id}) }}" class="btn btn-sm btn-white border-end" title="Modifier"><i class="fas fa-edit text-warning"></i></a>
                                        <form method="post" action="{{ path('admin_document_delete', {id: document.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce document ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                                            <button class="btn btn-sm btn-white" title="Supprimer"><i class="fas fa-trash text-danger"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-file-invoice fa-3x mb-3 d-block opacity-25"></i>
                                        Aucun document trouvé.
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-top-0 py-3 rounded-bottom-4">
            <div class="text-muted small">Total : <strong>{{ documents|length }}</strong> document(s)</div>
        </div>
    </div>
</div>
{% endblock %}