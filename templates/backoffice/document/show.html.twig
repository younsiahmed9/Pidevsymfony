{% extends 'backoffice/base.html.twig' %}

{% block title %}Détails du Document - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4">
    <div class="mb-4">
        <a href="{{ path('admin_document_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm bg-white">
            <i class="fas fa-arrow-left me-2 text-primary"></i> Retour à la liste
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-primary py-4 text-center">
                    <div class="bg-white bg-opacity-25 d-inline-block p-4 rounded-circle mb-3 shadow-sm">
                        <i class="fas fa-file-pdf fa-3x text-white"></i>
                    </div>
                    <h2 class="h4 fw-bold text-white mb-0">{{ document.titre }}</h2>
                    <span class="badge rounded-pill bg-white bg-opacity-25 text-white px-3 py-2 mt-2">
                        ID: #{{ document.id }}
                    </span>
                </div>
                <div class="card-body p-4 bg-white">
                    <h6 class="text-uppercase text-muted small fw-bold mb-4 border-bottom pb-2">Propriétés du Document</h6>
                    
                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted small">Type</span>
                        <span class="badge bg-light text-dark px-3 py-1 rounded-pill text-capitalize">{{ document.typeDocument }}</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted small">Catégorie</span>
                        <span class="fw-bold small" style="color: {{ document.categorie.couleur|default('#4e73df') }};">
                            <i class="fas fa-tag me-1"></i> {{ document.categorie.nomCategorie|default('Sans catégorie') }}
                        </span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted small">Dossier</span>
                        <span class="text-dark small fw-bold">{{ document.dossier.nomDossier|default('Hors dossier') }}</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Propriétaire</span>
                        <div class="text-end">
                            <span class="text-dark fw-bold d-block small">{{ document.utilisateur.fullName ?: document.utilisateur.email }}</span>
                            <span class="text-muted extra-small d-block">{{ document.utilisateur.email }}</span>
                        </div>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted small">Statut</span>
                        {% set status_color = document.statut == 'valide' ? 'success' : (document.statut == 'expire' ? 'danger' : 'warning') %}
                        <span class="badge bg-{{ status_color }} bg-opacity-10 text-{{ status_color }} px-3 py-1 rounded-pill text-capitalize small">
                            {{ document.statut }}
                        </span>
                    </div>

                    <hr class="my-4">

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted small">Date Document</span>
                        <span class="text-dark small fw-bold">{{ document.dateDocument|date('d/m/Y') }}</span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between">
                        <span class="text-muted small">Date Échéance</span>
                        <span class="text-{{ document.dateEcheance < date() ? 'danger' : 'dark' }} small fw-bold">
                            {{ document.dateEcheance ? document.dateEcheance|date('d/m/Y') : 'Aucune' }}
                        </span>
                    </div>

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Taille du fichier</span>
                            <span class="text-dark small fw-bold">{{ (document.tailleFichier / 1024)|number_format(2) }} KB</span>
                        </div>

                        <div class="mb-3 d-flex justify-content-between">
                            <span class="text-muted small">Version courante</span>
                            <span class="text-dark small fw-bold">v{{ document.currentVersionNumber }}</span>
                        </div>

                        {% if document.versions|length %}
                            <div class="mt-4">
                                <label class="text-muted small d-block mb-2">Historique des versions</label>
                                <div class="list-group small">
                                    {% for version in document.versions|slice(0, 5) %}
                                        <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-2">
                                            <span class="fw-semibold">v{{ version.versionNumber }}</span>
                                            <span class="text-muted">{{ version.createdAt|date('d/m/Y H:i') }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                    {% if document.tags|length %}
                        <div class="mt-4">
                            <label class="text-muted small d-block mb-2">Tags</label>
                            <div>
                                {% for tag in document.tags %}
                                    <span class="badge bg-light text-secondary border px-2 py-1 rounded me-1 mb-1">{{ tag.nomTag }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
                <div class="card-footer bg-light border-0 p-4 pt-0">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <a href="{{ path('admin_document_edit', {id: document.id}) }}" class="btn btn-warning w-100 rounded-pill fw-bold text-white shadow-sm btn-sm">
                                <i class="fas fa-edit me-2"></i> Modifier
                            </a>
                        </div>
                        <div class="col-6">
                            <form method="post" action="{{ path('admin_document_delete', {'id': document.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce document ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                                <button class="btn btn-danger w-100 rounded-pill fw-bold shadow-sm btn-sm">
                                    <i class="fas fa-trash-alt me-2"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                    
                    {% include 'partials/_share_buttons.html.twig' %}
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 h-100 bg-dark overflow-hidden">
                <div class="card-header bg-dark border-bottom border-secondary py-3 d-flex justify-content-between align-items-center">
                    <h5 class="text-white mb-0"><i class="fas fa-eye me-2"></i>Aperçu du Document</h5>
                    <a href="{{ path('document_preview', {id: document.id}) }}" target="_blank" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="fas fa-external-link-alt me-2"></i> Ouvrir plein écran
                    </a>
                </div>
                <div class="card-body p-0 d-flex align-items-center justify-content-center bg-secondary bg-opacity-25" style="min-height: 500px;">
                    {% if document.cheminFichier matches '/\.(pdf)$/i' %}
                        <embed src="{{ path('document_preview', {id: document.id}) }}" type="application/pdf" width="100%" height="600px" />
                    {% elseif document.cheminFichier matches '/\.(jpg|jpeg|png|gif|webp)$/i' %}
                        <img src="{{ path('document_preview', {id: document.id}) }}" class="img-fluid shadow" style="max-height: 550px;" alt="{{ document.titre }}">
                    {% else %}
                        <div class="text-center text-white-50">
                            <i class="fas fa-file-alt fa-5x mb-4 opacity-25"></i>
                            <p>Aperçu non disponible pour ce type de fichier.</p>
                            <a href="{{ path('document_download', {id: document.id}) }}" class="btn btn-primary rounded-pill px-4 mt-2">
                                <i class="fas fa-download me-2"></i> Télécharger le document
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Panneau d'Intelligence Artificielle #}
            {% include 'partials/_intelligence_panel.html.twig' %}

            {# Panneau de traduction #}
            {% include 'partials/_translation_panel.html.twig' %}
        </div>
    </div>
</div>

<style>
    .extra-small { font-size: 0.75rem; }
</style>
{% endblock %}
