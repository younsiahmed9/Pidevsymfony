{% extends 'backoffice/base.html.twig' %}

{% block title %}Modifier la Dépense - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0"><i class="fas fa-edit me-2"></i>Modifier la Dépense #{{ depense.id_depense }}</h3>
            {{ include('backoffice/depense/_delete_form.html.twig') }}
        </div>
        <div class="card-body p-4">
            {{ include('backoffice/depense/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>
</div>
{% endblock %}
