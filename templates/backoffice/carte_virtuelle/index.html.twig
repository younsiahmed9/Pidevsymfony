{% extends 'backoffice/base.html.twig' %}

{% block title %}Admin - Cartes Virtuelles{% endblock %}

{% block body %}
<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Cartes Virtuelles</h1>
        <a href="{{ path('admin_carte_virtuelle_export_pdf') }}" class="btn btn-danger btn-sm">
            <i class="fas fa-file-pdf me-1"></i> Exporter PDF
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Carte</th>
                    <th>Type</th>
                    <th>Portefeuille</th>
                    <th>Propriétaire</th>
                    <th>Devise</th>
                    <th>Solde</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for carte in cartes %}
                    <tr>
                        <td>{{ carte.id }}</td>
                        <td>**** **** **** {{ carte.numeroCarte|slice(-4) }}</td>
                        <td>{{ carte.type }}</td>
                        <td>{{ carte.portefeuille ? carte.portefeuille.nom : '-' }}</td>
                        <td>{{ carte.portefeuille and carte.portefeuille.user ? (carte.portefeuille.user.fullName ?: '-') : '-' }}</td>
                        <td>{{ carte.devise }}</td>
                        <td>{{ carte.solde|number_format(2, ',', ' ') }}</td>
                        <td>
                            <span class="badge {{ carte.isIsActive ? 'text-bg-success' : 'text-bg-danger' }}">
                                {{ carte.isIsActive ? 'Active' : 'Inactive' }}
                            </span>
                        </td>
                        <td>
                            {% include 'backoffice/carte_virtuelle/_delete_form.html.twig' with {carte: carte} %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="9" class="text-center py-4">Aucune carte trouvée.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
