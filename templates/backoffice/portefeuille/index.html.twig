{% extends 'backoffice/base.html.twig' %}

{% block title %}Admin - Portefeuilles{% endblock %}

{% block body %}
<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Portefeuilles</h1>
        <a href="{{ path('admin_portefeuille_export_pdf') }}" class="btn btn-danger btn-sm">
            <i class="fas fa-file-pdf me-1"></i> Exporter PDF
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Utilisateur</th>
                    <th>Email</th>
                    <th>Devise</th>
                    <th>Solde</th>
                    <th>Créé le</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for portefeuille in portefeuilles %}
                    <tr>
                        <td>{{ portefeuille.id }}</td>
                        <td>{{ portefeuille.nom }}</td>
                        <td>{{ portefeuille.user ? (portefeuille.user.fullName ?: '-') : '-' }}</td>
                        <td>{{ portefeuille.user ? portefeuille.user.email : '-' }}</td>
                        <td>{{ portefeuille.devisePrincipale }}</td>
                        <td>{{ portefeuille.soldeTotal|number_format(2, ',', ' ') }}</td>
                        <td>{{ portefeuille.createdAt ? portefeuille.createdAt|date('Y-m-d H:i') : '-' }}</td>
                        <td>
                            {% include 'backoffice/portefeuille/_delete_form.html.twig' with {portefeuille: portefeuille} %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4">Aucun portefeuille trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
