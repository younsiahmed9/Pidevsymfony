{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_label(form.compte, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.compte, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.compte) }}
        </div>

        <div class="col-md-6 mb-3">
            {{ form_label(form.montant, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.montant, {'attr': {'class': 'form-control', 'placeholder': '0.00'}}) }}
            {{ form_errors(form.montant) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_label(form.tauxInteret, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.tauxInteret, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 5.5'}}) }}
            {{ form_errors(form.tauxInteret) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_label(form.dureeMois, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.dureeMois, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 12, 24, 36...'}}) }}
            {{ form_errors(form.dureeMois) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_label(form.status, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.status) }}
        </div>

        <div class="col-md-6 mb-3">
            {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.dateDebut) }}
        </div>
    </div>

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4 shadow-sm">
            <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer le crédit') }}
        </button>
        <a href="{{ path('admin_credit_index') }}" class="btn btn-outline-secondary px-4">
            <i class="fas fa-times me-2"></i>Annuler
        </a>
    </div>
{{ form_end(form) }}
