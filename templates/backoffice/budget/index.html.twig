{% extends 'backoffice/base.html.twig' %}

{% block title %}Gestion des Budgets - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-wallet me-2 text-primary"></i>Gestion des Budgets</h1>
        <a href="{{ path('admin_budget_new') }}" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Nouveau Budget
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Budgets</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ budgets|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Actifs</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ budgets|filter(b => b.statut == 'actif')|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">En Attente</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ budgets|filter(b => b.statut == 'en_attente')|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-pause-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Fermés</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ budgets|filter(b => b.statut == 'ferme')|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-times-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">📋 Liste des Budgets</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Propriétaire</th>
                            <th>Montant Total</th>
                            <th>Période</th>
                            <th>Statut</th>
                            <th>Date Création</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for budget in budgets %}
                            <tr>
                                <td>#{{ budget.id_budget }}</td>
                                <td><span class="fw-bold text-dark">{{ budget.nom_budget }}</span></td>
                                <td>
                                    <div class="small">
                                        <i class="fas fa-user me-1 text-muted"></i> {{ budget.user_prenom }} {{ budget.user_nom }}<br>
                                        <i class="fas fa-envelope me-1 text-muted"></i> {{ budget.user_email }}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-soft-info text-info border border-info px-3">
                                        {{ budget.montant_total|number_format(2, ',', ' ') }} TND
                                    </span>
                                </td>
                                <td><span class="text-muted">{{ budget.periode|capitalize }}</span></td>
                                <td>
                                    {% set badge_class = budget.statut == 'actif' ? 'success' : (budget.statut == 'en_attente' ? 'warning' : 'danger') %}
                                    <span class="badge rounded-pill bg-{{ badge_class }}">
                                        {{ budget.statut|capitalize }}
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        {{ budget.date_creation ? budget.date_creation|date('d/m/Y') : '-' }}<br>
                                        {{ budget.date_creation ? budget.date_creation|date('H:i') : '' }}
                                    </small>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a href="{{ path('admin_budget_show', {id: budget.id_budget}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_budget_edit', {id: budget.id_budget}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin_budget_delete', {id: budget.id_budget}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce budget ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ budget.id_budget) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted mb-3">
                                        <i class="fas fa-folder-open fa-3x mb-3 text-light"></i><br>
                                        Aucun budget trouvé dans la base de données.
                                    </div>
                                    <a href="{{ path('admin_budget_new') }}" class="btn btn-primary btn-sm rounded-pill px-4">
                                        Créer le premier budget
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft-info { background-color: rgba(54, 185, 204, 0.1); }
    .border-left-primary { border-left: .25rem solid #4e73df !important; }
    .border-left-success { border-left: .25rem solid #1cc88a !important; }
    .border-left-info { border-left: .25rem solid #36b9cc !important; }
    .border-left-warning { border-left: .25rem solid #f6c23e !important; }
    .border-left-danger { border-left: .25rem solid #e74a3b !important; }
</style>
{% endblock %}
