{% extends 'backoffice/base.html.twig' %}

{% block title %}Détails du Budget{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <a href="{{ path('admin_budget_index') }}" class="text-decoration-none text-muted mr-2">
                <i class="fas fa-arrow-left fa-sm"></i>
            </a>
            Détails du Budget #{{ budget.id_budget }}
        </h1>
        <div class="btn-group shadow-sm">
            <a href="{{ path('admin_budget_edit', {id: budget.id_budget}) }}" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Modifier
            </a>
            {{ include('backoffice/budget/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="row">
        <!-- Main Info -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Informations Générales</h6>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <label class="small font-weight-bold text-muted text-uppercase d-block">Nom du Budget</label>
                        <span class="h4 font-weight-bold text-dark">{{ budget.nom_budget }}</span>
                    </div>
                    
                    <div class="mb-4">
                        <label class="small font-weight-bold text-muted text-uppercase d-block">Propriétaire</label>
                        <div class="d-flex align-items-center">
                            <div class="bg-light rounded-circle p-2 mr-3">
                                <i class="fas fa-user text-primary"></i>
                            </div>
                            <div>
                                <div class="font-weight-bold text-dark">{{ budget.user_prenom }} {{ budget.user_nom }}</div>
                                <div class="small text-muted">{{ budget.user_email }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6 border-right">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Montant Total</label>
                            <span class="h5 font-weight-bold text-primary">{{ budget.montant_total|number_format(2, ',', ' ') }} TND</span>
                        </div>
                        <div class="col-6 pl-3">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Période</label>
                            <span class="h5 font-weight-bold text-dark">{{ budget.periode|capitalize }}</span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 border-right">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Statut</label>
                            {% set badge_class = budget.statut == 'actif' ? 'success' : (budget.statut == 'en_attente' ? 'warning' : 'danger') %}
                            <span class="badge rounded-pill bg-{{ badge_class }} px-3 py-2">
                                {{ budget.statut|capitalize }}
                            </span>
                        </div>
                        <div class="col-6 pl-3">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Créé le</label>
                            <span class="text-dark">{{ budget.date_creation|date('d/m/Y') }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Associated Expenses -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Dépenses Associées</h6>
                    <span class="badge bg-primary rounded-pill">{{ depenses|length }}</span>
                </div>
                <div class="card-body">
                    {% if depenses %}
                        <div class="table-responsive">
                            <table class="table table-bordered" width="100%" cellspacing="0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Catégorie</th>
                                        <th>Montant</th>
                                        <th>Description</th>
                                        <th>Mode</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for depense in depenses %}
                                        <tr>
                                            <td>{{ depense.date_depense|date('d/m/Y') }}</td>
                                            <td><strong>{{ depense.categorie }}</strong></td>
                                            <td><span class="text-danger font-weight-bold">-{{ depense.montant|number_format(2, ',', ' ') }} TND</span></td>
                                            <td><small>{{ depense.description }}</small></td>
                                            <td><span class="badge bg-light text-dark">{{ depense.mode_paiement }}</span></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-receipt fa-3x text-light mb-3"></i>
                            <p class="text-muted">Aucune dépense enregistrée pour ce budget.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
