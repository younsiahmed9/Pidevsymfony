<form method="post" action="{{ path('admin_budget_delete', {'id': budget.id_budget}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce budget ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ budget.id_budget) }}">
    <button class="btn btn-danger">
        <i class="fas fa-trash me-1"></i> Supprimer
    </button>
</form>
