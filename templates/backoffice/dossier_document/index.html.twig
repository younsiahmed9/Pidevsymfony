{% extends 'backoffice/base.html.twig' %}

{% block title %}Gestion des Dossiers - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
        <div>
            <h1 class="h3 mb-1 text-gray-800"><i class="fas fa-folder-open me-2 text-primary"></i>Gestion des Dossiers</h1>
            <p class="text-muted small mb-0">Administrez les dossiers de documents de tous les utilisateurs.</p>
        </div>
        <a href="{{ path('admin_dossier_document_new') }}" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Nouveau Dossier
        </a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <form method="GET" action="{{ path('admin_dossier_document_index') }}" class="row g-3 align-items-end">
                <div class="col-md-10">
                    <label class="form-label small fw-bold text-uppercase text-muted">Rechercher par nom, description ou utilisateur</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="q" value="{{ q }}" class="form-control bg-light border-0 shadow-none" placeholder="Tapez votre recherche ici...">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-header py-3 bg-white border-bottom-0 rounded-top-4">
            <h6 class="m-0 fw-bold text-primary">📋 Liste des Dossiers de Documents</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Dossier</th>
                            <th>Propriétaire</th>
                            <th>Documents</th>
                            <th>Créé le</th>
                            <th>Mis à jour</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for dossier in dossiers %}
                            <tr>
                                <td class="ps-3 text-muted small">#{{ dossier.id }}</td>
                                <td>
                                    <div class="fw-bold text-dark">{{ dossier.nomDossier }}</div>
                                    {% if dossier.description %}<div class="small text-muted">{{ dossier.description }}</div>{% endif %}
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">{{ dossier.utilisateur.fullName ?: dossier.utilisateur.email }}</div>
                                    <div class="small text-muted">{{ dossier.utilisateur.email }}</div>
                                </td>
                                <td><span class="badge bg-info">{{ dossier.documents|length }}</span></td>
                                <td class="small text-muted">{{ dossier.createdAt ? dossier.createdAt|date('d/m/Y H:i') : '-' }}</td>
                                <td class="small text-muted">{{ dossier.updatedAt ? dossier.updatedAt|date('d/m/Y H:i') : '-' }}</td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm btn-action-toolbar" role="group">
                                        <a href="{{ path('admin_dossier_document_show', {id: dossier.id}) }}" class="btn btn-sm btn-outline-primary btn-action-icon btn-sm" title="Voir"><i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Voir</span></a>
                                        <a href="{{ path('admin_dossier_document_edit', {id: dossier.id}) }}" class="btn btn-sm btn-outline-warning btn-action-icon btn-sm" title="Modifier"><i class="fas fa-pen" aria-hidden="true"></i><span class="visually-hidden">Modifier</span></a>
                                        {% include 'backoffice/dossier_document/_delete_form.html.twig' with {action: path('admin_dossier_document_delete', {id: dossier.id}), dossier: dossier} %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">Aucun dossier trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}