{% extends 'backoffice/base.html.twig' %}

{% block title %}Nouveau Dossier - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4">
    <div class="card shadow border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h1 class="h5 mb-0">Nouveau Dossier de Documents</h1>
            <a href="{{ path('admin_dossier_document_index') }}" class="btn btn-outline-secondary btn-sm">Retour</a>
        </div>
        <div class="card-body p-4">
            <form method="post">
                {% include 'backoffice/dossier_document/_form.html.twig' %}
                <div class="mt-4 d-flex gap-2">
                    <button class="btn btn-primary">Créer</button>
                    <a href="{{ path('admin_dossier_document_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}