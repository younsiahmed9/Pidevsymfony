{% extends 'backoffice/base.html.twig' %}

{% block title %}Dossier #{{ dossier.id }} - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Dossier de Documents #{{ dossier.id }}</h1>
        <div class="d-flex gap-2">
            <a href="{{ path('admin_dossier_document_edit', {id: dossier.id}) }}" class="btn btn-warning">Modifier</a>
            {% include 'backoffice/dossier_document/_delete_form.html.twig' with {action: path('admin_dossier_document_delete', {id: dossier.id}), dossier: dossier} %}
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Nom</dt>
                <dd class="col-sm-9">{{ dossier.nomDossier }}</dd>
                <dt class="col-sm-3">Propriétaire</dt>
                <dd class="col-sm-9">{{ dossier.utilisateur.fullName ?: dossier.utilisateur.email }} ({{ dossier.utilisateur.email }})</dd>
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">{{ dossier.description ?: '-' }}</dd>
                <dt class="col-sm-3">Créé le</dt>
                <dd class="col-sm-9">{{ dossier.createdAt ? dossier.createdAt|date('d/m/Y H:i') : '-' }}</dd>
                <dt class="col-sm-3">Mis à jour</dt>
                <dd class="col-sm-9">{{ dossier.updatedAt ? dossier.updatedAt|date('d/m/Y H:i') : '-' }}</dd>
            </dl>
        </div>
    </div>
</div>
{% endblock %}