<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Utilisateur</label>
        <select name="id_utilisateur" class="form-select" required>
            <option value="">-- Sélectionner --</option>
            {% for user in users %}
                <option value="{{ user.id }}" {{ selectedUserId|default(null) == user.id ? 'selected' : '' }}>
                    {{ user.fullName ?: user.email }} ({{ user.email }})
                </option>
            {% endfor %}
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Nom du dossier</label>
        <input type="text" name="nom_dossier" class="form-control" value="{{ dossier.nomDossier|default('') }}" required>
    </div>
    <div class="col-12">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="4">{{ dossier.description|default('') }}</textarea>
    </div>
</div><form method="post" class="needs-validation" novalidate>
    <div class="mb-4">
        <label for="id_utilisateur" class="form-label fw-bold text-dark mb-2">Utilisateur propriétaire</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fas fa-user text-muted"></i></span>
            <select id="id_utilisateur" name="id_utilisateur" class="form-select bg-light border-0 py-3 shadow-none" required>
                <option value="">Sélectionnez un utilisateur...</option>
                {% for user in users %}
                    <option value="{{ user.id }}" {{ dossier.utilisateur and dossier.utilisateur.id == user.id ? 'selected' : '' }}>
                        {{ user.fullName ?: user.email }} ({{ user.email }})
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="invalid-feedback">Veuillez sélectionner un utilisateur propriétaire.</div>
    </div>

    <div class="mb-4">
        <label for="nom_dossier" class="form-label fw-bold text-dark mb-2">Nom du dossier</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fas fa-folder text-muted"></i></span>
            <input type="text" id="nom_dossier" name="nom_dossier" class="form-control bg-light border-0 py-3 shadow-none" placeholder="Ex: Contrats de travail" value="{{ dossier.nomDossier|default('') }}" required>
        </div>
        <div class="invalid-feedback">Veuillez donner un nom à ce dossier.</div>
    </div>

    <div class="mb-5">
        <label for="description" class="form-label fw-bold text-dark mb-2">Description (Optionnelle)</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fas fa-align-left text-muted"></i></span>
            <textarea id="description" name="description" class="form-control bg-light border-0 py-3 shadow-none" rows="3" placeholder="Description courte du contenu du dossier...">{{ dossier.description|default('') }}</textarea>
        </div>
    </div>

    <div class="d-grid mt-4">
        <button type="submit" class="btn btn-{{ dossier.id ? 'warning text-white' : 'primary' }} btn-lg rounded-pill fw-bold shadow-sm py-3 transition-hover">
            <i class="fas fa-save me-2"></i> {{ dossier.id ? 'Mettre à jour le Dossier' : 'Créer le Dossier' }}
        </button>
    </div>
</form>

<script>
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }
                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>