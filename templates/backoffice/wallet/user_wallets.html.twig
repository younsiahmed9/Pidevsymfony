{% extends 'backoffice/base.html.twig' %}

{% block title %}Admin - Portefeuilles de l utilisateur{% endblock %}

{% block body %}
<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h4 mb-1">Portefeuilles de {{ user.full_name ?: user.email }}</h1>
            <p class="text-light mb-0">Utilisateur #{{ user.id }} - {{ user.email }}</p>
        </div>
        <a href="{{ path('admin_wallet_users') }}" class="btn btn-outline-light">Retour utilisateurs</a>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Portefeuilles</div><div class="h4 mb-0">{{ stats.totalWallets }}</div></div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Solde total</div><div class="h4 mb-0">{{ stats.totalBalance|number_format(2, ',', ' ') }}</div></div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Cartes</div><div class="h4 mb-0">{{ stats.totalCards }}</div></div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Cartes actives</div><div class="h4 mb-0">{{ stats.activeCards }}</div></div></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body border-bottom">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-lg-6">
                    <label class="form-label mb-1">Recherche</label>
                    <input type="search" name="q" class="form-control" value="{{ search }}" placeholder="Nom portefeuille, devise, id...">
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Trier par</label>
                    <select name="sort" class="form-select">
                        <option value="id" {{ sort == 'id' ? 'selected' : '' }}>ID</option>
                        <option value="name" {{ sort == 'name' ? 'selected' : '' }}>Nom</option>
                        <option value="currency" {{ sort == 'currency' ? 'selected' : '' }}>Devise</option>
                        <option value="balance" {{ sort == 'balance' ? 'selected' : '' }}>Solde</option>
                        <option value="cards" {{ sort == 'cards' ? 'selected' : '' }}>Nb cartes</option>
                        <option value="active_cards" {{ sort == 'active_cards' ? 'selected' : '' }}>Cartes actives</option>
                        <option value="created_at" {{ sort == 'created_at' ? 'selected' : '' }}>Date creation</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Ordre</label>
                    <select name="direction" class="form-select">
                        <option value="desc" {{ direction == 'desc' ? 'selected' : '' }}>DESC</option>
                        <option value="asc" {{ direction == 'asc' ? 'selected' : '' }}>ASC</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 d-grid">
                    <button class="btn btn-primary" type="submit">Filtrer</button>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Devise</th>
                        <th>Solde</th>
                        <th>Cartes</th>
                        <th>Actives</th>
                        <th>Maj</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for wallet in wallets %}
                    <tr>
                        <td>{{ wallet.id }}</td>
                        <td>{{ wallet.nom }}</td>
                        <td>{{ wallet.devise_principale }}</td>
                        <td>{{ wallet.solde_total|number_format(2, ',', ' ') }}</td>
                        <td>{{ wallet.cards_count }}</td>
                        <td>{{ wallet.active_cards_count }}</td>
                        <td>{{ wallet.updated_at ? wallet.updated_at|date('Y-m-d H:i') : '-' }}</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_wallet_wallet_cards', {id: wallet.id}) }}">
                                Voir cartes
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-center py-4">Aucun portefeuille trouve.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
