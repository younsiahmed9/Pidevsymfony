{% extends 'backoffice/base.html.twig' %}

{% block title %}Admin - Modifier carte{% endblock %}

{% block body %}
<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h4 mb-1">Modifier la carte #{{ card.id }}</h1>
            <p class="text-light mb-0">Portefeuille: {{ card.wallet_name }}</p>
        </div>
        <a href="{{ path('admin_wallet_wallet_cards', {id: card.portefeuille_id}) }}" class="btn btn-outline-light">Retour cartes</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="post" class="row g-3">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_edit_card_' ~ card.id) }}">

                <div class="col-md-6">
                    <label class="form-label">Numero carte</label>
                    <input class="form-control" value="**** **** **** {{ card.numero_carte|slice(-4) }}" disabled>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Date expiration</label>
                    <input type="text" name="date_expiration" class="form-control" placeholder="YYYY-MM-DD" value="{{ card.date_expiration ? card.date_expiration|date('Y-m-d') : '' }}">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Type</label>
                    <select name="type" class="form-select">
                        <option value="">-- Selectionnez un type --</option>
                        <option value="NORMAL" {{ card.type == 'NORMAL' ? 'selected' : '' }}>NORMAL</option>
                        <option value="SILVER" {{ card.type == 'SILVER' ? 'selected' : '' }}>SILVER</option>
                        <option value="GOLD" {{ card.type == 'GOLD' ? 'selected' : '' }}>GOLD</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Devise</label>
                    <select name="devise" class="form-select">
                        <option value="">-- Selectionnez une devise --</option>
                        <option value="TND" {{ card.devise == 'TND' ? 'selected' : '' }}>TND</option>
                        <option value="EUR" {{ card.devise == 'EUR' ? 'selected' : '' }}>EUR</option>
                        <option value="USD" {{ card.devise == 'USD' ? 'selected' : '' }}>USD</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Solde</label>
                    <input type="text" name="solde" class="form-control" placeholder="0.00" value="{{ card.solde }}">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Plafond</label>
                    <input type="text" name="plafond" class="form-control" placeholder="0.00" value="{{ card.plafond }}">
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="is_active" name="is_active" value="1" {{ card.is_active ? 'checked' : '' }}>
                        <label class="form-check-label" for="is_active">Carte active</label>
                    </div>
                </div>

                {% if app.flashes('form_error') %}
                    <div class="col-12">
                        <div class="alert alert-danger">
                            <strong>Erreurs de validation :</strong>
                            <ul class="mb-0">
                                {% for error in app.flashes('form_error') %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a href="{{ path('admin_wallet_wallet_cards', {id: card.portefeuille_id}) }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
