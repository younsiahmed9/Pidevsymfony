{% extends 'backoffice/base.html.twig' %}

{% block title %}Admin - Historique des Frais de Transfert{% endblock %}

{% block body %}
<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h4 mb-1">Historique des Frais de Transfert</h1>
            <p class="text-light mb-0">Consultez et analysez tous les frais collectes sur les transferts.</p>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-3">
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Nombre de Frais</div>
                    <div class="h4 mb-0">{{ stats.totalFees }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Montant Total Transfere</div>
                    <div class="h4 mb-0">{{ stats.totalAmount|number_format(2, ',', ' ') }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Frais Collectes</div>
                    <div class="h4 mb-0 text-success">{{ stats.totalFeeCollected|number_format(2, ',', ' ') }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Avg Taux de Frais</div>
                    <div class="h4 mb-0">{{ (stats.avgFeeRate * 100)|round(2) }}%</div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">A 1% (Reduits)</div>
                    <div class="h4 mb-0 text-info">{{ stats.discountedCount }}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Date From</label>
                    <input type="date" name="date_from" class="form-control" value="{{ dateFrom }}">
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Date To</label>
                    <input type="date" name="date_to" class="form-control" value="{{ dateTo }}">
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Utilisateur</label>
                    <select name="user_id" class="form-select">
                        <option value="">-- Tous --</option>
                        {% for user in allUsers %}
                            <option value="{{ user.id }}" {% if userId == user.id %}selected{% endif %}>
                                {{ user.full_name }} ({{ user.email }})
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Carte</label>
                    <select name="card_id" class="form-select">
                        <option value="">-- Toutes --</option>
                        {% for card in allCards %}
                            <option value="{{ card.id }}" {% if cardId == card.id %}selected{% endif %}>
                                {{ card.numero_carte }} ({{ card.devise }}) - {{ card.wallet_name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Taux de Frais</label>
                    <select name="fee_rate" class="form-select">
                        <option value="">-- Tous --</option>
                        <option value="0.02" {% if feeRate == '0.02' %}selected{% endif %}>2%</option>
                        <option value="0.01" {% if feeRate == '0.01' %}selected{% endif %}>1%</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 d-grid">
                    <button class="btn btn-primary" type="submit">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Sort Controls -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body border-bottom">
            <form method="get" class="row g-2 align-items-end">
                <!-- Hidden inputs to preserve filters -->
                <input type="hidden" name="date_from" value="{{ dateFrom }}">
                <input type="hidden" name="date_to" value="{{ dateTo }}">
                <input type="hidden" name="user_id" value="{{ userId }}">
                <input type="hidden" name="card_id" value="{{ cardId }}">
                <input type="hidden" name="fee_rate" value="{{ feeRate }}">
                
                <div class="col-lg-3">
                    <label class="form-label mb-1">Trier par</label>
                    <select name="sort" class="form-select">
                        <option value="id" {{ sort == 'id' ? 'selected' : '' }}>ID</option>
                        <option value="amount" {{ sort == 'amount' ? 'selected' : '' }}>Montant</option>
                        <option value="fee" {{ sort == 'fee' ? 'selected' : '' }}>Frais</option>
                        <option value="rate" {{ sort == 'rate' ? 'selected' : '' }}>Taux</option>
                        <option value="window" {{ sort == 'window' ? 'selected' : '' }}>Compte Fenetre</option>
                        <option value="user" {{ sort == 'user' ? 'selected' : '' }}>Utilisateur</option>
                        <option value="card" {{ sort == 'card' ? 'selected' : '' }}>Carte Source</option>
                        <option value="created_at" {{ sort == 'created_at' ? 'selected' : '' }}>Date</option>
                    </select>
                </div>
                <div class="col-lg-2">
                    <label class="form-label mb-1">Ordre</label>
                    <select name="direction" class="form-select">
                        <option value="desc" {{ direction == 'desc' ? 'selected' : '' }}>DESC</option>
                        <option value="asc" {{ direction == 'asc' ? 'selected' : '' }}>ASC</option>
                    </select>
                </div>
                <div class="col-lg-3 d-grid">
                    <button class="btn btn-secondary" type="submit">Appliquer le Tri</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Fees Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Utilisateur</th>
                        <th>Carte Source</th>
                        <th>Carte Destination</th>
                        <th>Montant</th>
                        <th>Devise</th>
                        <th>Taux Applique</th>
                        <th>Frais</th>
                        <th>Fenetre</th>
                        <th>Regle</th>
                        <th>Type</th>
                    </tr>
                </thead>
                <tbody>
                    {% if fees|length > 0 %}
                        {% for fee in fees %}
                            <tr>
                                <td class="fw-bold">
                                    <a href="#" class="text-decoration-none">{{ fee.id }}</a>
                                </td>
                                <td>
                                    <small>{{ fee.created_at|date('d/m/Y H:i') }}</small>
                                </td>
                                <td>
                                    <small class="text-muted">{{ fee.user_name }}</small><br>
                                    <small class="text-muted">{{ fee.user_email }}</small>
                                </td>
                                <td>
                                    <small>{{ fee.source_card }}</small><br>
                                    <small class="text-muted">{{ fee.source_wallet }}</small>
                                </td>
                                <td>
                                    <small>{{ fee.dest_card }}</small><br>
                                    <small class="text-muted">{{ fee.dest_wallet }}</small>
                                </td>
                                <td class="fw-bold">
                                    {{ fee.amount|number_format(2, ',', ' ') }}
                                </td>
                                <td>{{ fee.currency }}</td>
                                <td>
                                    <span class="badge {% if fee.applied_fee_rate == 0.02000 %}bg-warning{% else %}bg-success{% endif %}">
                                        {{ (fee.applied_fee_rate * 100)|round(2) }}%
                                    </span>
                                </td>
                                <td class="text-success fw-bold">
                                    {{ fee.fee_amount|number_format(2, ',', ' ') }}
                                </td>
                                <td>
                                    <small class="badge bg-info">{{ fee.transfer_count_in_window }}</small>
                                </td>
                                <td>
                                    <small class="text-muted">{{ fee.rule_name ?: '--' }}</small>
                                </td>
                                <td>
                                    {% if fee.transaction_id %}
                                        <small class="badge bg-primary">Transfert</small>
                                    {% elseif fee.virement_programme_id %}
                                        <small class="badge bg-secondary">Programme</small>
                                    {% else %}
                                        <small class="text-muted">--</small>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">
                                Aucun frais trouves pour los criteres fournis.
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
