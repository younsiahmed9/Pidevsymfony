{% extends 'backoffice/base.html.twig' %}

{% block title %}Admin - Utilisateurs Portefeuille{% endblock %}

{% block body %}
<div class="container-fluid px-3 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h4 mb-1">Gestion Admin Portefeuilles</h1>
            <p class="text-light mb-0">Cliquez sur un utilisateur pour voir ses portefeuilles.</p>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Utilisateurs</div>
                    <div class="h4 mb-0">{{ kpis.totalUsers }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Portefeuilles</div>
                    <div class="h4 mb-0">{{ kpis.totalWallets }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Solde cumule</div>
                    <div class="h4 mb-0">{{ kpis.totalBalance|number_format(2, ',', ' ') }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Cartes</div>
                    <div class="h4 mb-0">{{ kpis.totalCards }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Cartes actives</div>
                    <div class="h4 mb-0">{{ kpis.activeCards }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body border-bottom">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-lg-6">
                    <label class="form-label mb-1">Recherche</label>
                    <input type="search" name="q" class="form-control" value="{{ search }}" placeholder="Nom, email, id...">
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Trier par</label>
                    <select name="sort" class="form-select">
                        <option value="id" {{ sort == 'id' ? 'selected' : '' }}>ID</option>
                        <option value="name" {{ sort == 'name' ? 'selected' : '' }}>Nom</option>
                        <option value="email" {{ sort == 'email' ? 'selected' : '' }}>Email</option>
                        <option value="wallets" {{ sort == 'wallets' ? 'selected' : '' }}>Nb portefeuilles</option>
                        <option value="balance" {{ sort == 'balance' ? 'selected' : '' }}>Solde cumule</option>
                        <option value="cards" {{ sort == 'cards' ? 'selected' : '' }}>Nb cartes</option>
                        <option value="created_at" {{ sort == 'created_at' ? 'selected' : '' }}>Date creation</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label mb-1">Ordre</label>
                    <select name="direction" class="form-select">
                        <option value="desc" {{ direction == 'desc' ? 'selected' : '' }}>DESC</option>
                        <option value="asc" {{ direction == 'asc' ? 'selected' : '' }}>ASC</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 d-grid">
                    <button class="btn btn-primary" type="submit">Filtrer</button>
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Statut</th>
                        <th>Portefeuilles</th>
                        <th>Solde cumule</th>
                        <th>Cartes</th>
                        <th>Actives</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.full_name ?: '-' }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% if user.is_active %}
                                <span class="badge text-bg-success">Actif</span>
                            {% else %}
                                <span class="badge text-bg-danger">Inactif</span>
                            {% endif %}
                        </td>
                        <td>{{ user.wallets_count }}</td>
                        <td>{{ user.wallets_balance|number_format(2, ',', ' ') }}</td>
                        <td>{{ user.cards_count }}</td>
                        <td>{{ user.active_cards_count }}</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_wallet_user_wallets', {id: user.id}) }}">
                                Voir portefeuilles
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center py-4">Aucun utilisateur trouve.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
