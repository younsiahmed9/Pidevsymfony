{% extends 'backoffice/base.html.twig' %}

{% block title %}Historique Emails - BackOffice{% endblock %}

{% block body %}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Historique des emails Brevo</h5>
        <span class="badge bg-primary">{{ logs|length }} logs</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Destinataire</th>
                        <th>Template</th>
                        <th>Sujet</th>
                        <th>Statut</th>
                        <th>Erreur</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td>{{ log.createdAt ? log.createdAt|date('Y-m-d H:i:s') : '-' }}</td>
                            <td>{{ log.user ? (log.user.fullName ?: log.user.email) : '-' }}</td>
                            <td>{{ log.recipientEmail }}</td>
                            <td>{{ log.mailTemplate }}</td>
                            <td>{{ log.subject }}</td>
                            <td>
                                <span class="badge {{ log.status == 'SENT' ? 'bg-success' : (log.status == 'FAILED' ? 'bg-danger' : 'bg-secondary') }}">
                                    {{ log.status }}
                                </span>
                            </td>
                            <td>
                                {% if log.errorMessage %}
                                    <span title="{{ log.errorMessage }}">{{ log.errorMessage|slice(0, 60) }}{{ log.errorMessage|length > 60 ? '...' : '' }}</span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Aucune trace email.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}