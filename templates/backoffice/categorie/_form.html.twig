<form method="POST" novalidate>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="nom_categorie" class="form-label fw-bold small text-uppercase">Nom de la Catégorie</label>
            <input type="text" id="nom_categorie" name="nom_categorie" class="form-control" value="{{ categorie.nomCategorie|default('') }}" placeholder="Ex: Assurance, Santé, Loisirs..." required>
        </div>

        <div class="col-md-3 mb-3">
            <label for="icon" class="form-label fw-bold small text-uppercase">Icône (FontAwesome)</label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="{{ categorie.icon|default('fas fa-tag') }}"></i></span>
                <input type="text" id="icon" name="icon" class="form-control" value="{{ categorie.icon|default('fas fa-tag') }}" placeholder="fas fa-tag">
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <label for="couleur" class="form-label fw-bold small text-uppercase">Couleur</label>
            <input type="color" id="couleur" name="couleur" class="form-control form-control-color w-100" value="{{ categorie.couleur|default('#4e73df') }}" title="Choisir une couleur">
        </div>

        <div class="col-md-12 mb-3">
            <label for="description" class="form-label fw-bold small text-uppercase">Description</label>
            <textarea id="description" name="description" class="form-control" rows="3" placeholder="Description facultative de la catégorie...">{{ categorie.description|default('') }}</textarea>
        </div>
    </div>

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4 shadow-sm">
            <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer la catégorie') }}
        </button>
        <a href="{{ path('admin_categorie_index') }}" class="btn btn-outline-secondary px-4">
            <i class="fas fa-times me-2"></i>Annuler
        </a>
    </div>
</form>
