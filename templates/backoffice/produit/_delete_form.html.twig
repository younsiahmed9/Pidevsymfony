<form method="post" action="{{ path('admin_produit_delete', {'id': produit.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
    <button class="btn btn-danger shadow-sm">
        <i class="fas fa-trash me-1"></i> Supprimer
    </button>
</form>
