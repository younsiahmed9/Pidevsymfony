{% extends 'backoffice/base.html.twig' %}

{% block title %}Produit: {{ produit.nomProduit }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">{{ produit.nomProduit }}</h1>

    <table class="table">
        <tr>
            <th>ID:</th>
            <td>{{ produit.id }}</td>
        </tr>
        <tr>
            <th>Nom:</th>
            <td>{{ produit.nomProduit }}</td>
        </tr>
        <tr>
            <th>Type:</th>
            <td>{{ produit.typeProduit }}</td>
        </tr>
        <tr>
            <th>Montant:</th>
            <td>${{ produit.montant }}</td>
        </tr>
        <tr>
            <th>Code Unique:</th>
            <td>{{ produit.codeUnique }}</td>
        </tr>
        <tr>
            <th>Statut:</th>
            <td>
                <span class="badge
                    {% if produit.statut == 'disponible' %}bg-success{% elseif produit.statut == 'vendu' %}bg-warning{% else %}bg-danger{% endif %}">
                    {{ produit.statut }}
                </span>
            </td>
        </tr>
        <tr>
            <th>Date Création:</th>
            <td>{{ produit.dateCreation|date('Y-m-d H:i:s') }}</td>
        </tr>
    </table>

    <a href="{{ path('admin_produit_edit', {'id': produit.id}) }}" class="btn btn-warning">Modifier</a>
    <a href="{{ path('admin_produit_index') }}" class="btn btn-secondary">Retour</a>
</div>
{% endblock %}
