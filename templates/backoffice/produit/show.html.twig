{% extends 'backoffice/base.html.twig' %}

{% block title %}Détails du Produit - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <a href="{{ path('admin_produit_index') }}" class="text-decoration-none text-muted me-2">
                <i class="fas fa-arrow-left fa-sm"></i>
            </a>
            Détails du Produit #{{ produit.id }}
        </h1>
        <div class="btn-group shadow-sm">
            <a href="{{ path('admin_produit_edit', {id: produit.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Modifier
            </a>
            {{ include('backoffice/produit/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="row">
        <div class="col-xl-7 col-lg-6">
            <div class="card shadow mb-4 h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Fiche Produit</h6>
                </div>
                <div class="card-body">
                    <div class="mb-4 text-center">
                        <label class="small font-weight-bold text-muted text-uppercase d-block">Prix / Valeur</label>
                        <span class="h1 font-weight-bold text-primary">{{ produit.montant|number_format(2, ',', ' ') }} TND</span>
                    </div>

                    <div class="mb-4">
                        <label class="small font-weight-bold text-muted text-uppercase d-block">Nom du Produit</label>
                        <span class="h4 font-weight-bold text-dark">{{ produit.nomProduit }}</span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6 border-end">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Code Unique</label>
                            <code class="h5 fw-bold text-primary">{{ produit.codeUniqueDisplay }}</code>
                        </div>
                        <div class="col-6 ps-3">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Type</label>
                            <span class="h5 fw-bold text-dark">{{ produit.typeProduitLabel }}</span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6 border-end">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Statut</label>
                            {% set badge_class = produit.statut == 'disponible' ? 'success' : (produit.statut == 'vendu' ? 'info' : (produit.statut == 'en_reparation' ? 'warning' : 'danger')) %}
                            <span class="badge rounded-pill bg-{{ badge_class }} fs-6 px-3">
                                {{ produit.statut|capitalize|replace({'_': ' '}) }}
                            </span>
                        </div>
                        <div class="col-6 ps-3">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Date d'enregistrement</label>
                            <span class="text-dark fw-bold">{{ produit.dateCreation|date('d/m/Y H:i') }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5 col-lg-6">
            <div class="card shadow mb-4 h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Informations sur le Propriétaire</h6>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-4 d-inline-block mb-3">
                            <i class="fas fa-user fa-4x text-primary"></i>
                        </div>
                        <h4 class="font-weight-bold text-dark">{{ produit.user_prenom }} {{ produit.user_nom }}</h4>
                        <p class="text-muted"><i class="fas fa-envelope me-2"></i>{{ produit.user_email }}</p>
                    </div>
                    <hr>
                    <div class="mt-4">
                        <label class="small font-weight-bold text-muted text-uppercase d-block mb-2">Autres détails</label>
                        <p class="small text-muted mb-1">ID Utilisateur: <span class="text-dark fw-bold">#{{ produit.user_id }}</span></p>
                        <p class="small text-muted">ID Produit: <span class="text-dark fw-bold">#{{ produit.id }}</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
