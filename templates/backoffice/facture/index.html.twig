{% extends 'backoffice/base_admin.html.twig' %}

{% block title %}Factures{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Liste des Factures</h1>
    
    <a href="{{ path('admin_facture_new') }}" class="btn btn-primary mb-3">Ajouter une Facture</a>

    {% if factures|length > 0 %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Numéro</th>
                    <th>Montant</th>
                    <th>Service</th>
                    <th>Produit</th>
                    <th>Date Facture</th>
                    <th>Date Échéance</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for facture in factures %}
                    <tr>
                        <td>{{ facture.id }}</td>
                        <td>{{ facture.numeroFacture }}</td>
                        <td>${{ facture.montant }}</td>
                        <td>{{ facture.service.nomService ?? '-' }}</td>
                        <td>{{ facture.produit.nomProduit ?? '-' }}</td>
                        <td>{{ facture.dateFacture|date('Y-m-d') }}</td>
                        <td>{{ facture.dateEcheance|date('Y-m-d') }}</td>
                        <td>
                            <span class="badge
                                {% if facture.statut == 'payee' %}bg-success{% elseif facture.statut == 'en_attente' %}bg-warning{% else %}bg-danger{% endif %}">
                                {{ facture.statut }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('admin_facture_show', {'id': facture.id}) }}" class="btn btn-sm btn-info">Voir</a>
                            <a href="{{ path('admin_facture_edit', {'id': facture.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                            <form method="POST" action="{{ path('admin_facture_delete', {'id': facture.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ facture.id) }}">
                                <button class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="alert alert-info">Aucune facture trouvée.</div>
    {% endif %}
</div>
{% endblock %}
