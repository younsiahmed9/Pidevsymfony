{% extends 'backoffice/base.html.twig' %}

{% block title %}Gestion des Factures - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-file-invoice-dollar me-2 text-primary"></i>Gestion des Factures</h1>
        <a href="{{ path('admin_facture_new') }}" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Nouvelle Facture
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Factures</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ factures|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Payées</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ factures|filter(f => f.statut == 'payee')|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-double fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Non Payées</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ factures|filter(f => f.statut == 'non_payee')|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">📋 Journal des Factures</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>N° Facture</th>
                            <th>Utilisateur</th>
                            <th>Montant</th>
                            <th>Date Facture</th>
                            <th>Échéance</th>
                            <th>Statut</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for facture in factures %}
                            <tr>
                                <td><span class="fw-bold text-dark">{{ facture.numeroFacture }}</span></td>
                                <td>
                                    <div class="small">
                                        <i class="fas fa-user me-1 text-muted"></i> {{ facture.user_prenom }} {{ facture.user_nom }}<br>
                                        <i class="fas fa-envelope me-1 text-muted"></i> {{ facture.user_email }}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-soft-primary text-primary border border-primary px-3">
                                        {{ facture.montant|number_format(2, ',', ' ') }} TND
                                    </span>
                                </td>
                                <td>{{ facture.dateFacture|date('d/m/Y') }}</td>
                                <td>{{ facture.dateEcheance ? facture.dateEcheance|date('d/m/Y') : '-' }}</td>
                                <td>
                                    {% set badge_class = facture.statut == 'payee' ? 'success' : (facture.statut == 'non_payee' ? 'danger' : (facture.statut == 'en_retard' ? 'warning' : 'secondary')) %}
                                    <span class="badge rounded-pill bg-{{ badge_class }}">
                                        {{ facture.statut|capitalize|replace({'_': ' '}) }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a href="{{ path('admin_facture_show', {id: facture.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_facture_edit', {id: facture.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin_facture_delete', {id: facture.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette facture ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ facture.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted mb-3">
                                        <i class="fas fa-file-invoice fa-3x mb-3 text-light"></i><br>
                                        Aucune facture trouvée dans la base de données.
                                    </div>
                                    <a href="{{ path('admin_facture_new') }}" class="btn btn-primary btn-sm rounded-pill px-4">
                                        Créer la première facture
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary { background-color: rgba(78, 115, 223, 0.1); }
    .border-left-primary { border-left: .25rem solid #4e73df !important; }
    .border-left-success { border-left: .25rem solid #1cc88a !important; }
    .border-left-danger { border-left: .25rem solid #e74a3b !important; }
</style>
{% endblock %}
