<form method="post" action="{{ path('admin_facture_delete', {'id': facture.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette facture ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ facture.id) }}">
    <button class="btn btn-danger shadow-sm">
        <i class="fas fa-trash me-1"></i> Supprimer
    </button>
</form>
