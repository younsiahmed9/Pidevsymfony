{% extends 'backoffice/base_admin.html.twig' %}

{% block title %}Nouvelle Facture{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white py-3">
            <h3 class="card-title mb-0"><i class="fas fa-file-invoice-dollar me-2"></i>Nouvelle Facture</h3>
        </div>
        <div class="card-body p-4">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.numeroFacture) }}
                    {{ form_widget(form.numeroFacture) }}
                    <div class="text-danger small mt-1">
                        {{ form_errors(form.numeroFacture) }}
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_label(form.montant) }}
                    {{ form_widget(form.montant) }}
                    <div class="text-danger small mt-1">
                        {{ form_errors(form.montant) }}
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_label(form.dateFacture) }}
                    {{ form_widget(form.dateFacture) }}
                    <div class="text-danger small mt-1">
                        {{ form_errors(form.dateFacture) }}
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_label(form.dateEcheance) }}
                    {{ form_widget(form.dateEcheance) }}
                    <div class="text-danger small mt-1">
                        {{ form_errors(form.dateEcheance) }}
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_label(form.service) }}
                    {{ form_widget(form.service) }}
                    <div class="text-danger small mt-1">
                        {{ form_errors(form.service) }}
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_label(form.produit) }}
                    {{ form_widget(form.produit) }}
                    <div class="text-danger small mt-1">
                        {{ form_errors(form.produit) }}
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_label(form.statut) }}
                    {{ form_widget(form.statut) }}
                    <div class="text-danger small mt-1">
                        {{ form_errors(form.statut) }}
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top text-center">
                <div class="text-danger mb-3">
                    {{ form_errors(form) }}
                </div>
                <button type="submit" class="btn btn-primary px-4 rounded-pill">
                    <i class="fas fa-save me-2"></i>Enregistrer
                </button>
                <a href="{{ path('admin_facture_index') }}" class="btn btn-outline-secondary px-4 rounded-pill">
                    <i class="fas fa-arrow-left me-2"></i>Annuler
                </a>
            </div>
            
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
