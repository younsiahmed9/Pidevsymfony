<form method="post" class="needs-validation" novalidate>
    <div class="row g-4">
        <div class="col-md-6">
            <label for="id_utilisateur" class="form-label fw-bold text-dark mb-2">Utilisateur</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fas fa-user text-muted"></i></span>
                <select id="id_utilisateur" name="id_utilisateur" class="form-select bg-light border-0 py-3 shadow-none" required>
                    <option value="">Sélectionner l'utilisateur...</option>
                    {% for user in users %}
                        <option value="{{ user.id }}" {{ echeance.utilisateur and echeance.utilisateur.id == user.id ? 'selected' : '' }}>
                            {{ user.fullName ?: user.email }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="col-md-6">
            <label for="id_document" class="form-label fw-bold text-dark mb-2">Document lié</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fas fa-file-invoice text-muted"></i></span>
                <select id="id_document" name="id_document" class="form-select bg-light border-0 py-3 shadow-none" required>
                    <option value="">Sélectionner le document...</option>
                    {% for doc in documents %}
                        <option value="{{ doc.id }}" {{ echeance.document and echeance.document.id == doc.id ? 'selected' : '' }}>
                            {{ doc.titre }} ({{ doc.utilisateur.fullName ?: doc.utilisateur.email }})
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="col-md-8">
            <label for="titre" class="form-label fw-bold text-dark mb-2">Titre de l'échéance</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fas fa-heading text-muted"></i></span>
                <input type="text" id="titre" name="titre" class="form-control bg-light border-0 py-3 shadow-none" placeholder="Ex: Paiement Loyer Janvier" value="{{ echeance.titre|default('') }}" required>
            </div>
        </div>

        <div class="col-md-4">
            <label for="montant" class="form-label fw-bold text-dark mb-2">Montant (TND)</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fas fa-money-bill-wave text-muted"></i></span>
                <input type="number" step="0.01" id="montant" name="montant" class="form-control bg-light border-0 py-3 shadow-none" placeholder="0.00" value="{{ echeance.montant|default('') }}">
            </div>
        </div>

        <div class="col-md-4">
            <label for="date_echeance" class="form-label fw-bold text-dark mb-2">Date d'échéance</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="far fa-calendar-alt text-muted"></i></span>
                <input type="date" id="date_echeance" name="date_echeance" class="form-control bg-light border-0 py-3 shadow-none" value="{{ echeance.dateEcheance ? echeance.dateEcheance|date('Y-m-d') : '' }}" required>
            </div>
        </div>

        <div class="col-md-4">
            <label for="date_rappel" class="form-label fw-bold text-dark mb-2">Date de rappel</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="far fa-bell text-muted"></i></span>
                <input type="date" id="date_rappel" name="date_rappel" class="form-control bg-light border-0 py-3 shadow-none" value="{{ echeance.dateRappel ? echeance.dateRappel|date('Y-m-d') : '' }}">
            </div>
        </div>

        <div class="col-md-4">
            <label for="statut" class="form-label fw-bold text-dark mb-2">Statut</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fas fa-info-circle text-muted"></i></span>
                <select id="statut" name="statut" class="form-select bg-light border-0 py-3 shadow-none" required>
                    {% for stat in ['pending', 'notified', 'completed', 'overdue'] %}
                        <option value="{{ stat }}" {{ echeance.statut == stat ? 'selected' : '' }}>{{ stat|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="col-12">
            <label for="description" class="form-label fw-bold text-dark mb-2">Description / Notes</label>
            <textarea id="description" name="description" class="form-control bg-light border-0 py-3 shadow-none" rows="3" placeholder="Détails supplémentaires...">{{ echeance.description|default('') }}</textarea>
        </div>
    </div>

    <div class="d-grid mt-5">
        <button type="submit" class="btn btn-{{ echeance.id ? 'warning text-white' : 'primary' }} btn-lg rounded-pill fw-bold shadow-sm py-3 transition-hover">
            <i class="fas fa-save me-2"></i> {{ echeance.id ? 'Mettre à jour' : 'Créer l\'Échéance' }}
        </button>
    </div>
</form>

<script>
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }
                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>