<form method="post" action="{{ path('admin_echeance_delete', {'id': echeance.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette échéance ?');" style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ echeance.id) }}">
    <button class="btn btn-outline-danger btn-sm rounded-pill fw-bold shadow-sm px-4">
        <i class="fas fa-trash-alt me-2 text-danger"></i> Supprimer
    </button>
</form>