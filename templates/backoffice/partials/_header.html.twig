<header class="topbar">
    {% set adminName = app.user ? ((app.user.fullName is defined and app.user.fullName) ? app.user.fullName : ((app.user.prenom|default('') ~ ' ' ~ app.user.nom|default(''))|trim ?: app.user.email)) : 'Admin User' %}
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary">BackOffice</span>
        <span class="text-muted small">Gestion & supervision</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="fw-semibold">{{ adminName }}</span>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-sm btn-outline-primary">Dashboard</a>
    </div>
</header>
