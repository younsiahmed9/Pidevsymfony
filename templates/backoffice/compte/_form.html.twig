{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_label(form.utilisateur, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.utilisateur, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.utilisateur) }}
        </div>

        <div class="col-md-6 mb-3">
            {{ form_label(form.numeroCompte, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.numeroCompte, {'attr': {'class': 'form-control', 'placeholder': 'Ex: TN0123456789...'}}) }}
            {{ form_errors(form.numeroCompte) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_label(form.typeCompte, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.typeCompte, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.typeCompte) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_label(form.solde, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.solde, {'attr': {'class': 'form-control', 'placeholder': '0.00'}}) }}
            {{ form_errors(form.solde) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_label(form.etat, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.etat, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.etat) }}
        </div>

        <div class="col-md-6 mb-3">
            {{ form_label(form.tauxInteret, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.tauxInteret, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.tauxInteret) }}
        </div>

        <div class="col-md-6 mb-3">
            {{ form_label(form.plafondDecouvert, null, {'label_attr': {'class': 'form-label fw-bold small text-uppercase'}}) }}
            {{ form_widget(form.plafondDecouvert, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.plafondDecouvert) }}
        </div>
    </div>

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4 shadow-sm">
            <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer le compte') }}
        </button>
        <a href="{{ path('admin_compte_index') }}" class="btn btn-outline-secondary px-4">
            <i class="fas fa-times me-2"></i>Annuler
        </a>
    </div>
{{ form_end(form) }}
