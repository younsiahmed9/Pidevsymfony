{% extends 'backoffice/base.html.twig' %}

{% block title %}Modifier le Compte - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0"><i class="fas fa-edit me-2"></i>Modifier le Compte #{{ compte.id }}</h3>
                    {{ include('backoffice/compte/_delete_form.html.twig') }}
                </div>
                <div class="card-body p-4">
                    {{ include('backoffice/compte/_form.html.twig', {'button_label': 'Mettre à jour le compte'}) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
