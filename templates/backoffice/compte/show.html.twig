{% extends 'backoffice/base.html.twig' %}

{% block title %}Détails du Compte - Admin{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <a href="{{ path('admin_compte_index') }}" class="text-decoration-none text-muted me-2">
                <i class="fas fa-arrow-left fa-sm"></i>
            </a>
            Détails du Compte #{{ compte.id }}
        </h1>
        <div class="btn-group shadow-sm">
            <a href="{{ path('admin_compte_edit', {id: compte.id}) }}" class="btn btn-warning px-4">
                <i class="fas fa-edit me-2"></i> Modifier
            </a>
            {{ include('backoffice/compte/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="row">
        <!-- Main Card -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4 border-0">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="m-0 font-weight-bold text-primary">Informations Bancaires</h6>
                </div>
                <div class="card-body">
                    <div class="row mb-5">
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">Numéro de Compte</label>
                            <span class="h4 font-weight-bold text-dark">{{ compte.numeroCompte }}</span>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <label class="small font-weight-bold text-muted text-uppercase d-block">État du Compte</label>
                            {% set badge_class = compte.etat == 'actif' ? 'success' : (compte.etat == 'bloque' ? 'danger' : 'secondary') %}
                            <span class="badge rounded-pill bg-{{ badge_class }} fs-5 px-4 py-2">
                                {{ compte.etat|capitalize }}
                            </span>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-sm-4">
                            <div class="bg-light p-4 rounded-3 text-center h-100">
                                <label class="small font-weight-bold text-muted text-uppercase d-block mb-2">Solde Actuel</label>
                                <span class="h4 font-weight-bold text-primary">{{ compte.solde|number_format(2, ',', ' ') }} TND</span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="bg-light p-4 rounded-3 text-center h-100">
                                <label class="small font-weight-bold text-muted text-uppercase d-block mb-2">Type de Compte</label>
                                <span class="h5 font-weight-bold text-dark text-uppercase">{{ compte.typeCompte }}</span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="bg-light p-4 rounded-3 text-center h-100">
                                <label class="small font-weight-bold text-muted text-uppercase d-block mb-2">Date d'ouverture</label>
                                <span class="h5 font-weight-bold text-dark">{{ compte.dateCreation|date('d/m/Y') }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="border p-3 rounded-3">
                                <label class="small font-weight-bold text-muted text-uppercase d-block">Taux d'intérêt</label>
                                <span class="fw-bold text-dark">{{ compte.tauxInteret ? compte.tauxInteret ~ '%' : 'N/A' }}</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border p-3 rounded-3">
                                <label class="small font-weight-bold text-muted text-uppercase d-block">Plafond Découvert</label>
                                <span class="fw-bold text-dark">{{ compte.plafondDecouvert ? compte.plafondDecouvert ~ ' TND' : '0.00 TND' }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- User Info Sidebar -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4 border-0">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="m-0 font-weight-bold text-primary">Titulaire du Compte</h6>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-4 d-inline-block mb-3">
                            <i class="fas fa-user-tie fa-4x text-primary"></i>
                        </div>
                        <h4 class="font-weight-bold text-dark mb-1">{{ compte.utilisateur.fullName ?: compte.utilisateur.email }}</h4>
                        <p class="text-muted"><i class="fas fa-envelope me-2"></i>{{ compte.utilisateur.email }}</p>
                    </div>
                    <hr>
                    <div class="mt-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-muted text-uppercase fw-bold">ID Utilisateur</span>
                            <span class="fw-bold text-dark">#{{ compte.utilisateur.id }}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-muted text-uppercase fw-bold">Rôle</span>
                            <span class="badge bg-primary">{{ compte.utilisateur.role|replace({'ROLE_': ''}) }}</span>
                        </div>
                    </div>
                    <div class="mt-4 pt-3">
                        <a href="#" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                            <i class="fas fa-external-link-alt me-2"></i> Voir le profil utilisateur
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
