{% extends 'backoffice/base.html.twig' %}

{% block title %}Back Office - Services Filtrés{% endblock %}

{% block body %}
<div class="container-fluid mt-5">
    <!-- Header -->
    <div class="mb-4">
        <h1>🔍 Résultats Filtrés</h1>
        <p class="text-muted">Filtrage: <strong>{{ filterName }}</strong></p>
    </div>

    {% if services|length == 0 %}
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Aucun résultat</h4>
            <p>Aucun service ne correspond à votre recherche.</p>
            <hr>
            <p class="mb-0">
                <a href="{{ path('admin_service_index') }}" class="btn btn-outline-primary btn-sm">
                    ← Retour au tableau de bord
                </a>
            </p>
        </div>
    {% else %}
        <!-- Statistiques du filtre -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <h6 class="card-title">Nombre de services</h6>
                        <p class="display-4">{{ services|length }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-info text-white">
                    <div class="card-body text-center">
                        <h6 class="card-title">Tarif Total</h6>
                        <p class="display-4">${{ services|reduce(0, (carry, service) => carry + service.tarif)|number_format(2, '.', ',') }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-secondary text-white">
                    <div class="card-body text-center">
                        <h6 class="card-title">Tarif Moyen</h6>
                        <p class="display-4">
                            ${{ (services|reduce(0, (carry, service) => carry + service.tarif) / services|length)|number_format(2, '.', ',') }}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau -->
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">📋 Services ({{ services|length }})</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Type</th>
                            <th>Tarif</th>
                            <th>Fréquence</th>
                            <th>Statut</th>
                            <th>Date Début</th>
                            <th>Date Fin</th>
                            <th>Durée (jours)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for service in services %}
                            <tr>
                                <td>#{{ service.id }}</td>
                                <td><strong>{{ service.nomService }}</strong></td>
                                <td>
                                    <span class="badge bg-secondary">{{ service.typeService|upper }}</span>
                                </td>
                                <td>
                                    <strong>${{ service.tarif }}</strong>
                                </td>
                                <td>{{ service.frequence ?? '-' }}</td>
                                <td>
                                    <span class="badge bg-{{ service.statut == 'actif' ? 'success' : (service.statut == 'suspendu' ? 'warning' : 'danger') }}">
                                        {{ service.statut|upper }}
                                    </span>
                                </td>
                                <td>
                                    {% if service.dateDebut %}
                                        {{ service.dateDebut|date('d/m/Y') }}
                                    {% else %}
                                        <em class="text-muted">-</em>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if service.dateFin %}
                                        {{ service.dateFin|date('d/m/Y') }}
                                    {% else %}
                                        <em class="text-muted">-</em>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set duration = service.calculateDuration() %}
                                    {% if duration %}
                                        <span class="badge bg-info">{{ duration }}</span>
                                    {% else %}
                                        <em class="text-muted">-</em>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('admin_service_show', {id: service.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                        👁️
                                    </a>
                                    <a href="{{ path('front_service_edit', {id: service.id}) }}" class="btn btn-sm btn-primary" title="Modifier">
                                        ✏️
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Boutons Retour -->
        <div class="mt-4 mb-5">
            <a href="{{ path('admin_service_index') }}" class="btn btn-outline-secondary">
                ← Retour au tableau de bord
            </a>
            <a href="{{ path('admin_service_stats') }}" class="btn btn-outline-info">
                📊 Voir les statistiques
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
