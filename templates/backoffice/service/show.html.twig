{% extends 'backoffice/base.html.twig' %}

{% block title %}Back Office - Détails Service #{{ service.id }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <!-- Header -->
            <div class="mb-4">
                <h1>{{ service.nomService }}</h1>
                <p class="text-muted">
                    <small>ID: #{{ service.id }} | Créé le {{ service.id|date('d/m/Y') ?? '-' }}</small>
                </p>
            </div>

            <!-- Alert Statut -->
            <div class="alert alert-{{ service.statut == 'actif' ? 'success' : (service.statut == 'suspendu' ? 'warning' : 'danger') }}" role="alert">
                <strong>Statut:</strong>
                <span class="badge bg-{{ service.statut == 'actif' ? 'success' : (service.statut == 'suspendu' ? 'warning' : 'danger') }}">
                    {{ service.statut|upper }}
                </span>
            </div>

            <!-- Informations Principales -->
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📋 Informations Principales</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Nom Service:</strong></p>
                            <p class="text-muted">{{ service.nomService }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Type:</strong></p>
                            <p class="text-muted">
                                <span class="badge bg-info">{{ service.typeService|upper }}</span>
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Tarif ($):</strong></p>
                            <p class="text-muted"><strong>${{ service.tarif }}</strong></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Fréquence:</strong></p>
                            <p class="text-muted">{{ service.frequence ?? 'Non spécifiée' }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dates et Durée -->
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📅 Dates et Durée</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Date Début:</strong></p>
                            <p class="text-muted">
                                {% if service.dateDebut %}
                                    {{ service.dateDebut|date('d/m/Y') }}
                                {% else %}
                                    <em>Non définie</em>
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Date Fin:</strong></p>
                            <p class="text-muted">
                                {% if service.dateFin %}
                                    {{ service.dateFin|date('d/m/Y') }}
                                {% else %}
                                    <em>Non définie</em>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <p><strong>Durée Totale:</strong></p>
                            <p class="text-muted">
                                {% set duration = service.calculateDuration() %}
                                {% if duration %}
                                    <span class="badge bg-secondary">{{ duration }} jours</span>
                                {% else %}
                                    <em>Impossible à calculer</em>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </card>

            <!-- Actions -->
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">⚙️ Actions</h5>
                </div>
                <div class="card-body">
                    <a href="{{ path('front_service_edit', {id: service.id}) }}" class="btn btn-primary">
                        ✏️ Modifier
                    </a>
                    <a href="{{ path('admin_service_index') }}" class="btn btn-outline-secondary">
                        ← Retour
                    </a>
                    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        🗑️ Supprimer
                    </button>
                </div>
            </div>

            <!-- Modal Suppression -->
            <div class="modal fade" id="deleteModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">Confirmation de suppression</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>Êtes-vous sûr de vouloir supprimer le service <strong>{{ service.nomService }}</strong> ?</p>
                            <p class="text-danger"><small>Cette action est irréversible.</small></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <form method="post" action="{{ path('front_service_delete', {id: service.id}) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                                <button type="submit" class="btn btn-danger">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
