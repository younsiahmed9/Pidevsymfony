{% extends "base.html.twig" %}

{% block title %}Mon Espace Client - FinTrack{% endblock %}

{% block footer %}{% endblock %}

{% block stylesheets %}
<style>
    .admin-page {
        min-height: calc(100vh - 145px);
        overflow: visible;
        padding-bottom: 2rem;
    }

    .admin-layout {
        align-items: stretch;
        min-height: 100%;
    }

    .admin-sidebar {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 12px 28px rgba(17, 24, 39, 0.08);
        height: auto;
        overflow: hidden;
        background: linear-gradient(180deg, #071a34 0%, #0b2347 100%);
    }

    .admin-sidebar .card-body {
        height: 100%;
        overflow-y: auto;
        padding: 1rem;
    }

    .admin-menu-nav {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .admin-menu-group-title {
        color: #8fa9d6;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        margin: 0 0 0.6rem;
    }

    .admin-menu-btn {
        text-align: left;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        background: rgba(255, 255, 255, 0.04);
        color: #d6e4ff;
        font-weight: 600;
        transition: all 0.2s ease;
        width: 100%;
    }

    .admin-menu-btn.active,
    .admin-menu-btn:hover {
        background: #1f4fa1;
        border-color: #5f8fe4;
        color: #fff;
    }

    .admin-content {
        height: auto;
        overflow: visible;
        padding-right: 0.35rem;
    }

    .users-board {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 14px 35px rgba(17, 24, 39, 0.08);
        background: #ffffff;
    }

    .users-board-header {
        background: linear-gradient(120deg, #123a7b 0%, #2258a8 100%);
        color: #fff;
        padding: 1rem 1.25rem;
    }

    .users-board-title {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .users-table {
        margin-bottom: 0;
    }

    .users-table thead th {
        background: #f7f9fc;
        color: #2f3f5a;
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        font-weight: 700;
        border-bottom: 1px solid #e8edf5;
        white-space: nowrap;
        padding: 0.85rem 0.85rem;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .users-table tbody td {
        border-bottom: 1px solid #eef2f8;
        padding: 0.85rem 0.85rem;
        vertical-align: middle;
    }

    .status-active {
        background: #d9f6e6;
        color: #0f6a40;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
    }

    .status-inactive {
        background: #ffe0e0;
        color: #8a1f1f;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
    }

    .actions-cell form {
        display: inline;
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4 admin-page">
    <h1 class="mb-3">Espace Client</h1>

    <div class="row g-4 admin-layout">
        <div class="col-lg-3">
            <div class="card admin-sidebar">
                <div class="card-body">
                    <p class="admin-menu-group-title">Menu Client</p>
                    <div class="admin-menu-nav nav" role="tablist">
                        <button class="admin-menu-btn active" id="gestion-budget-tab" data-bs-toggle="tab" data-bs-target="#gestion-budget-pane" type="button" role="tab" aria-controls="gestion-budget-pane" aria-selected="true">Mes Budgets</button>
                        <button class="admin-menu-btn" id="gestion-portefeuille-tab" data-bs-toggle="tab" data-bs-target="#gestion-portefeuille-pane" type="button" role="tab">Mes Dépenses</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content admin-content">
                <div class="tab-pane fade show active" id="gestion-budget-pane" role="tabpanel">
                    
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    <div class="card mb-4 users-board">
                        <div class="users-board-header d-flex justify-content-between align-items-center">
                            <h5 class="users-board-title">Gérer Mes Budgets</h5>
                            <a href="{{ path('app_client_budget_new') }}" class="btn btn-sm btn-light font-weight-bold">Créer un Budget</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table users-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Budget</th>
                                            <th>Montant Totale</th>
                                            <th>Dépensé</th>
                                            <th>Solde</th>
                                            <th>Période</th>
                                            <th>Statut</th>
                                            <th>Date</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for budget in budgets %}
                                            <tr>
                                                <td><span class="badge bg-light text-dark border">{{ budget.id }}</span></td>
                                                <td class="font-weight-600">
                                                    <span class="badge bg-info text-dark">{{ budget.nom_budget|default('N/A') }}</span>
                                                </td>
                                                <td class="font-weight-bold">
                                                    {{ budget.montant_total|default('0.00') }} €
                                                </td>
                                                <td class="text-danger">
                                                    -{{ budget.total_depense|default('0') }} €
                                                </td>
                                                <td class="font-weight-bold {{ (budget.montant_total|default(0) - budget.total_depense|default(0)) < 0 ? 'text-danger' : 'text-success' }}">
                                                    {{ (budget.montant_total|default(0) - budget.total_depense|default(0))|number_format(2, '.', '') }} €
                                                </td>
                                                <td><span class="badge bg-secondary">{{ budget.periode|default('mensuel')|capitalize }}</span></td>
                                                <td>
                                                    {% if budget.statut == 'actif' %}
                                                        <span class="status-active">Actif</span>
                                                    {% else %}
                                                        <span class="status-inactive">Clôturé</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-muted">{{ budget.date_creation|default('-') }}</td>
                                                <td class="actions-cell text-center">
                                                    <div class="d-flex justify-content-center">
                                                        <a href="{{ path('app_client_budget_edit', {id: budget.id}) }}" class="btn btn-sm btn-outline-primary me-1">Modifier</a>
                                                        
                                                        <a href="{{ path('app_client_depense_new', {budget: budget.id}) }}" class="btn btn-sm btn-outline-success me-1">Dépense</a>

                                                        <form method="post" action="{{ path('app_client_budget_delete', {id: budget.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce budget ?');">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ budget.id) }}">
                                                            <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="7" class="text-center py-4">Aucun budget trouvé. Cliquez sur "Créer un Budget" pour commencer.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="gestion-portefeuille-pane" role="tabpanel">
                    <div class="card users-board">
                        <div class="users-board-header">
                            <h5 class="users-board-title">Historique des Dépenses</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table users-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Budget</th>
                                            <th>Montant</th>
                                            <th>Mode</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for depense in depenses %}
                                            <tr>
                                                <td>
                                                    {% if depense.budget_name %}
                                                        <span class="badge bg-info text-dark">{{ depense.budget_name }}</span>
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-danger font-weight-bold">-{{ depense.montant }} €</td>
                                                <td><span class="badge bg-light text-dark border">{{ depense.mode_paiement|capitalize }}</span></td>
                                                <td class="actions-cell">
                                                    <a href="{{ path('app_client_depense_edit', {id: depense.id_depense}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                                                    
                                                    <form method="post" action="{{ path('app_client_depense_delete', {id: depense.id_depense}) }}" onsubmit="return confirm('Supprimer cette dépense ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_depense' ~ depense.id_depense) }}">
                                                        <button class="btn btn-sm btn-outline-danger ms-1">Supprimer</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="6" class="text-center py-4">Aucune dépense enregistrée.</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
