<!DOCTYPE html>
<html lang="en-us">
<head>
	<meta charset="utf-8">
	<title>{% block title %}FinTrack{% endblock %}</title>
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
	<meta name="description" content="FinTrack financial management platform">
	<meta name="author" content="FinTrack">
	<link rel="shortcut icon" href="{{ asset('images/favicon.png') }}" type="image/x-icon">
	<link rel="icon" href="{{ asset('images/favicon.png') }}" type="image/x-icon">
	<meta name="theme-name" content="wallet" />

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="{{ asset('plugins/slick/slick.css') }}">
	<link rel="stylesheet" href="{{ asset('plugins/font-awesome/fontawesome.min.css') }}">
	<link rel="stylesheet" href="{{ asset('plugins/font-awesome/brands.css') }}">
	<link rel="stylesheet" href="{{ asset('plugins/font-awesome/solid.css') }}">
	<link rel="stylesheet" href="{{ asset('css/style.css') }}">
	{% block stylesheets %}{% endblock %}
</head>
<body>
    {% include 'partials/navigation.html.twig' %}

	{% include 'partials/_animated_flashes.html.twig' %}

    <main>
        {% block body %}{% endblock %}
    </main>

	{% block footer %}
		{% include 'partials/footer.html.twig' %}
	{% endblock %}

	<script src="{{ asset('plugins/jquery/jquery.min.js') }}"></script>
	<script src="{{ asset('plugins/bootstrap/bootstrap.bundle.min.js') }}"></script>
	<script src="{{ asset('plugins/slick/slick.min.js') }}"></script>
	<script src="{{ asset('plugins/scrollmenu/scrollmenu.min.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="{{ asset('js/script.js') }}"></script>
	{% block javascripts %}{% endblock %}
</body>
</html>
